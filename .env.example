# 部署站点绝对地址（用于 canonical / sitemap / robots），部署前必填
PUBLIC_SITE_URL=https://www.example.com

# 构建模式（v2.0.1）：preview = 预览/验收构建，默认启用完整动态并显示「完整动态模式 · commit」标识；
# production 或不设置 = 正式模式，尊重 prefers-reduced-motion 系统偏好。
# 本机预览容器（docker-compose / Dockerfile）以 preview 构建；生产部署显式设置 production 或不设置。
PUBLIC_BUILD_MODE=preview

# 咨询表单：Web3Forms 兼容端点；端点与 key 均配置才启用提交，任一缺失则表单保持禁用态（BR-16）
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=

# 基础统计：Plausible 兼容脚本（不配置则不注入任何统计脚本）
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_ANALYTICS_DOMAIN=
