---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="隐私政策"
  description="了解半打空间隐私政策的发布状态与咨询方式。"
  headerStyle="solid"
  noindex={true}
>
  <div class="page-editorial">
    <section class="page-opening ed-wrap">
      <span class="eyebrow">PRIVACY POLICY</span>
      <div class="page-heading">
        <h1>隐私政策</h1>
      </div>
    </section>
    <div class="ed-wrap">
      <section class="editorial-empty">
        <h2>政策尚未发布。</h2>
        <div>
          <p>
            下载项目需求不会自动发送您的填写内容。如有隐私相关问题，请联系我们。
          </p>
          <a class="text-link action action-secondary" href="/zh/contact/">
            联系我们
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
