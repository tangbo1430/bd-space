---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="新闻资讯"
  description="半打空间新闻资讯：企业动态、项目签约与行业观察。暂无已发布内容时展示空态。"
  current="news"
  headerStyle="solid"
>
  <p class="crumb"><a href="/zh/">HOME</a> / NEWS</p>
  <div class="wrap" style="padding-top:40px">
    <div class="en">Newsroom</div>
    <h2 style="font-size:52px;margin-top:10px">新闻资讯</h2>
  </div>

  <!-- 空态（PRD §9 FR-8）：无已发布文章时展示，不生成虚构新闻 -->
  <div class="wrap empty-state">
    <div class="ic" aria-hidden="true">✎</div>
    <h2>暂无资讯</h2>
    <p>新闻资讯栏目暂无已发布内容。您可以通过联系我们了解最新动态。</p>
    <div class="btns">
      <a class="btn btn-primary" href="/zh/contact/" data-track="consult_click">联系我们 <span class="arr">→</span></a>
      <a class="btn btn-ghost" href="/zh/">返回首页 <span class="arr">→</span></a>
    </div>
  </div>
</BaseLayout>
