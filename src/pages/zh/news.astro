---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
---

<BaseLayout
  title="新闻资讯"
  description="半打空间的企业动态、项目记录与行业观察。"
  current="news"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="page-opening ed-wrap">
      <span class="eyebrow">THE JOURNAL / 新闻资讯</span>
      <div class="page-heading">
        <h1>
          关于空间，
          <br />
          持续记录。
        </h1>
        <p>
          企业动态、项目进展与行业观察，
          <br />
          记录我们对建造和生活的思考。
        </p>
      </div>
    </section>
    <div class="ed-wrap">
      <section class="editorial-empty">
        <h2>
          新的故事，
          <br />
          正在酝酿。
        </h2>
        <div>
          <p>
            目前暂无已发布资讯。您可以先走进我们的工程案例，看看空间如何从工厂走向真实的生活。
          </p>
          <a class="text-link action action-secondary" href="/zh/cases/">
            探索项目实践
          </a>
        </div>
      </section>
    </div>
    <ProjectCTA />
  </div>
</BaseLayout>
