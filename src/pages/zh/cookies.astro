---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cookie 政策"
  description="了解半打空间 Cookie 政策的发布状态与咨询方式。"
  headerStyle="solid"
  noindex={true}
>
  <div class="page-editorial">
    <section class="page-opening ed-wrap">
      <span class="eyebrow">COOKIE POLICY</span>
      <div class="page-heading">
        <h1>Cookie 政策</h1>
      </div>
    </section>
    <div class="ed-wrap">
      <section class="editorial-empty">
        <h2>政策尚未发布。</h2>
        <div>
          <p>如需了解网站 Cookie 的相关信息，请联系我们。</p>
          <a class="text-link action action-secondary" href="/zh/contact/">
            联系我们
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
