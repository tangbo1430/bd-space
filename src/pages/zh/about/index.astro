---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PLACEHOLDER } from '../../../lib/site';

const milestones = [
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 01` },
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 02` },
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 03` },
];
---

<BaseLayout
  title="关于我们"
  description="了解半打空间：企业使命、简介、工厂能力与现场交付。数据与事实信息以客户提供为准。"
  current="about"
  headerStyle="overlay"
  master="v3"
>
  {/* v3.0.1 关于页：首屏禁用合成横幅 about-hero（会裁切文案），改用米阁安装实拍 88vh 通栏 */}
  <section class="v3hero h88" aria-label="关于我们首屏">
    <div class="ph3">
      <picture>
        <source media="(max-width: 767px)" type="image/webp" srcset="/assets/img/case-mige-install-01-m.webp" />
        <source type="image/webp" srcset="/assets/img/case-mige-install-01.webp" />
        <img
          src="/assets/img/case-mige-install-01.jpg"
          width="1705" height="1279"
          alt="中山独栋民宅项目现场安装实景"
          loading="eager" decoding="async" fetchpriority="high"
          onerror="this.closest('.v3hero').classList.add('ph-fallback');this.closest('picture').remove()"
        />
      </picture>
    </div>
    <div class="wrap">
      <div class="en on-dark">About Banda</div>
      <h1>我们想做什么？</h1>
      <p class="sub">What are we trying to do?</p>
    </div>
  </section>

  {/* 使命宣言（980px 单列大字） */}
  <section class="chap chap-paper" aria-label="使命">
    <div class="wrap rv" style="max-width:980px">
      <div class="en">Mission</div>
      <div class="v3mission" style="margin-top:20px">
        量产房子，解决全球住房问题。<br />
        <span class="sub-en">House manufacturing — an industry not yet truly industrialized.</span>
      </div>
      <p class="v3lead" style="margin-top:32px">"建筑"是人类社会唯一没有被实现工业化的产业，全球都面临建房的困难。【示例文案，待确认】</p>
    </div>
  </section>

  {/* 企业简介：左浮卡 + 右 4:3 箱房阵列实拍 */}
  <section class="chap chap-paper" style="padding-top:0" aria-label="企业简介">
    <div class="wrap split3">
      <div class="tx5l rv">
        <div class="en">Profile</div>
        <h2 class="v3h3">企业简介</h2>
        <p class="v3lead" style="font-size:15px">{PLACEHOLDER}公司简介。核心信息与里程碑，正式内容以客户提供的经审核的公司介绍替换。【示例文案，待确认】</p>
        <div style="margin-top:28px"><a class="btn btn-ghost-dark" href="#factory">了解制造体系 <span class="arr">→</span></a></div>
      </div>
      <div class="img7r r43 rv">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cabin-rows-m.webp 960w, /assets/img/case-cabin-rows.webp 1920w" sizes="(max-width: 1023px) 100vw, 60vw" />
          <img
            src="/assets/img/case-cabin-rows.jpg"
            width="1920" height="1080"
            alt="箱房阵列实景"
            loading="lazy" decoding="async"
            onerror="this.closest('.img7r').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
    </div>
  </section>

  {/* 工厂能力（deep 章：通栏 21:9 + 双 4:3 产线卡） */}
  <section class="chap chap-dark" id="factory" aria-label="工厂能力">
    <div class="wrap">
      <div class="en on-dark rv">Factory</div>
      <h2 class="v3h2 rv">工厂能力</h2>
      <p class="v3lead on-dark rv" style="margin-bottom:56px">产线、模具、质检与出运——确定性从工厂开始。【待确认】</p>
    </div>
    <div class="bleed r219 rv">
      <div class="ph3">
        <picture>
          <source type="image/webp" srcset="/assets/img/factory-precast-units-m.webp 960w, /assets/img/factory-precast-units.webp 1920w" sizes="100vw" />
          <img
            src="/assets/img/factory-precast-units.jpg"
            width="1920" height="1440"
            alt="工厂预制混凝土单元构件养护现场"
            loading="lazy" decoding="async"
            onerror="this.closest('.bleed').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="cap"><div class="t">预制产线</div><div class="s">【待确认】产线说明</div></div>
    </div>
    <div class="wrap" style="padding-top:24px">
      <div class="g2">
        <div class="cc r43 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-factory-module-m.webp 960w, /assets/img/flow-factory-module.webp 1080w" sizes="(max-width: 767px) 100vw, 50vw" />
            <img
              src="/assets/img/flow-factory-module.jpg"
              width="1080" height="810"
              alt="工厂车间内白色模块构件实拍"
              loading="lazy" decoding="async"
              onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="cap"><div class="t">产线模块</div><div class="s">【待确认】</div></div>
        </div>
        <div class="cc r43 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-factory-panels.webp" />
            <img
              src="/assets/img/flow-factory-panels.jpg"
              width="1280" height="960"
              alt="工厂墙板存放区实拍"
              loading="lazy" decoding="async"
              onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="cap"><div class="t">构件存放</div><div class="s">【待确认】</div></div>
        </div>
      </div>
    </div>
  </section>

  {/* 里程碑（980px 单列发丝时间线；年份与事件待甲方提供，不虚构） */}
  <section class="chap chap-paper" aria-label="里程碑">
    <div class="wrap" style="max-width:980px">
      <div class="en rv">Milestones</div>
      <h2 class="v3h2 rv">里程碑</h2>
      <div class="tl3">
        {milestones.map((m) => (
          <div class="ti rv"><div class="y">{m.yr}</div><div class="d">{m.text}</div></div>
        ))}
      </div>
      <p class="rv" style="margin-top:18px;font-size:13px;color:var(--v3-muted)">年份与事件待甲方提供，不虚构。</p>
    </div>
  </section>

  {/* 现场交付（通栏 21:9 航拍 + 双 4:3 细节卡） */}
  <section class="chap chap-paper" style="padding-top:0" aria-label="现场交付">
    <div class="wrap">
      <div class="en rv">On Site</div>
      <h2 class="v3h2 rv" style="margin-bottom:56px">现场交付</h2>
    </div>
    <div class="bleed r219 rv">
      <div class="ph3">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cabin-site-aerial-m.webp 960w, /assets/img/case-cabin-site-aerial.webp 1920w" sizes="100vw" />
          <img
            src="/assets/img/case-cabin-site-aerial.jpg"
            width="1920" height="1080"
            alt="项目场地航拍，箱体阵列吊装就位"
            loading="lazy" decoding="async"
            onerror="this.closest('.bleed').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="cap"><div class="t">现场交付</div><div class="s">【待确认】交付说明</div></div>
    </div>
    <div class="wrap" style="padding-top:24px;padding-bottom:0">
      <div class="g2">
        <div class="cc r43 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-transport-spreader-lift-m.webp 960w, /assets/img/flow-transport-spreader-lift.webp 1044w" sizes="(max-width: 767px) 100vw, 50vw" />
            <img
              src="/assets/img/flow-transport-spreader-lift.jpg"
              width="1044" height="1392"
              alt="平衡梁吊装箱体作业"
              loading="lazy" decoding="async"
              onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="cap"><div class="t">吊装就位</div><div class="s">【待确认】</div></div>
        </div>
        <div class="cc r43 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/install-detail-roof-trim-m.webp 960w, /assets/img/install-detail-roof-trim.webp 1279w" sizes="(max-width: 767px) 100vw, 50vw" />
            <img
              src="/assets/img/install-detail-roof-trim.jpg"
              width="1279" height="1705"
              alt="现场安装屋面收边细节，登高作业"
              loading="lazy" decoding="async"
              onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="cap"><div class="t">安装细节</div><div class="s">【待确认】</div></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
