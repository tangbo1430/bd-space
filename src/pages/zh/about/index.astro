---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhImg from '../../../components/PhImg.astro';
import { PLACEHOLDER } from '../../../lib/site';
import { ABOUT_HERO_ASSET, FLOW_FACTORY_ASSETS } from '../../../lib/assets';

const factoryStats = [
  { num: '——', label: `自动化产线（条）${PLACEHOLDER}` },
  { num: '——', label: `堆场面积（㎡）${PLACEHOLDER}` },
];
void factoryStats; /* v2.0：工厂数字移入图注浮层文案，保留占位口径 */
const milestones = [
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 01` },
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 02` },
  { yr: '【年】', text: `${PLACEHOLDER}里程碑事件 03` },
];

/* M1 愿景（v1.6 DSN-160，PM 中性稿） */
const visionValues = [
  { no: '01', title: '标准化制造', desc: `${PLACEHOLDER}以标准化设计与制造提升产品一致性。` },
  { no: '02', title: '高效率交付', desc: `${PLACEHOLDER}工厂预制与现场装配并行，缩短建造周期。` },
  { no: '03', title: '模块化与可复制', desc: `${PLACEHOLDER}模块单元灵活组合，适配多种空间需求。` },
];

/* M2 研发与产品演进（v1.6 DSN-161；年份未核实整列隐藏，ol 保持 01→04） */
const evoStages = [
  { no: '01', stage: '研发探索', desc: `${PLACEHOLDER}装配式空间技术路线探索。` },
  { no: '02', stage: '体系验证', desc: `${PLACEHOLDER}建造体系与构件性能验证。` },
  { no: '03', stage: '产品化', desc: `${PLACEHOLDER}标准化产品定型与量产准备。` },
  { no: '04', stage: '项目交付', desc: `${PLACEHOLDER}产品进入项目交付阶段。` },
];
---

<BaseLayout
  title="关于我们"
  description="了解半打空间：企业简介、工厂能力、生产流程与质检体系。数据与事实信息以客户提供为准。"
  current="about"
  headerStyle="overlay"
>
  <section class="page-hero" aria-label="关于我们首屏">
    {/* v1.7 RAR 关于我们首图：白盒建筑+愿景文案（21:9，移动裁左半建筑）；首屏 eager 预加载，失败回退深色渐变 */}
    <PhImg g="dark-1" tag="IMG-ABOUT-HERO · 白盒建筑+愿景文案" onDark img={{ ...ABOUT_HERO_ASSET, lazy: false }} />
    <div class="hero-copy">
      <div class="en" style="color:rgba(255,255,255,.6)">About Banda</div>
      <h1>把建造，变成制造</h1>
    </div>
  </section>

  <div class="wrap">
    <p class="crumb" style="padding-left:0;padding-right:0"><a href="/zh/">HOME</a> / ABOUT</p>

    <!-- M1 愿景（v1.6；v2.0 节奏压缩 + 右侧愿景配图） -->
    <section class="vision v2-tight" aria-label="我们的愿景">
      <div class="rv">
        <div class="v-label">我们的愿景</div>
        <h2>让房屋制造更标准、更高效、更易交付。</h2>
      </div>
      <div class="vision-vals rv">
        {visionValues.map((v) => (
          <div class="vision-val">
            <span class="v-no" aria-hidden="true">{v.no}</span>
            <div><b>{v.title}</b><p>{v.desc}</p></div>
          </div>
        ))}
      </div>
      <div class="figx r-43 rv" style="grid-column:1 / -1;margin-top:8px">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-zhongshan-install-03.webp" />
          <img
            src="/assets/img/case-zhongshan-install-03.jpg"
            width="1899" height="1424"
            alt="中山低层住宅项目吊装就位，现场指挥"
            loading="lazy" decoding="async"
            onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
        <div class="figx-cap"><div class="t">交付现场</div><div class="s">标准化吊装【待确认】</div></div>
      </div>
    </section>

    <!-- M2 研发与产品演进（v1.6；年份未核实不渲染；v2.0 并入愿景区紧凑呈现） -->
    <section class="vision v2-tight" aria-label="研发与产品演进" data-evo style="border-bottom:none">
      <div class="rv">
        <div class="v-label">研发与产品演进</div>
        <h2 style="font-size:32px">从研发探索、体系验证，到产品化与项目交付。</h2>
      </div>
      <div class="vision-vals rv">
        {evoStages.map((s) => (
          <div class="vision-val">
            <span class="v-no" aria-hidden="true">{s.no}</span>
            <div><b>{s.stage}</b><p>{s.desc}</p></div>
          </div>
        ))}
      </div>
    </section>

    <!-- 企业简介 v2.0：右图占位 → 箱房阵列真图（4:3，focus center） -->
    <div class="pd-body" style="padding-top:40px;padding-bottom:24px">
      <div>
        <div class="en">Profile</div>
        <h2 style="margin:12px 0 18px">企业简介</h2>
        <p style="font-size:15px;max-width:440px">
          {PLACEHOLDER}公司简介、核心优势与经营理念。此处为占位文案，待客户提供经审核的企业介绍后替换（PRD §8 企业必填字段）。
        </p>
      </div>
      <div class="figx r-43 rv">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cabin-rows.webp" />
          <img
            src="/assets/img/case-cabin-rows.jpg"
            width="1920" height="1080"
            alt="厂房箱房阵列实景"
            loading="lazy" decoding="async"
            onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
    </div>

    <!-- 工厂能力 v2.0：通栏工厂实拍横幅 + 2×4:3 产线/堆场卡 -->
    <section style="padding:0 0 32px" aria-label="工厂能力" data-v2="factory">
      <div class="en rv">Factory</div>
      <h2 class="rv" style="margin:12px 0 18px">工厂能力</h2>
      <div class="figx r-219 rv" style="--figx-focus:center 40%">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-mige-install-01-m.webp 960w, /assets/img/case-mige-install-01.webp 1705w" sizes="100vw" />
          <img
            src="/assets/img/case-mige-install-01.jpg"
            width="1705" height="1279"
            alt="工厂产线内景，模块构件生产作业"
            loading="lazy" decoding="async"
            onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="ab-factory-grid rv">
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset={`/assets/img/${FLOW_FACTORY_ASSETS.module.base}-m.webp ${FLOW_FACTORY_ASSETS.module.mw}w, /assets/img/${FLOW_FACTORY_ASSETS.module.base}.webp ${FLOW_FACTORY_ASSETS.module.w}w`} sizes="(max-width: 1279px) 100vw, 50vw" />
            <img
              src={`/assets/img/${FLOW_FACTORY_ASSETS.module.base}.jpg`}
              width={FLOW_FACTORY_ASSETS.module.w} height={FLOW_FACTORY_ASSETS.module.h}
              alt={FLOW_FACTORY_ASSETS.module.alt} loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">产线模块</div><div class="s">自动化产线【待确认】</div></div>
        </div>
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset={`/assets/img/${FLOW_FACTORY_ASSETS.panels.base}.webp`} />
            <img
              src={`/assets/img/${FLOW_FACTORY_ASSETS.panels.base}.jpg`}
              width={FLOW_FACTORY_ASSETS.panels.w} height={FLOW_FACTORY_ASSETS.panels.h}
              alt={FLOW_FACTORY_ASSETS.panels.alt} loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">构件存放</div><div class="s">堆场面积【待确认】</div></div>
        </div>
      </div>
      {/* v2.0 补充工厂实拍（v1.9 已批准素材）：预制单元养护 / 墙板出厂检验 */}
      <div class="ab-factory-grid rv">
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset="/assets/img/factory-precast-units-m.webp 960w, /assets/img/factory-precast-units.webp 1920w" sizes="(max-width: 1279px) 100vw, 50vw" />
            <img
              src="/assets/img/factory-precast-units.jpg"
              width="1920" height="1440"
              alt="工厂预制混凝土单元构件养护现场"
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">构件养护</div><div class="s">标准化养护周期【待确认】</div></div>
        </div>
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-step03-panel-lift.webp" />
            <img
              src="/assets/img/flow-step03-panel-lift.jpg"
              width="1080" height="810"
              alt="墙板出厂前吊装检验实拍"
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">出厂检验</div><div class="s">逐件检验复核【待确认】</div></div>
        </div>
      </div>
      <p style="font-size:15px;max-width:560px;margin-top:26px">{PLACEHOLDER}产线、设备、品控体系介绍。占位文案。</p>
    </section>

    <!-- 发展历程 v2.0：年号/事件行 + 旁侧施工现场实拍（节奏压缩 + 图版率补强） -->
    <div class="tl-wrap" aria-label="发展历程">
      <div class="tl" style="margin:0;align-self:center" >
        <div class="en" style="margin-left:-40px;padding-left:40px">Milestones</div>
        {milestones.map((m) => (
          <div class="tl-item"><div class="yr">{m.yr}</div><p>{m.text}</p></div>
        ))}
      </div>
      <div class="tl-imgs">
        <div class="figx r-43 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/case-mige-install-01.webp" />
            <img
              src="/assets/img/case-mige-install-01.jpg"
              width="1705" height="1279"
              alt="米阁模块工厂内景，产线作业实景"
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">工厂内景</div><div class="s">米阁项目模块产线【待确认】</div></div>
        </div>
        <div class="figx r-43 rv" style="--figx-focus:center 30%">
          <picture>
            <source type="image/webp" srcset="/assets/img/install-detail-roof-trim.webp" />
            <img
              src="/assets/img/install-detail-roof-trim.jpg"
              width="1279" height="1705"
              alt="现场安装屋面收边细节，登高作业"
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">现场安装</div><div class="s">屋面收边细节【待确认】</div></div>
        </div>
      </div>
    </div>

    {/* v2.0 现场交付实拍带：施工实景通栏（图版率补强，v1.9 已批准素材） */}
    <section style="padding:0 0 32px" aria-label="现场交付实拍" data-v2="onsite">
      <div class="en rv">On Site</div>
      <h2 class="rv" style="margin:12px 0 18px">现场交付</h2>
      <div class="figx r-219 rv" style="--figx-focus:center">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cabin-site-aerial.webp" />
          <img
            src="/assets/img/case-cabin-site-aerial.jpg"
            width="1920" height="1080"
            alt="项目场地航拍，箱体阵列吊装就位"
            loading="lazy" decoding="async"
            onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="ab-factory-grid rv" style="margin-top:32px">
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-transport-stacker-01.webp" />
            <img src="/assets/img/flow-transport-stacker-01.jpg" width="1164" height="1552" alt="正面吊装箱装车作业" loading="lazy" decoding="async" onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()" />
          </picture>
          <div class="figx-cap"><div class="t">装车作业</div><div class="s">正面吊装箱【待确认】</div></div>
        </div>
        <div class="figx r-43">
          <picture>
            <source type="image/webp" srcset="/assets/img/flow-transport-spreader-lift.webp" />
            <img src="/assets/img/flow-transport-spreader-lift.jpg" width="1044" height="1392" alt="平衡梁吊装箱体作业" loading="lazy" decoding="async" onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()" />
          </picture>
          <div class="figx-cap"><div class="t">吊装就位</div><div class="s">平衡梁吊装【待确认】</div></div>
        </div>
      </div>
    </section>


    <div style="padding-bottom:32px">
      <a class="btn btn-primary" href="/zh/contact/" data-track="consult_click">预约咨询 <span class="arr">→</span></a>
    </div>
  </div>
</BaseLayout>
