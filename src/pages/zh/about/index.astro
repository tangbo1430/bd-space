---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import GalleryImage from "../../../components/GalleryImage.astro";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import { aboutStory } from "../../../data/about-story";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import PageVisual from "../../../components/PageVisual.astro";
const english = Astro.url.pathname.startsWith("/en/");
const locale = english ? "en" : "zh";
---

<BaseLayout
  title="关于半打"
  description="半打空间，以模块化的方式连接设计、工厂制造与现场交付。了解我们的建造理念与制造过程。"
  current="about"
  headerStyle="solid"
>
  <div class="page-editorial">
    <PageVisual
      mode="cover"
      base="v11-about"
      alt="灰度空间住宅外观效果图"
      caption="从工厂开始，让空间有序成形。"
      meta="关于半打空间"
    >
      <h1 slot="title">
        把建造，
        <br />
        做成制造。
      </h1>
      <p slot="description">
        装配式混凝土空间的设计与制造者。
        <br />
        在工厂里，思考建筑的未来。
      </p>
      <a slot="actions" class="action action-primary" href="#about-idea">
        认识半打
      </a>
    </PageVisual>
    <section
      class:list={["about-story", { "about-story--english": english }]}
      id="about-idea"
      aria-label={english ? "Company introduction" : "公司介绍"}
    >
      <div class="about-story-inner">
        {aboutStory.map((story, index) => {
          const copy = story[locale];
          return (
            <section class:list={["about-panel", { "about-panel--founder": index === 5 }]} data-company-plan={index === 10 ? "funding" : undefined}>
              {!english && (
                <div class="about-panel-source">
                  <GalleryImage
                    fit="contain"
                    base={`r4-about-${String(index + 1).padStart(2, "0")}`}
                    alt={copy.title}
                    caption={copy.title}
                    group="about-company"
                    sizes="(max-width: 767px) calc(100vw - 48px), 1200px"
                  />
                </div>
              )}
              <div class="about-copy">
                <h2>{copy.title}</h2>
                <div class="about-copy-body">
                  {copy.paragraphs.map((text) => (
                    <p>{text}</p>
                  ))}
                  {copy.rows && (
                    <dl>
                      {copy.rows.map(([label, value]) => (
                        <div>
                          <dt>{label}</dt>
                          <dd>
                            {index === 12 ? (
                              <a href={`tel:${value.replace(/\s/g, "")}`}>
                                {value}
                              </a>
                            ) : (
                              value
                            )}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {index === 12 && (
                    <a
                      class="action action-secondary"
                      href={english ? "/en/contact/" : "/zh/contact/"}
                    >
                      {english ? "Contact us" : "联系我们"}
                    </a>
                  )}
                </div>
              </div>
              {english && story.images && (
                <div
                  class:list={[
                    "about-story-media",
                    {
                      "about-story-media--portrait": index === 5,
                      "about-story-media--systems": story.images.length > 1,
                    },
                  ]}
                >
                  {story.images.map((image) => (
                    <figure>
                      <EditorialImage
                        fit="contain"
                        base={image.base}
                        alt={image.en}
                        sizes={
                          index === 5
                            ? "320px"
                            : "(max-width: 767px) calc(100vw - 48px), 1100px"
                        }
                      />
                      <figcaption>{image.en}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </section>
          );
        })}
      </div>
    </section>
    {!english && <PhotoViewer />}
    <ProjectCTA />
  </div>
</BaseLayout>
