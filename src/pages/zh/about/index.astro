---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import GalleryImage from "../../../components/GalleryImage.astro";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import { aboutRevision } from "../../../data/about-revision";
const english = Astro.url.pathname.startsWith("/en/");
const locale = english ? "en" : "zh";
---

<BaseLayout
  title={english ? "About Banda" : "关于半打"}
  description={
    english
      ? "An industrialised building system for housing. Discover Banda’s approach to design, components and manufacturing."
      : "半打空间，以工业化制造的建房系统，连接设计、部品制造与住宅生活。"
  }
  current="about"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section
      class:list={["company-cover", { "company-cover--en": english }]}
      aria-label={english ? "About Banda" : "关于半打空间"}
    >
      {english ? (
        <>
          <EditorialImage
            base="r82-about-cover-house"
            eager
            fit="contain"
            alt="Banda housing system — architectural rendering"
          />
          <div class="company-cover-copy">
            <h1>An industrialised building system for housing.</h1>
            <p>Semi Six Modular Building Manufacturing (Jiangmen) Co.,Ltd</p>
          </div>
        </>
      ) : (
        <>
          <h1 class="sr-only">半打空间，一套可以工业化制造的建房系统。</h1>
          <GalleryImage
            base="r82-about-cover"
            eager
            fit="contain"
            group="company-cover"
            alt="半打空间，一套可以工业化制造的建房系统"
          />
          <p class="company-cover-mobile">
            半打空间，一套可以工业化制造的建房系统。
          </p>
        </>
      )}
    </section>
    <section
      class="company-revision"
      id="about-idea"
      aria-label={english ? "Company story" : "公司介绍"}
    >
      {aboutRevision.map((story, index) => {
        const copy = story[locale];
        const founder = index === 0;
        return (
          <section
            class:list={[
              "company-section",
              "company-section--" + (index + 1),
              { "company-section--text": !story.image },
            ]}
            data-source-panel={index + 1}
          >
            <div class="company-text">
              <h2>{founder ? (english ? "Huang Kun" : "黄昆") : copy.title}</h2>
              {copy.paragraphs.map((text) => (
                <p>{text}</p>
              ))}
            </div>
            {story.image && (
              <div class="company-art">
                <GalleryImage
                  base={story.image}
                  fit="contain"
                  group="company-art"
                  alt={
                    founder
                      ? english
                        ? "Huang Kun by the sea"
                        : "黄昆在海边"
                      : copy.title
                  }
                  caption={copy.title}
                  sizes="(max-width:767px) calc(100vw - 48px), 52vw"
                />
                {"second" in story && story.second && (
                  <GalleryImage
                    base={story.second}
                    fit="contain"
                    group="company-art"
                    alt={english ? "Building components" : "住宅部品分解示意"}
                    sizes="(max-width:767px) calc(100vw - 48px), 24vw"
                  />
                )}
              </div>
            )}
          </section>
        );
      })}
    </section>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>
<style>
  .company-cover {
    width: 100%;
    margin-top: var(--gnb-h);
    background: var(--paper);
  }

  .company-cover :global(.gallery-link),
  .company-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .company-cover--en {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    padding: clamp(28px, 5vw, 80px) var(--content-inset);
  }

  .company-cover h1,
  .company-text h2 {
    margin: 0 0 16px;
    font-size: clamp(28px, 2.65vw, 44px);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .company-cover-copy p,
  .company-text p {
    margin: 0 0 12px;
    max-width: 44ch;
    color: var(--ink-body);
    font-size: 16px;
    line-height: 1.75;
  }

  .company-cover-mobile {
    display: none;
  }

  .company-revision {
    scroll-margin-top: var(--gnb-h);
  }

  .company-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 90px);
    align-items: center;
    padding: clamp(36px, 4.8vw, 72px) var(--content-inset);
  }

  .company-section + .company-section {
    border-top: 1px solid var(--hairline);
  }

  .company-text,
  .company-art {
    min-width: 0;
  }

  .company-text p:last-child {
    margin-bottom: 0;
  }

  .company-art :global(.gallery-link),
  .company-art :global(.editorial-image),
  .company-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .company-art :global(.editorial-image) {
    background: transparent;
  }

  .company-section--1 {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    background: var(--paper-deep);
  }

  .company-section--1 .company-art {
    grid-area: 1 / 1;
  }

  .company-section--1 h2 {
    font-size: clamp(36px, 4vw, 62px);
  }

  .company-section--1 .company-text p {
    color: var(--charcoal);
    font-size: clamp(18px, 1.5vw, 23px);
    line-height: 1.6;
  }

  .company-section--2 .company-art,
  .company-section--6 .company-art {
    width: min(100%, 230px);
  }

  .company-section--4 .company-art {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: 16px;
  }

  .company-section--text {
    display: block;
    background: var(--paper-deep);
  }

  .company-section--text .company-text {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    column-gap: clamp(28px, 5vw, 90px);
  }

  .company-section--text p {
    grid-column: 2;
  }

  .company-section--text h2 {
    grid-row: 1 / span 5;
  }

  @media (max-width: 767px) {
    .company-cover--en,
    .company-section,
    .company-section--text .company-text {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .company-cover-mobile {
      display: block;
      margin: 0;
      padding: 18px var(--content-inset);
      font-size: 20px;
      line-height: 1.5;
    }

    .company-section--text .company-text {
      display: block;
    }
  }
</style>
