---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import GalleryImage from '../../../components/GalleryImage.astro';
import PhotoViewer from '../../../components/PhotoViewer.astro';
import ProjectCTA from '../../../components/ProjectCTA.astro';
import { aboutRevision } from '../../../data/about-revision';
const english=Astro.url.pathname.startsWith('/en/');
const locale=english?'en':'zh';
---
<BaseLayout title={english?'About Banda':'关于半打'} description={english?'An industrialised building system for housing. Discover Banda’s approach to design, components and manufacturing.':'半打空间，以工业化制造的建房系统，连接设计、部品制造与住宅生活。'} current="about" headerStyle="solid">
 <div class="page-editorial">
  <section class:list={['company-cover',{'company-cover--en':english}]} aria-label={english?'About Banda':'关于半打空间'}>
   {english ? <><EditorialImage base="r82-about-cover-house" eager fit="contain" alt="Banda housing system — architectural rendering"/><div class="company-cover-copy"><h1>An industrialised building system for housing.</h1><p>Semi Six Modular Building Manufacturing (Jiangmen) Co.,Ltd</p></div></> : <><h1 class="sr-only">半打空间，一套可以工业化制造的建房系统。</h1><GalleryImage base="r82-about-cover" eager fit="contain" group="company-cover" alt="半打空间，一套可以工业化制造的建房系统"/><p class="company-cover-mobile">半打空间，一套可以工业化制造的建房系统。</p></>}
  </section>
  <section class="company-revision" id="about-idea" aria-label={english?'Company story':'公司介绍'}>
   {aboutRevision.map((story,index)=>{const copy=story[locale];return <section class:list={['company-section','company-section--'+(index+1),{'company-section--text':!story.image}]} data-source-panel={index+1}>
    {story.image && <div class="company-art"><GalleryImage base={story.image} fit="contain" group="company-art" alt={copy.title} caption={copy.title} sizes="(max-width:767px) calc(100vw - 48px), 46vw"/>{'second' in story && story.second && <GalleryImage base={story.second} fit="contain" group="company-art" alt={english?'Building components':'住宅部品分解示意'} sizes="(max-width:767px) calc(100vw - 48px), 24vw"/>}</div>}
    <div class="company-text"><h2>{copy.title}</h2>{copy.paragraphs.map(text=><p>{text}</p>)}</div>
   </section>})}
  </section>
  <ProjectCTA />
  <PhotoViewer />
 </div>
</BaseLayout>
<style>
.company-cover{width:100%;background:#fff}.company-cover :global(.gallery-link){display:block}.company-cover :global(img){display:block;width:100%;height:auto}.company-cover-mobile{display:none}.company-cover--en{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:32px;padding:48px 4.5vw}.company-cover-copy{padding-right:4vw}.company-cover h1{font-size:clamp(30px,3.2vw,48px);font-weight:400;line-height:1.25;margin:0 0 24px}.company-cover-copy p{font-size:16px;line-height:1.6;color:#555}.company-revision{max-width:1440px;margin:auto;padding:0 4.5vw 64px;background:#fff}.company-section{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(28px,5vw,80px);align-items:center;padding:48px 0}.company-section+.company-section{border-top:1px solid #e6e9e7}.company-text{min-width:0}.company-text h2{font-size:clamp(28px,2.9vw,42px);line-height:1.25;font-weight:400;margin:0 0 24px}.company-text p{font-size:16px;line-height:1.85;margin:0 0 18px;color:#555}.company-text p:last-child{margin:0}.company-art{display:flex;justify-content:flex-start;gap:16px;align-items:center;min-width:0}.company-art :global(.gallery-link){min-width:0;max-width:100%;width:fit-content;flex:0 1 auto}.company-art :global(picture.editorial-image){aspect-ratio:auto!important;max-height:420px;width:fit-content;max-width:100%;background:transparent}.company-art :global(img){width:auto;max-width:100%;height:auto;max-height:420px;object-fit:contain!important;display:block}.company-section--1 .company-art :global(img){max-height:320px}.company-section--4 .company-art{flex-wrap:wrap}.company-section--4 .company-art :global(.gallery-link:first-child){flex-basis:100%}.company-section--4 .company-art :global(.gallery-link:last-child){max-width:60%}.company-section--4 .company-art :global(img){max-height:280px}.company-section--text{grid-template-columns:1fr}.company-section--text .company-text{display:grid;grid-template-columns:1fr 1fr;column-gap:80px}.company-section--text h2{grid-row:span 5}.company-section--text p{grid-column:2}
@media(min-width:768px){.company-section--1,.company-section--2{grid-template-columns:minmax(0,.5fr) minmax(0,1.5fr)}.company-section--2 .company-art :global(img){max-height:320px}}
@media(max-width:767px){.company-cover--en{grid-template-columns:1fr;padding:28px 24px;gap:24px}.company-cover-mobile{display:block;margin:0;padding:20px 24px;font-size:20px;line-height:1.6}.company-revision{padding:0 24px 40px}.company-section{grid-template-columns:1fr;gap:24px;padding:32px 0}.company-art :global(img){max-height:320px}.company-section--1 .company-art :global(img){max-height:320px}.company-text h2{margin-bottom:20px}.company-section--text .company-text{display:block}.company-section--text p{margin-bottom:18px}}
</style>



