---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import { imageDimensions } from "../../../lib/image-dimensions";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import { aboutRevision } from "../../../data/about-revision";
const english = Astro.url.pathname.startsWith("/en/");
const locale = english ? "en" : "zh";
---

<BaseLayout
  title={english ? "About Banda" : "关于半打"}
  description={
    english
      ? "An industrialised building system for housing. Discover Banda’s approach to design, components and manufacturing."
      : "半打空间，以工业化制造的建房系统，连接设计、部品制造与住宅生活。"
  }
  current="about"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="company-cover" aria-labelledby="company-title">
      <h1 id="company-title" class="sr-only">
        {english
          ? "An industrialised building system for housing."
          : "半打空间，一套可以工业化制造的建房系统。"}
      </h1>
      <EditorialImage
        base="r82-about-cover"
        eager
        fit="contain"
        alt={
          english
            ? "Architectural rendering of a Semi Six Modular home"
            : "半打空间模块化住宅效果图"
        }
      />
    </section>
    <section
      class="company-profile"
      id="about-idea"
      aria-label={english ? "Company profile" : "公司介绍"}
    >
      <input
        class="profile-toggle"
        id="profile-text"
        type="checkbox"
        aria-controls="profile-plates"
      />
      <label class="profile-toggle-label" for="profile-text">
        {english ? "Show the text alongside each image" : "显示分段正文"}
      </label>
      <div class="profile-plates" id="profile-plates">
        {aboutRevision.map((story, i) => {
          const file =
            !english && i === 2
              ? "profile-wall-zh"
              : `nov-profile-${locale}-${i + 1}`;
          const full = `/assets/img/${file}.webp`;
          const [width, height] = imageDimensions(full);
          return (
            <figure>
              <a
                href={full}
                data-gallery="profile"
                data-gallery-source={full}
                data-gallery-width={width}
                data-gallery-height={height}
                data-gallery-thumb={`/assets/thumbs/${file}.webp`}
                data-gallery-caption={story[locale].title}
                aria-label={
                  english
                    ? `Enlarge: ${story.en.title}`
                    : `放大查看：${story.zh.title}`
                }
              >
                <picture>
                  <source
                    media="(max-width: 650px)"
                    srcset={`/assets/img/${file}-m.webp`}
                  />
                  <img
                    src={full}
                    alt={story[locale].title}
                    width={width}
                    height={height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <figcaption>
                <h2>{story[locale].title}</h2>
                {story[locale].body.split("\n").map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </figcaption>
            </figure>
          );
        })}
      </div>
    </section>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>
<style>
  .company-cover {
    margin-top: var(--gnb-h);
    background: white;
  }
  .company-cover :global(img),
  .profile-plates :is(a, picture, img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .company-profile {
    max-width: 1560px;
    margin-inline: auto;
    scroll-margin-top: var(--gnb-h);
  }
  .profile-plates {
    width: 100%;
  }
  .profile-plates a {
    cursor: zoom-in;
  }
  .profile-plates a:focus-visible {
    outline: 3px solid var(--charcoal);
    outline-offset: -3px;
  }
  .profile-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .profile-toggle-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 18px var(--ed-gutter);
    padding: 9px 16px;
    border: 1px solid var(--vp-border-strong, rgb(22 29 26 / 0.18));
    border-radius: 999px;
    background: var(--vp-card, #f9f8f5);
    color: var(--vp-ink, #161d1a);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    user-select: none;
    transition:
      border-color 200ms var(--vp-ease, ease),
      background-color 200ms var(--vp-ease, ease);
  }
  .profile-toggle-label::before {
    content: "";
    flex: none;
    width: 34px;
    height: 18px;
    border-radius: 999px;
    background: rgb(22 29 26 / 0.22);
    transition: background-color 220ms var(--vp-ease, ease);
  }
  .profile-toggle-label::after {
    content: "";
    position: absolute;
    left: 16px;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    transform: translate(3px, -50%);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 220ms var(--vp-ease, ease);
  }
  .profile-toggle:checked + .profile-toggle-label {
    border-color: var(--vp-accent, #007963);
    background: var(--vp-accent-soft, #e7f3ef);
  }
  .profile-toggle:checked + .profile-toggle-label::before {
    background: var(--vp-accent, #007963);
  }
  .profile-toggle:checked + .profile-toggle-label::after {
    transform: translate(19px, -50%);
  }
  .profile-toggle:focus-visible + .profile-toggle-label {
    outline: 2px solid var(--vp-accent, #007963);
    outline-offset: 4px;
  }
  .profile-plates figure {
    margin: 0;
  }
  .profile-plates figcaption {
    display: none;
    max-width: 72ch;
    margin: 16px auto 32px;
    padding: 20px 24px 22px;
    background: var(--vp-card, #f9f8f5);
    border: 1px solid var(--vp-border, rgb(22 29 26 / 0.09));
    border-left: 3px solid var(--vp-accent, #007963);
    border-radius: var(--vp-radius, 3px);
  }
  .profile-toggle:checked ~ .profile-plates figcaption {
    display: block;
  }
  .profile-plates h2 {
    margin: 0 0 10px;
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.35;
    font-weight: 500;
  }
  .profile-plates p {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-body);
  }
  .profile-plates p + p {
    margin-top: 0.55em;
  }
  @media (max-width: 767px) {
    .profile-toggle,
    .profile-toggle-label {
      display: none;
    }
    .profile-plates figcaption {
      display: block;
      margin: 14px 20px 28px;
      padding: 18px 20px 20px;
    }
  }
</style>
