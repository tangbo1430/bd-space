---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import GalleryImage from "../../../components/GalleryImage.astro";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import { aboutRevision } from "../../../data/about-revision";
const english = Astro.url.pathname.startsWith("/en/");
const locale = english ? "en" : "zh";
---

<BaseLayout
  title={english ? "About Banda" : "关于半打"}
  description={
    english
      ? "An industrialised building system for housing. Discover Banda’s approach to design, components and manufacturing."
      : "半打空间，以工业化制造的建房系统，连接设计、部品制造与住宅生活。"
  }
  current="about"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="company-cover" aria-labelledby="company-title">
      <div class="company-cover-copy">
        <p>
          {english
            ? "Semi Six Modular Building Manufacturing (Jiangmen) Co., Ltd."
            : "半打空间"}
        </p>
        <h1 id="company-title">
          {english ? (
            "An industrialised building system for housing."
          ) : (
            <>
              一套可以<span class="company-title-phrase">工业化制造</span>
              的建房系统。
            </>
          )}
        </h1>
      </div>
      <EditorialImage
        base="r82-about-cover-house"
        eager
        fit="contain"
        alt={
          english
            ? "Banda housing system architectural rendering"
            : "半打空间建房系统效果图"
        }
        sizes="(max-width: 699px) calc(100vw - 40px), 50vw"
      />
    </section>
    <section
      class="company-revision"
      id="about-idea"
      aria-label={english ? "Company story" : "公司介绍"}
    >
      {aboutRevision.map((story, index) => {
        const copy = story[locale];
        const founder = index === 0;
        const second = "second" in story ? story.second : undefined;
        return (
          <section
            class:list={[
              "company-section",
              {
                "company-founder": founder,
                "company-field": index === 1,
                "company-residential": index === 4 || index === 5,
                "company-homes": index === 4,
                "company-drawing": index === 5,
                "company-definition": index === 6,
                "company-outlook": !story.image,
              },
            ]}
            data-source-panel={index + 1}
          >
            {story.image && (
              <div class:list={["company-art", { "company-art-pair": second }]}>
                <GalleryImage
                  base={story.image}
                  fit={index === 1 || index === 4 ? "cover" : "contain"}
                  group="company-art"
                  alt={
                    founder
                      ? english
                        ? "Huang Kun by the sea"
                        : "黄昆在海边"
                      : copy.title
                  }
                  caption={copy.title}
                  sizes={
                    founder
                      ? "(max-width: 699px) calc(100vw - 40px), 40vw"
                      : index >= 4
                        ? "(max-width: 699px) calc(100vw - 40px), 48vw"
                        : "(max-width: 699px) calc(100vw - 40px), (max-width: 1099px) 42vw, 360px"
                  }
                />
                {second && (
                  <GalleryImage
                    base={second}
                    fit="contain"
                    group="company-art"
                    alt={english ? "Building components" : "住宅部品分解示意"}
                    sizes="(max-width: 699px) 45vw, 180px"
                  />
                )}
              </div>
            )}
            <div class="company-text">
              <h2>{copy.title}</h2>
              <p>{copy.body}</p>
            </div>
          </section>
        );
      })}
    </section>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>
<style>
  .company-cover,
  .company-revision {
    width: min(100% - 2 * var(--ed-gutter), 1160px);
    margin-inline: auto;
  }

  .company-cover {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    margin-top: var(--gnb-h);
    padding-block: clamp(28px, 3.8vw, 54px);
  }

  .company-cover h1 {
    margin: 8px 0 0;
    color: var(--charcoal);
    font-size: clamp(30px, 3.2vw, 46px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .company-title-phrase {
    white-space: nowrap;
  }

  .company-cover p,
  .company-text p {
    margin: 0;
    color: var(--ink-body);
    font-size: 16px;
    line-height: 1.72;
  }

  .company-text p {
    line-height: 1.82;
  }

  .company-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .company-revision {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(22px, 3.2vw, 40px);
    row-gap: clamp(34px, 4.4vw, 62px);
    scroll-margin-top: calc(var(--gnb-h) + 12px);
    margin-bottom: clamp(36px, 4.6vw, 64px);
  }

  .company-section {
    grid-column: span 2;
    min-width: 0;
  }

  .company-text h2 {
    margin: 0 0 10px;
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .company-art {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    aspect-ratio: 1.62;
    margin-bottom: 16px;
    background: var(--paper);
  }

  .company-art-pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    background: var(--paper);
  }

  .company-art :global(.gallery-link),
  .company-art :global(.editorial-image),
  .company-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .company-section:not(.company-founder) .company-art :global(.gallery-link) {
    position: relative;
  }

  .company-section:not(.company-founder)
    .company-art
    :global(.editorial-image) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .company-section:not(.company-founder)
    .company-art
    :global(.editorial-image img) {
    height: 100%;
  }

  .company-art :global(.editorial-image) {
    aspect-ratio: auto !important;
    background: transparent;
  }

  .company-art :global(img) {
    object-fit: contain;
  }

  .company-field .company-art :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  .company-residential {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, clamp(240px, 34%, 360px)) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .company-residential .company-text h2 {
    margin-bottom: clamp(12px, 1.4vw, 20px);
    font-size: clamp(30px, 3.2vw, 48px);
  }

  .company-residential .company-text p {
    max-width: 620px;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.65;
  }

  .company-residential .company-art {
    aspect-ratio: 1;
    margin: 0;
  }

  .company-homes .company-art :global(img) {
    object-fit: cover;
    object-position: center 58%;
  }

  .company-drawing .company-art :global(.editorial-image img) {
    object-fit: cover;
    object-position: center 56%;
  }

  .company-definition {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 3.4vw, 42px);
  }

  .company-definition .company-art {
    aspect-ratio: 2000 / 645;
    margin: 0;
  }

  .company-founder,
  .company-outlook {
    grid-column: 1 / -1;
    background: var(--paper-deep);
    padding: clamp(18px, 2.5vw, 32px);
  }

  .company-founder {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    padding: 0;
    gap: clamp(18px, 3vw, 36px);
  }

  .company-founder .company-text {
    padding: clamp(16px, 2.5vw, 32px);
  }

  .company-founder .company-art {
    margin: 0;
    aspect-ratio: auto;
  }

  .company-founder .company-art :global(.gallery-link),
  .company-founder .company-art :global(.editorial-image),
  .company-founder .company-art :global(img) {
    height: auto;
  }

  .company-founder p,
  .company-outlook p {
    max-width: 64ch;
  }

  @media (max-width: 699px) {
    .company-cover,
    .company-revision,
    .company-founder,
    .company-residential,
    .company-definition {
      grid-template-columns: minmax(0, 1fr);
    }

    .company-cover,
    .company-founder,
    .company-residential,
    .company-definition {
      gap: 12px;
    }

    .company-section {
      grid-column: 1 / -1;
    }

    .company-art {
      margin-bottom: 12px;
    }
  }
</style>
