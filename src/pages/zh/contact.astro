---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ConsultForm from "../../components/ConsultForm.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import { company, contacts } from "../../data/company";
---

<BaseLayout
  title="联系我们"
  description="联系半打空间：唐小姐18503005860，邮箱411547750@qq.com。沟通住宅、文旅及模块化项目，或下载本地项目需求。"
  current="contact"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="page-opening ed-wrap">
      <span class="eyebrow">项目咨询</span>
      <div class="page-heading">
        <h1>
          一个想法，
          <br />
          一处新空间。
        </h1>
        <p>
          无论您的项目刚刚起步，
          <br />
          还是已有清晰的计划，
          <br />
          我们期待听到您的想法。
        </p>
      </div>
      <nav class="contact-quick" aria-label="快捷联系">
        <a class="action action-primary" href={`tel:${company.contact.phone}`}>
          电话联系
        </a>
        <a class="action action-secondary" href="#wechat">
          微信联系
        </a>
        <a
          class="action action-secondary"
          href={`mailto:${company.contact.email}`}
        >
          邮件联系
        </a>
      </nav>
    </section>
    <section class="contact-layout ed-wrap" aria-label="项目咨询与联系信息">
      <div class="contact-story">
        <EditorialImage
          base="home-banner-60m-dining-02"
          alt="半打空间室内餐厅，木色天花与暖白家具"
          mobile={false}
        />
        <p>
          您可以描述项目所在地、用途与空间需求，帮助我们理解您对未来空间的期待。
        </p>
        <dl class="contact-information">
          <dt>电话</dt>
          <dd>
            <a href={`tel:${company.contact.phone}`}>
              唐小姐 · {company.contact.phone}
            </a>
          </dd>
          <dt>邮箱</dt>
          <dd>
            <a href={`mailto:${company.contact.email}`}>
              {company.contact.email}
            </a>
          </dd>
          <dt>办公地址</dt>
          <dd>{company.contact.office}</dd>
          <dt>工作时间</dt>
          <dd>{company.contact.hours}</dd>
          <dt>工厂地址</dt>
          <dd>{company.contact.address}</dd>
          <dt>地图坐标</dt>
          <dd>{company.contact.coordinates}</dd>
        </dl>
      </div>
      <div class="contact-form">
        <h2>从这里开始对话。</h2>
        <ConsultForm id="contact" />
      </div>
    </section>
    <section class="wechat-section evidence-band" id="wechat">
      <div class="ed-wrap ed-section">
        <div class="evidence-heading">
          <div>
            <span class="eyebrow">微信联系</span>
            <h2>把想法，聊得更具体。</h2>
          </div>
          <p>
            选择联系人，点击二维码查看大图。
            <br />
            也可以通过电话或邮件与我们沟通。
          </p>
        </div>
        <div class="wechat-grid">
          {contacts.map((p) => (
            <article>
              <a
                class="wechat-code"
                href={`/assets/img/wechat-${p.id}.png`}
                data-gallery="wechat"
                data-gallery-caption={`${p.name} · 微信联系`}
                aria-label={`放大${p.name}的微信二维码`}
              >
                <img
                  src={`/assets/img/wechat-${p.id}.png`}
                  alt={`${p.name}微信二维码`}
                  width="1000"
                  height="1000"
                  loading="lazy"
                />
              </a>
              <h3>{p.name}</h3>
              <a class="contact-phone" href={`tel:${p.phone}`}>
                {p.phone}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="ed-wrap ed-section contact-location">
      <div class="evidence-heading">
        <div>
          <span class="eyebrow">到访位置</span>
          <h2>广东 · 江门</h2>
        </div>
        <p>
          工厂地址：{company.contact.address}
          <br />
          到访前可通过电话确认安排。
        </p>
      </div>
      <a
        href="/assets/img/contact-map.webp"
        data-gallery="map"
        data-gallery-caption="广东江门 · 位置参考"
        aria-label="放大查看位置图"
      >
        <img
          src="/assets/img/contact-map.webp"
          alt="广东江门位置参考图"
          width="1571"
          height="740"
          loading="lazy"
        />
      </a>
    </section>
    <PhotoViewer />
  </div>
</BaseLayout>
