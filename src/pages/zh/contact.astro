---
/**
 * 联系我们 v3.2（SPEC-v3.2 §3.6）：
 * 短页头 46vh → 白底双栏（左=联系信息细线列表+地图马赛克占位；右=下划线表单）。
 * 表单状态机与四态沿用现有实现，视觉改细线+下划线，不用卡片。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import Mos from '../../components/Mos.astro';
import { site } from '../../lib/site';
---

<BaseLayout
  title="联系我们"
  description="联系半打空间：电话、邮箱、地址与在线咨询表单。留下您的项目需求，我们将在 1 个工作日内回复。"
  current="contact"
  headerStyle="overlay"
  master="v32"
>
  {/* 短页头 46vh */}
  <section class="phero phero-sm" aria-label="联系我们页头">
    <div class="ph3" aria-hidden="true">
      <picture>
        <source media="(max-width: 720px)" type="image/webp" srcset="/assets/img/case-cabin-site-aerial-m.webp" />
        <source type="image/webp" srcset="/assets/img/case-cabin-site-aerial.webp" />
        <img src="/assets/img/case-cabin-site-aerial.jpg" width="1920" height="1080" alt="" loading="eager" decoding="async" fetchpriority="high" onerror="this.closest('.phero').classList.add('ph-fallback');this.closest('picture').remove()" />
      </picture>
    </div>
    <div class="hc">
      <div class="eyebrow on-dark">Contact</div>
      <h1>联系我们</h1>
      <p class="sub">留下需求，我们将在 1 个工作日内回复。【示例文案，待确认】</p>
    </div>
  </section>

  {/* 白底双栏：信息列表 + 地图占位 / 下划线表单 */}
  <section class="sec" aria-label="联系方式与在线留言">
    <div class="wrap cgrid32">
      <div class="rv">
        <div class="eyebrow">Info</div>
        <h2 class="h2">联系方式</h2>
        <ul class="cinfo32">
          <li><b>电话</b>{site.contact.phone}</li>
          <li><b>邮箱</b>{site.contact.email}</li>
          <li><b>地址</b>{site.contact.address}</li>
          <li><b>商务合作</b>【待提供】</li>
        </ul>
        <div style="margin-top:32px">
          <Mos id="PH-MAP" use="公司位置地图" ratio="16:9" min="1200×675" subject="办公地点，居中标注" r="r169" />
        </div>
      </div>
      <div class="formflat rv">
        <h3>在线留言</h3>
        <p class="fs-note">带 * 为必填。提交后我们将在 1 个工作日内回复；若服务暂未开通，可先通过电话或邮箱联系。</p>
        <ConsultForm id="contact" />
      </div>
    </div>
  </section>
</BaseLayout>