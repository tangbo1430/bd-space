---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import GalleryImage from "../../components/GalleryImage.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import projects from "../../data/projects.json";
const heroProject = projects.find((project) => project.id === "cayman")!;
const filters = [
  { id: "all", name: "全部项目" },
  { id: "domestic", name: "中国项目" },
  { id: "overseas", name: "海外项目" },
];
---

<BaseLayout
  title="工程案例"
  description="半打空间项目与团队历年实践：10个国内外建筑案例，展示项目地点、年份、面积、建造方式与现场记录。"
  current="cases"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="cases-hero" aria-labelledby="cases-title">
      <EditorialImage
        base={heroProject.base}
        class="cases-hero-photo"
        alt={heroProject.name}
        eager
        sizes="100vw"
      />
      <div class="cases-hero-copy ed-wrap">
        <h1 id="cases-title">
          <span>空间，</span>
          <span>在世界发生。</span>
        </h1>
        <p>
          2026年的半打项目，
          <br />
          与2016—2024年的团队历年实践。
          <br />
          记录从工厂到现场的探索。
        </p>
      </div>
    </section>
    <div class="cases-controls ed-wrap">
      <div class="case-filter" role="group" aria-label="按项目地区筛选">
        {filters.map((f) => (
          <button
            type="button"
            class:list={{ active: f.id === "all" }}
            data-case-filter={f.id}
            aria-pressed={f.id === "all"}
          >
            {f.name}
            <span class="filter-count">
              {String(
                projects.filter((p) => f.id === "all" || p.region === f.id)
                  .length,
              ).padStart(2, "0")}
            </span>
          </button>
        ))}
      </div>
      <p class="sr-only" data-filter-status role="status">
        显示 {projects.length} 个项目
      </p>
    </div>
    <div class="case-grid ed-wrap">
      {projects.map((p, i) => (
        <article class="case-project" id={p.id} data-case-region={p.region}>
          <div class="project-lead">
            <GalleryImage
              fit="contain"
              base={p.base}
              alt={`${p.name} · 项目外观`}
              group={p.id}
              caption={`${p.name} / ${p.year} / ${p.era}`}
              eager={i < 2}
              sizes="(max-width: 767px) 100vw, 50vw"
            />
          </div>
          <div class="case-project-head">
            <span class="eyebrow">
              {p.era} · {p.year}
            </span>
            <h2>{p.name}</h2>
            <p class="project-location">{p.location}</p>
          </div>
          <dl class="project-facts">
            <div>
              <dt>项目面积</dt>
              <dd>{p.area}</dd>
            </div>
            <div>
              <dt>工期</dt>
              <dd>{p.duration}</dd>
            </div>
            <div>
              <dt>完工状态</dt>
              <dd>{p.status}</dd>
            </div>
            <div>
              <dt>建造方式</dt>
              <dd>{p.method}</dd>
            </div>
          </dl>
          <p class="project-description">
            <span class="eyebrow">交付范围</span>
            <br />
            {p.scope}
          </p>
          <div class="project-photos" aria-label={`${p.name}的现场照片`}>
            {p.gallery.map((photo) => (
              <GalleryImage
                fit="contain"
                base={photo.base}
                alt={photo.caption}
                group={p.id}
                sizes="(max-width: 767px) 25vw, 12vw"
              />
            ))}
          </div>
          <a
            class="action action-secondary"
            href={`/zh/contact/?project=${p.id}`}
          >
            咨询类似项目
          </a>
        </article>
      ))}
    </div>
    <p class="ed-wrap case-source-note">
      安装工期不等同于整屋交付周期，具体范围以各项目说明与约定为准。
    </p>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>

<style>
  .cases-hero {
    margin-top: var(--gnb-h);
    background: var(--paper);
  }

  .cases-hero :global(.cases-hero-photo) {
    aspect-ratio: 2.45;
    height: auto;
    max-height: min(64svh, 650px);
  }

  .cases-hero :global(.cases-hero-photo img) {
    display: block;
    object-position: center 52%;
  }

  .cases-hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(20px, 5vw, 84px);
    padding-block: clamp(26px, 3.4vw, 60px) 20px;
  }

  .cases-hero h1 {
    margin: 0;
    color: var(--charcoal);
    font-size: clamp(31px, 4vw, 60px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .cases-hero h1 span {
    display: inline-block;
  }

  .cases-hero p {
    margin: 0;
    color: var(--ink-body);
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.7;
  }

  .cases-controls {
    padding-block: 12px clamp(24px, 3vw, 44px);
  }

  .cases-controls .case-filter {
    margin: 0;
  }

  @media (max-width: 767px) {
    .cases-hero :global(.cases-hero-photo) {
      aspect-ratio: 1.65;
    }

    .cases-hero-copy {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
