---
/**
 * 工程案例 v3.2（SPEC-v3.2 §3.5）：
 * 页头 64vh → 编辑式案例组 ×4（组头 + 首图通栏 21:9 + 两列 16:9 ×2）→ 扩展说明 → 转化章。
 * 年份等事实一律【待确认】，不虚构。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

interface CaseGroup {
  no: string;
  title: string;
  sub: string;
  lead: { base: string; alt: string };
  caps: { lead: string; items: [string, string][] };
  imgs: { base: string; alt: string }[];
}

const groups: CaseGroup[] = [
  {
    no: 'CASE 01', title: '开曼群岛 · 海外住宅', sub: '二层模块住宅 · 【待确认】年份',
    lead: { base: 'case-cover-cayman', alt: '开曼项目全景' },
    caps: { lead: '项目实景 — 全景', items: [['二层模块吊装', 'case-cayman-install-02'], ['屋面模块就位', 'case-cayman-install-roof']] },
    imgs: [
      { base: 'case-cayman-install-02', alt: '开曼项目吊装现场' },
      { base: 'case-cayman-install-roof', alt: '开曼项目屋面吊装' },
    ],
  },
  {
    no: 'CASE 02', title: '中国 · 常州 4S 住宅', sub: '4S 独栋 · 【待确认】年份',
    lead: { base: 'case-cover-changzhou', alt: '常州 4S 住宅全景' },
    caps: { lead: '项目实景 — 全景', items: [['现场安装', 'case-changzhou-install-02'], ['模块就位', 'case-changzhou-install-03']] },
    imgs: [
      { base: 'case-changzhou-install-02', alt: '常州项目安装现场' },
      { base: 'case-changzhou-install-03', alt: '常州项目模块就位' },
    ],
  },
  {
    no: 'CASE 03', title: '澳大利亚 · 布里斯班 独栋民宅', sub: '独栋民宅 · 【待确认】年份',
    lead: { base: 'case-cover-brisbane', alt: '布里斯班民宅全景' },
    caps: { lead: '项目实景 — 全景', items: [['模块吊装', 'case-brisbane-lift-01'], ['现场安装', 'case-brisbane-install-02']] },
    imgs: [
      { base: 'case-brisbane-lift-01', alt: '布里斯班项目吊装' },
      { base: 'case-brisbane-install-02', alt: '布里斯班项目安装' },
    ],
  },
  {
    no: 'CASE 04', title: '中国 · 成都 集宿项目', sub: '集宿建筑 · 【待确认】年份',
    lead: { base: 'case-cover-chengdu-dorm', alt: '成都集宿项目全景' },
    caps: { lead: '项目实景 — 全景', items: [['现场拼装', 'case-chengdu-assembly-01'], ['模块安装', 'case-chengdu-install-03']] },
    imgs: [
      { base: 'case-chengdu-assembly-01', alt: '成都项目拼装现场' },
      { base: 'case-chengdu-install-03', alt: '成都项目模块安装' },
    ],
  },
];
---

<BaseLayout
  title="工程案例"
  description="半打空间工程案例：开曼群岛、常州、布里斯班、成都等已交付与在建项目实录。"
  current="cases"
  headerStyle="overlay"
  master="v32"
>
  {/* 页头 64vh */}
  <section class="phero" aria-label="工程案例页头">
    <div class="ph3" aria-hidden="true">
      <picture>
        <source media="(max-width: 720px)" type="image/webp" srcset="/assets/img/case-cayman-install-crane-m.webp" />
        <source type="image/webp" srcset="/assets/img/case-cayman-install-crane.webp" />
        <img src="/assets/img/case-cayman-install-crane.jpg" width="1920" height="1080" alt="" loading="eager" decoding="async" fetchpriority="high" onerror="this.closest('.phero').classList.add('ph-fallback');this.closest('picture').remove()" />
      </picture>
    </div>
    <div class="hc">
      <div class="eyebrow on-dark">Projects</div>
      <h1>工程案例</h1>
      <p class="sub">已交付与在建项目实录。</p>
    </div>
  </section>

  {/* 编辑式案例组 ×4 */}
  <section class="sec" aria-label="案例组">
    <div class="wrap">
      {groups.map((g) => (
        <article class="cg32" aria-label={g.title}>
          <div class="cgh rv"><div class="no">{g.no}</div><h2 class="t">{g.title}</h2><div class="s">{g.sub}</div></div>
          <div class="lead-img r219 rv">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${g.lead.base}-m.webp 960w, /assets/img/${g.lead.base}.webp 1667w`} sizes="100vw" />
              <img src={`/assets/img/${g.lead.base}.jpg`} width="1667" height="1250" alt={g.lead.alt} loading="lazy" decoding="async" onerror="this.closest('.lead-img').classList.add('ph-fallback');this.closest('picture').remove()" />
            </picture>
          </div>
          <div class="figcap rv" style="margin-bottom:20px">{g.caps.lead}</div>
          <div class="grid2">
            {g.imgs.map((im, i) => (
              <div class="rv">
                <div class="gi r169">
                  <picture>
                    <source type="image/webp" srcset={`/assets/img/${im.base}-m.webp 960w, /assets/img/${im.base}.webp 1667w`} sizes="(max-width: 720px) 100vw, 50vw" />
                    <img src={`/assets/img/${im.base}.jpg`} width="1667" height="1250" alt={im.alt} loading="lazy" decoding="async" onerror="this.closest('.gi').classList.add('ph-fallback');this.closest('picture').remove()" />
                  </picture>
                </div>
                <div class="figcap">{g.caps.items[i][0]}</div>
              </div>
            ))}
          </div>
        </article>
      ))}
      <p class="small rv">中山、江门、深圳、斐济等更多项目素材已在素材库中，可按同一版式扩展；每组保留 3–5 张。</p>
    </div>
  </section>

  {/* 转化章 */}
  <section class="conv32" aria-label="案例咨询">
    <div class="ph3" aria-hidden="true">
      <picture>
        <source type="image/webp" srcset="/assets/img/case-cabin-rows-m.webp 960w, /assets/img/case-cabin-rows.webp 1920w" sizes="100vw" />
        <img src="/assets/img/case-cabin-rows.jpg" width="1920" height="1080" alt="" loading="lazy" decoding="async" onerror="this.closest('.conv32').classList.add('ph-fallback');this.closest('picture').remove()" />
      </picture>
    </div>
    <div class="hc">
      <h2 class="rv">有类似的项目？</h2>
      <p class="rv">告诉我们场地与需求，评估适用产品。【示例文案，待确认】</p>
      <a class="btn btn-primary rv" href="/zh/contact/" data-track="consult_click">联系我们 <span class="arr">→</span></a>
    </div>
  </section>
</BaseLayout>