---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CASE_COVER_ASSETS, SHENZHEN_V20_ASSETS, CASE_DETAIL_GROUPS } from '../../lib/assets';

/* v3.0.1 封面区：通栏首卡（常州）+ 2 列 4:3 大卡 ×8（仅地点+类型，无客户名） */
const covers = [
  { loc: '开曼群岛', type: '海外住宅', img: CASE_COVER_ASSETS.cayman },
  { loc: '中山', type: '风度住宅', img: CASE_COVER_ASSETS.zhongshan },
  { loc: '澳大利亚 · 布里斯班', type: '独栋民宅', img: CASE_COVER_ASSETS.brisbane },
  { loc: '成都', type: '宿舍建筑', img: CASE_COVER_ASSETS.chengdu },
  { loc: '深圳', type: '营地建筑', img: SHENZHEN_V20_ASSETS.coverCamp },
  { loc: '斐济', type: '模块化建筑', img: CASE_COVER_ASSETS.fiji },
  { loc: '江门', type: '装配式建筑', img: CASE_COVER_ASSETS.jiangmen },
  { loc: '中山', type: '方舱建筑', img: CASE_COVER_ASSETS.zhongshanCabin },
];
---

<BaseLayout
  title="工程案例"
  description="半打空间项目实践：开曼群岛海外住宅、澳大利亚布里斯班住宅、中国中山低层住宅、斐济模块化建筑。"
  current="cases"
  headerStyle="overlay"
  master="v3"
>
  {/* 页首 56vh：常州封面通栏 */}
  <section class="v3hero h56" aria-label="工程案例首屏">
    <div class="ph3">
      <picture>
        <source media="(max-width: 767px)" type="image/webp" srcset="/assets/img/case-cover-changzhou-m.webp" />
        <source type="image/webp" srcset="/assets/img/case-cover-changzhou.webp" />
        <img
          src="/assets/img/case-cover-changzhou.jpg"
          width="1667" height="1250"
          alt="中国常州4S住宅项目外观实景"
          loading="eager" decoding="async" fetchpriority="high"
          onerror="this.closest('.v3hero').classList.add('ph-fallback');this.closest('picture').remove()"
        />
      </picture>
    </div>
    <div class="wrap">
      <div class="en on-dark">Projects</div>
      <h1>项目实践</h1>
    </div>
  </section>

  {/* 项目封面：首卡 21:9 通栏 + 8 张 4:3 两列 */}
  <section class="chap chap-paper" style="padding-bottom:0" aria-label="项目封面">
    <div class="wrap">
      <div class="shead rv">
        <div><div class="en">Selected</div><h2 class="v3h2" style="margin-bottom:0">项目封面</h2></div>
      </div>
    </div>
    <div class="bleed r219 rv">
      <div class="ph3">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cover-changzhou-m.webp 960w, /assets/img/case-cover-changzhou.webp 1667w" sizes="100vw" />
          <img
            src="/assets/img/case-cover-changzhou.jpg"
            width="1667" height="1250"
            alt="中国常州4S住宅项目外观实景"
            loading="lazy" decoding="async"
            onerror="this.closest('.bleed').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="cap"><div class="t">中国 · 常州</div><div class="s">4S 住宅</div></div>
    </div>
    <div class="wrap" style="padding-top:24px;padding-bottom:96px">
      <div class="g2">
        {covers.map((c) => (
          <div class="cc r43 rv">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${c.img.base}-m.webp ${c.img.mw}w, /assets/img/${c.img.base}.webp ${c.img.w}w`} sizes="(max-width: 767px) 100vw, 50vw" />
              <img
                src={`/assets/img/${c.img.base}.jpg`}
                width={c.img.w} height={c.img.h} alt={c.img.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="cap"><div class="t">{c.loc}</div><div class="s">{c.type}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 施工实景：10 组（组标 01–10 + 组名 + 通栏首图 + 双 4:3） */}
  <section class="chap chap-paper" style="padding-top:64px" aria-label="施工实景" data-case-gallery>
    <div class="wrap">
      <div class="en rv">On Site</div>
      <h2 class="v3h2 rv">施工实景</h2>
      <p class="rv" style="font-size:13px;color:var(--v3-muted)">每组 3–5 张精选，完整图组进入对应案例详情。</p>
    </div>
    {CASE_DETAIL_GROUPS.map((g, i) => (
      <div class="cg2-group">
        <div class="wrap">
          <div class="glabel rv">
            <span class="gi-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="gi-t">{g.loc} · {g.type}</span>
            <span class="gi-s">施工实景</span>
          </div>
        </div>
        <div class="bleed r219 rv">
          <div class="ph3" style={g.lead.focus ? `--figx-focus:${g.lead.focus}` : undefined}>
            <picture>
              {g.lead.mw && (
                <source type="image/webp" srcset={`/assets/img/${g.lead.base}${g.lead.msuf ?? '-m'}.webp ${g.lead.mw}w, /assets/img/${g.lead.base}.webp ${g.lead.w}w`} sizes="100vw" />
              )}
              {!g.lead.mw && <source type="image/webp" srcset={`/assets/img/${g.lead.base}.webp`} />}
              <img
                src={`/assets/img/${g.lead.base}.jpg`}
                width={g.lead.w} height={g.lead.h} alt={g.lead.alt}
                style={g.lead.focus ? `object-position:${g.lead.focus}` : undefined}
                loading="lazy" decoding="async"
                onerror="this.closest('.bleed').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
          </div>
        </div>
        <div class="wrap" style="padding-top:24px">
          <div class="g2">
            {g.bigs.map((img) => (
              <div class="cc r43 rv">
                <picture>
                  {img.mw && (
                    <source type="image/webp" srcset={`/assets/img/${img.base}${img.msuf ?? '-m'}.webp ${img.mw}w, /assets/img/${img.base}.webp ${img.w}w`} sizes="(max-width: 767px) 100vw, 50vw" />
                  )}
                  {!img.mw && <source type="image/webp" srcset={`/assets/img/${img.base}.webp`} />}
                  <img
                    src={`/assets/img/${img.base}.jpg`}
                    width={img.w} height={img.h} alt={img.alt}
                    style={img.focus ? `object-position:${img.focus}` : undefined}
                    loading="lazy" decoding="async"
                    onerror="this.closest('.cc').classList.add('ph-fallback');this.closest('picture').remove()"
                  />
                </picture>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
