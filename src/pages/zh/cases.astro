---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CASE_COVER_ASSETS, CASE_DETAIL_GROUPS } from '../../lib/assets';

/* v2.0 案例墙：通栏首卡（常州）+ 2 列 4:3 大卡混排；仅地点+类型，无客户名 */
const cases = [
  { loc: '开曼群岛', type: '海外住宅', img: CASE_COVER_ASSETS.cayman },
  { loc: '澳大利亚', type: '布里斯班住宅', img: CASE_COVER_ASSETS.brisbane },
  { loc: '中国 · 中山', type: '低层住宅', img: CASE_COVER_ASSETS.zhongshan },
  { loc: '斐济', type: '模块化建筑', img: CASE_COVER_ASSETS.fiji },
  { loc: '中国 · 成都', type: '宿舍建筑', img: CASE_COVER_ASSETS.chengdu },
  { loc: '中国 · 江门', type: '装配式建筑', img: CASE_COVER_ASSETS.jiangmen },
  { loc: '中国 · 中山', type: '方舱建筑', img: CASE_COVER_ASSETS.zhongshanCabin },
  { loc: '中国 · 中山', type: '独栋民宅', img: CASE_COVER_ASSETS.mige },
];
const leadCover = { loc: '中国 · 常州', type: '4S 住宅', img: CASE_COVER_ASSETS.changzhou };
---

<BaseLayout
  title="工程案例"
  description="半打空间项目实践：开曼群岛海外住宅、澳大利亚布里斯班住宅、中国中山低层住宅、斐济模块化建筑。"
  current="cases"
  headerStyle="solid"
>
  <p class="crumb"><a href="/zh/">HOME</a> / PROJECTS</p>
  <div class="wrap" style="padding-top:40px">
    <div class="en">Selected Projects</div>
    <h2 style="font-size:52px;margin-top:10px">项目实践</h2>
  </div>

  <section class="case-wall" aria-label="项目实践案例墙">
    <div class="cw2-grid" data-v2="case-wall">
      <article class="case-card cw2-lead rv">
        <div class="figx r-219">
          <picture>
            <source type="image/webp" srcset={`/assets/img/${leadCover.img.base}-m.webp 960w, /assets/img/${leadCover.img.base}.webp ${leadCover.img.w}w`} sizes="100vw" />
            <img
              src={`/assets/img/${leadCover.img.base}.jpg`}
              width={leadCover.img.w} height={leadCover.img.h} alt={leadCover.img.alt}
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">{leadCover.loc}</div><div class="s">{leadCover.type}</div></div>
        </div>
      </article>
      {cases.map((c) => (
        <article class="case-card rv">
          <div class="figx r-43">
            <picture>
              {c.img.mw && (
                <source type="image/webp" srcset={`/assets/img/${c.img.base}-m.webp ${c.img.mw}w, /assets/img/${c.img.base}.webp ${c.img.w}w`} sizes="(max-width: 1279px) 100vw, 50vw" />
              )}
              {!c.img.mw && <source type="image/webp" srcset={`/assets/img/${c.img.base}.webp`} />}
              <img
                src={`/assets/img/${c.img.base}.jpg`}
                width={c.img.w} height={c.img.h} alt={c.img.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="figx-cap"><div class="t">{c.loc}</div><div class="s">{c.type}</div></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- v1.8 案例施工实景图组（桌面 2–3 列网格 / 移动单列横滑；仅地点+类型，无客户名） -->
  <section class="sec case-gallery" aria-label="案例施工实景" data-case-gallery>
    <div class="wrap">
      <div class="sec-head rv">
        <div><div class="en">On Site</div><h2>施工实景</h2></div>
      </div>
      {CASE_DETAIL_GROUPS.map((g) => (
        <div class="cg2-group rv">
          <h3 class="cg2-title">{g.loc} · {g.type}</h3>
          <div class="figx r-219" style={g.lead.focus ? `--figx-focus:${g.lead.focus}` : undefined}>
            <picture>
              {g.lead.mw && (
                <source type="image/webp" srcset={`/assets/img/${g.lead.base}${g.lead.msuf ?? '-m'}.webp ${g.lead.mw}w, /assets/img/${g.lead.base}.webp ${g.lead.w}w`} sizes="100vw" />
              )}
              {!g.lead.mw && <source type="image/webp" srcset={`/assets/img/${g.lead.base}.webp`} />}
              <img
                src={`/assets/img/${g.lead.base}.jpg`}
                width={g.lead.w} height={g.lead.h} alt={g.lead.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
          </div>
          <div class="cg2-bigs">
            {g.bigs.map((img) => (
              <figure class="figx r-43" style={img.focus ? `--figx-focus:${img.focus}` : undefined}>
                <picture>
                  {img.mw && (
                    <source type="image/webp" srcset={`/assets/img/${img.base}${img.msuf ?? '-m'}.webp ${img.mw}w, /assets/img/${img.base}.webp ${img.w}w`} sizes="(max-width: 767px) 100vw, 50vw" />
                  )}
                  {!img.mw && <source type="image/webp" srcset={`/assets/img/${img.base}.webp`} />}
                  <img
                    src={`/assets/img/${img.base}.jpg`}
                    width={img.w} height={img.h} alt={img.alt}
                    loading="lazy" decoding="async"
                    onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
                  />
                </picture>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
