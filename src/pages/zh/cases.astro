---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import GalleryImage from "../../components/GalleryImage.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import projects from "../../data/projects.json";
const english = Astro.url.pathname.startsWith("/en/");
const featuredIds = ["changzhou", "cayman", "brisbane"];
const featured = featuredIds.map((id) =>
  projects.find((project) => project.id === id)!,
);
const filters = [
  { id: "all", name: "全部项目" },
  { id: "domestic", name: "中国项目" },
  { id: "overseas", name: "海外项目" },
];
---

<BaseLayout
  title="工程案例"
  description="半打空间项目与团队历年实践：10个国内外建筑案例，展示项目地点、年份、面积、建造方式与现场记录。"
  current="cases"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="cases-hero" aria-labelledby="cases-title">
      <div class="cases-hero-copy ed-wrap">
        <h1 id="cases-title">
          <span>空间，</span>
          <span>在世界发生。</span>
        </h1>
        <p>
          2026年的半打项目，
          <br />
          与2016—2024年的团队历年实践。
          <br />
          记录从工厂到现场的探索。
        </p>
      </div>
      <div class="cases-hero-gallery">
        {featured.map((project, index) => (
          <EditorialImage
            base={project.base}
            alt={project.name}
            class={
              index === 1
                ? "cases-hero-photo cases-hero-main"
                : "cases-hero-photo"
            }
            eager={index === 1}
            sizes={
              index === 1
                ? "(max-width: 767px) 92vw, 48vw"
                : "(max-width: 767px) 46vw, 24vw"
            }
          />
        ))}
      </div>
    </section>
    <div class="cases-controls ed-wrap">
      <div class="case-filter" role="group" aria-label="按项目地区筛选">
        {filters.map((f) => (
          <button
            type="button"
            class:list={{ active: f.id === "all" }}
            data-case-filter={f.id}
            aria-pressed={f.id === "all"}
          >
            {f.name}
            <span class="filter-count">
              {String(
                projects.filter((p) => f.id === "all" || p.region === f.id)
                  .length,
              ).padStart(2, "0")}
            </span>
          </button>
        ))}
      </div>
      <p class="sr-only" data-filter-status role="status">
        显示 {projects.length} 个项目
      </p>
    </div>
    <div class="case-grid cases-list ed-wrap">
      {projects.map((p, i) => (
        <article class="case-project" id={p.id} data-case-region={p.region}>
          <div class="project-lead">
            <GalleryImage
              fit="contain"
              base={p.base}
              alt={`${p.name} · 项目外观`}
              group={p.id}
              caption={`${p.name} / ${p.year} / ${p.era}`}
              eager={i < 2}
              sizes="(max-width: 767px) 92vw, 44vw"
            />
          </div>
          <div class="case-project-head">
            <span class="eyebrow">
              {p.era} · {p.year}
            </span>
            <h2>{p.name}</h2>
            <p class="project-location">{p.location}</p>
          </div>
          <details class="case-details">
            <summary>
              <span>{english ? "Project details" : "查看项目详情"}</span>
              <span aria-hidden="true" class="case-details-icon"></span>
            </summary>
            <dl class="project-facts">
              <div>
                <dt>项目面积</dt>
                <dd>{p.area}</dd>
              </div>
              <div>
                <dt>工期</dt>
                <dd>{p.duration}</dd>
              </div>
              <div>
                <dt>完工状态</dt>
                <dd>{p.status}</dd>
              </div>
              <div>
                <dt>建造方式</dt>
                <dd>{p.method}</dd>
              </div>
            </dl>
            <p class="project-description">
              <span class="eyebrow">交付范围</span>
              <br />
              {p.scope}
            </p>
            <div class="project-photos" aria-label={`${p.name}的现场照片`}>
              {p.gallery.map((photo) => (
                <GalleryImage
                  fit="contain"
                  base={photo.base}
                  alt={photo.caption}
                  group={p.id}
                  sizes="(max-width: 767px) 25vw, 12vw"
                />
              ))}
            </div>
            <a
              class="action action-secondary"
              href={`/zh/contact/?project=${p.id}`}
            >
              咨询类似项目
            </a>
          </details>
        </article>
      ))}
    </div>
    <p class="ed-wrap case-source-note">
      安装工期不等同于整屋交付周期，具体范围以各项目说明与约定为准。
    </p>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>

<script>
  function openLinkedProject() {
    const project = document.getElementById(location.hash.slice(1));
    const details = project?.querySelector<HTMLDetailsElement>(".case-details");
    if (details) details.open = true;
  }

  openLinkedProject();
  window.addEventListener("hashchange", openLinkedProject);
</script>

<style>
  .cases-hero {
    margin-top: var(--gnb-h);
    padding-block: clamp(26px, 3.7vw, 58px) clamp(26px, 3vw, 48px);
    background: var(--paper-deep);
  }

  .cases-hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    align-items: end;
    gap: clamp(12px, 4vw, 60px);
    margin-bottom: clamp(20px, 3vw, 42px);
  }

  .cases-hero-gallery {
    width: min(100% - 2 * var(--ed-gutter), 1680px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.75fr) minmax(0, 0.8fr);
    align-items: start;
    gap: clamp(10px, 1.4vw, 24px);
  }

  .cases-hero-gallery :global(.cases-hero-photo) {
    aspect-ratio: 1.2;
    height: auto;
  }

  .cases-hero-gallery :global(.cases-hero-main) {
    aspect-ratio: 1.65;
  }

  .cases-hero-gallery :global(.cases-hero-photo:last-child) {
    align-self: end;
  }

  .cases-hero-gallery :global(img) {
    display: block;
  }

  .cases-hero h1 {
    margin: 0;
    color: var(--charcoal);
    font-size: clamp(30px, 4vw, 60px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .cases-hero h1 span {
    display: inline-block;
  }

  .cases-hero p {
    margin: 0;
    color: var(--ink-body);
    font-size: 16px;
    line-height: 1.65;
  }

  .cases-controls {
    padding-block: clamp(14px, 2vw, 28px);
  }

  .cases-controls .case-filter {
    margin: 0;
  }

  .cases-list {
    align-items: start;
    row-gap: clamp(32px, 4vw, 64px);
  }

  .cases-list .case-project {
    scroll-margin-top: calc(var(--gnb-h) + 16px);
  }

  .cases-list .case-project-head {
    margin: 15px 0 10px;
  }

  .cases-list .case-project-head h2 {
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.35;
  }

  .cases-list .case-project-head .eyebrow {
    margin-bottom: 5px;
  }

  .case-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 16px;
    padding-block: 8px;
    border-top: 1px solid var(--hairline);
    color: var(--charcoal);
    cursor: pointer;
    list-style: none;
  }

  .case-details summary::-webkit-details-marker {
    display: none;
  }

  .case-details-icon {
    position: relative;
    flex: 0 0 16px;
    height: 16px;
  }

  .case-details-icon::before,
  .case-details-icon::after {
    content: "";
    position: absolute;
    inset: 7px 1px auto;
    border-top: 1px solid currentColor;
  }

  .case-details-icon::after {
    transform: rotate(90deg);
  }

  .case-details[open] .case-details-icon::after {
    display: none;
  }

  @media (max-width: 767px) {
    .cases-hero-copy {
      grid-template-columns: minmax(0, 1fr);
    }

    .cases-hero-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cases-hero-gallery :global(.cases-hero-main) {
      grid-area: 1 / 1 / 2 / -1;
    }

    .cases-hero-gallery :global(.cases-hero-photo:not(.cases-hero-main)) {
      aspect-ratio: 1.55;
    }
  }
</style>
