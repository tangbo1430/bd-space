---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import GalleryImage from "../../components/GalleryImage.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import projects from "../../data/projects.json";
const english = Astro.url.pathname.startsWith("/en/");

const filters = [
  { id: "all", name: "全部项目" },
  { id: "domestic", name: "中国项目" },
  { id: "overseas", name: "海外项目" },
];
---

<BaseLayout
  title="工程案例"
  description="半打空间项目与团队历年实践：10个国内外建筑案例，展示项目地点、年份、面积、建造方式与现场记录。"
  current="cases"
  headerStyle="solid"
>
  <div class="page-editorial">
    <section class="cases-hero" aria-labelledby="cases-title">
      <EditorialImage
        base="nov-cases"
        alt={english ? "Residential buildings at dusk" : "暮色中的住宅建筑群"}
        class="cases-hero-photo"
        eager
        sizes="100vw"
      />
      <div class="cases-hero-copy ed-wrap">
        <h1 id="cases-title">
          {english ? "Spaces, across the world." : "空间，在世界发生。"}
        </h1>
        <p>
          2026年的半打项目，
          <br />
          与2016—2024年的团队历年实践。
          <br />
          记录从工厂到现场的探索。
        </p>
      </div>
    </section>
    <div class="cases-controls ed-wrap">
      <div class="case-filter" role="group" aria-label="按项目地区筛选">
        {filters.map((f) => (
          <button
            type="button"
            class:list={{ active: f.id === "all" }}
            data-case-filter={f.id}
            aria-pressed={f.id === "all"}
          >
            {f.name}
            <span class="filter-count">
              {String(
                projects.filter((p) => f.id === "all" || p.region === f.id)
                  .length,
              ).padStart(2, "0")}
            </span>
          </button>
        ))}
      </div>
      <p class="sr-only" data-filter-status role="status">
        显示 {projects.length} 个项目
      </p>
    </div>
    <div class="case-grid cases-list ed-wrap">
      {projects.map((p, i) => (
        <article class="case-project" id={p.id} data-case-region={p.region}>
          <div class="project-lead">
            <GalleryImage
              fit="contain"
              base={p.base}
              alt={`${p.name} · 项目外观`}
              group={p.id}
              caption={`${p.name} / ${p.year} / ${p.era}`}
              eager={i < 2}
              sizes="(max-width: 767px) 92vw, 44vw"
            />
          </div>
          <div class="case-project-head">
            <span class="eyebrow">
              {p.era} · {p.year}
            </span>
            <h2>{p.name}</h2>
            <p class="project-location">{p.location}</p>
          </div>
          <details class="case-details">
            <summary>
              <span>{english ? "Project details" : "查看项目详情"}</span>
              <span aria-hidden="true" class="case-details-icon"></span>
            </summary>
            <dl class="project-facts">
              <div>
                <dt>项目面积</dt>
                <dd>{p.area}</dd>
              </div>
              <div>
                <dt>工期</dt>
                <dd>{p.duration}</dd>
              </div>
              <div>
                <dt>完工状态</dt>
                <dd>{p.status}</dd>
              </div>
              <div>
                <dt>建造方式</dt>
                <dd>{p.method}</dd>
              </div>
            </dl>
            <p class="project-description">
              <span class="eyebrow">交付范围</span>
              <br />
              {p.scope}
            </p>
            <div class="project-photos" aria-label={`${p.name}的现场照片`}>
              {p.gallery.map((photo) => (
                <GalleryImage
                  fit="contain"
                  base={photo.base}
                  alt={photo.caption}
                  group={p.id}
                  sizes="(max-width: 767px) 25vw, 12vw"
                />
              ))}
            </div>
            <a
              class="action action-secondary"
              href={`/zh/contact/?project=${p.id}`}
            >
              咨询类似项目
            </a>
          </details>
        </article>
      ))}
    </div>
    <p class="ed-wrap case-source-note">
      安装工期不等同于整屋交付周期，具体范围以各项目说明与约定为准。
    </p>
    <ProjectCTA />
    <PhotoViewer />
  </div>
</BaseLayout>

<script>
  function openLinkedProject() {
    const project = document.getElementById(location.hash.slice(1));
    const details = project?.querySelector<HTMLDetailsElement>(".case-details");
    if (details) details.open = true;
  }

  openLinkedProject();
  window.addEventListener("hashchange", openLinkedProject);
</script>

<style>
  .cases-hero {
    display: grid;
    align-items: end;
    position: relative;
    isolation: isolate;
    min-height: clamp(285px, 40.6vw, 820px);
    margin-top: var(--gnb-h);
    color: #fff;
    background: var(--charcoal);
  }

  .cases-hero :global(.cases-hero-photo) {
    position: absolute;
    inset: 0;
    height: 100%;
    z-index: -2;
  }

  .cases-hero :global(img) {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cases-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(10 19 19 / 84%) 0%,
      rgb(10 19 19 / 34%) 38%,
      transparent 68%
    );
  }

  .cases-hero-copy {
    padding-block: 28px clamp(30px, 4vw, 62px);
  }

  .cases-hero h1 {
    margin: 0;
    color: inherit;
    font-size: clamp(30px, 4.1vw, 60px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .cases-hero p {
    margin: 12px 0 0;
    color: inherit;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.65;
  }

  .cases-controls {
    padding-block: clamp(14px, 2vw, 28px);
  }

  .cases-controls .case-filter {
    margin: 0;
  }

  .cases-list {
    align-items: start;
    row-gap: clamp(32px, 4vw, 64px);
  }

  .cases-list .case-project {
    scroll-margin-top: calc(var(--gnb-h) + 16px);
  }

  .cases-list .case-project-head {
    margin: 15px 0 10px;
  }

  .cases-list .case-project-head h2 {
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.35;
  }

  .cases-list .case-project-head .eyebrow {
    margin-bottom: 5px;
  }

  .case-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 16px;
    padding: 10px 14px;
    border-top: 1px solid var(--vp-border, var(--hairline));
    border-radius: 2px;
    background: var(--vp-card, #f9f8f5);
    color: var(--charcoal);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition:
      background-color 200ms var(--vp-ease, ease),
      color 200ms var(--vp-ease, ease);
  }

  .case-details summary:hover {
    background: var(--vp-stone, #f4f3ef);
    color: var(--vp-accent, #007963);
  }

  .case-details summary::-webkit-details-marker {
    display: none;
  }

  .case-details-icon {
    position: relative;
    flex: 0 0 16px;
    height: 16px;
  }

  .case-details-icon::before,
  .case-details-icon::after {
    content: "";
    position: absolute;
    inset: 7px 1px auto;
    border-top: 1.5px solid currentColor;
    transition:
      transform 220ms var(--vp-ease, ease),
      opacity 220ms var(--vp-ease, ease);
  }

  .case-details-icon::after {
    transform: rotate(90deg);
  }

  .case-details[open] .case-details-icon::after {
    transform: rotate(0deg);
    opacity: 0;
  }

  @media (max-width: 767px) {
    .cases-hero {
      display: block;
      min-height: 0;
      background: #fff;
      color: var(--charcoal);
      border-bottom: 1px solid var(--vp-border, var(--hairline));
    }
    .cases-hero::before {
      display: none;
    }
    .cases-hero :global(.cases-hero-photo) {
      position: relative;
      inset: auto;
      z-index: auto;
      width: 100%;
      height: auto;
    }
    .cases-hero :global(img) {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .cases-hero-copy {
      padding-block: 24px 24px;
    }
    .cases-hero h1 {
      color: var(--charcoal);
      font-size: clamp(28px, 7.6vw, 34px);
    }
    .cases-hero p {
      max-width: 31em;
      margin-top: 10px;
      color: var(--vp-body, #46504b);
      font-size: 15px;
    }
    .cases-hero p br {
      display: none;
    }
  }
</style>
