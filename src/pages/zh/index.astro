        <p class="note" style="margin-top:18px">电话：{site.contact.phone} · 邮箱：{site.contact.email}<br />地址：{site.contact.address}</p>
      </div>
      <div class="figx rv cta-figx">
        <picture>
          <source type="image/webp" srcset="/assets/img/product-4s-dusk-m.webp 960w, /assets/img/product-4s-dusk.webp 1920w" sizes="(max-width: 1279px) 100vw, 1216px" />
          <img src="/assets/img/product-4s-dusk.jpg" width="1920" height="1080" alt="半打空间模块化建筑黄昏外观" loading="lazy" decoding="async" onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()" />
