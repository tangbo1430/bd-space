---
import WallIntroduction from "../../components/WallIntroduction.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
const { wallPreview = false } = Astro.props;
import HeroCarousel from "../../components/HeroCarousel.astro";
import { imageDimensions } from "../../lib/image-dimensions";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import SystemsTriptych from "../../components/SystemsTriptych.astro";
import projects from "../../data/projects.json";
import { company } from "../../data/company";
import { getListedProducts } from "../../lib/catalog";

const selectedProjects = [
  "cayman",
  "changzhou",
  "zhongshan-mige",
  "brisbane",
].map((id) => projects.find((p) => p.id === id)!);
const slides = [
  {
    id: "4s",
    name: "半打 4S",
    note: "自然之中，安放日常。",
    desktopImage: "/assets/img/r78-home-4s.webp",
    headerTone: "light" as const,
    brandTone: "light" as const,
  },
  {
    id: "5s",
    name: "半打 5S",
    note: "为相聚，留出更多空间。",
    desktopImage: "/assets/img/r66-layered-5s.webp",
    headerTone: "dark" as const,
    brandTone: "dark" as const,
    coverBrandTone: "dark" as const,
    copyTop: "46%",
    copyLayout: "low" as const,
    copyInk: "photo" as const,
  },
  {
    id: "6s",
    name: "半打 6S",
    note: "把生活，展开得更从容。",
    desktopImage: "/assets/img/r67-original-6s.webp",
    headerTone: "dark" as const,
    coverHeaderTone: "dark" as const,
    coverBrandTone: "dark" as const,
    coverCopyTone: "dark" as const,
    coverCopyLayout: "sky" as const,
    coverCopyTop: "max(96px, 7vw)",
  },
  {
    id: "grayscale",
    name: "灰度空间",
    note: "简洁的表达，自在的空间。",
    desktopImage: "/assets/img/r78-home-grayscale.webp",
    headerTone: "dark" as const,
    copyTone: "dark" as const,
    copyLayout: "sky" as const,
    copyInk: "photo" as const,
    copyTop: "max(72px, 5.2vw)",
  },
  {
    id: "grayscale-eco",
    name: "灰度空间经济款",
    note: "更轻的配置，完整的日常。",
    desktopImage: "/assets/img/r66-layered-grayscale-eco.webp",
    headerTone: "dark" as const,
    coverBrandTone: "dark" as const,
  },
].map((s) => ({
  ...s,
  base: ["4s", "grayscale"].includes(s.id)
    ? `r78-home-${s.id}`
    : `r4-banner-${s.id}`,
  mobileImage: ["4s", "grayscale"].includes(s.id)
    ? `/assets/img/r78-home-${s.id}-m.webp`
    : `/assets/img/r4-banner-${s.id}-m.webp`,
}));
const products = (await getListedProducts()).filter((p) => p.featured);
const english = Astro.url.pathname.startsWith("/en/");
const steps = [
  {
    title: "设计，把想法落到细节",
    text: "从场地与使用需求出发，梳理空间、结构与模块之间的关系。",
    base: "r78-design",
    caption: "半打产品是以混凝土墙体、功能模块的方式组合成一个房屋产品。",
    alt: "半打墙构造示意",
    mobile: true,
  },
  {
    title: "制造，让空间在工厂成形",
    text: "混凝土构件与空间模块在产线上制作，让建造过程有序展开。",
    base: "v11-factory",
    caption: "工厂产线上的混凝土构件",
    alt: "工厂产线上的混凝土构件",
    mobile: false,
  },
  {
    title: "交付，让建筑抵达生活",
    text: "通过运输、吊装与现场拼装，让完成的模块成为可以使用的空间。",
    base: "flow-step06-crane-panel",
    caption: "现场吊装与拼装墙板",
    alt: "现场吊装与拼装墙板",
    mobile: true,
  },
];
---

<BaseLayout
  noindex={wallPreview}
  title="让空间，回归生活"
  description="半打空间，装配式混凝土空间的设计与制造者。探索模块化住宅、真实项目与从工厂到现场的建造过程。"
  current="home"
  headerStyle="overlay"
  headerTone={slides[0].headerTone}
>
  <div class="h40">
    <HeroCarousel slides={slides}>
      <div class="h-hero-copy">
        <h1 class="h-title">
          <span>{english ? "Where Space" : "让空间，"}</span>
          {english && " "}
          <span>{english ? "Meets Life." : "回归生活。"}</span>
        </h1>
        <p class="h-hero-sub">在工厂建造，为生活而生</p>
      </div>
      <a slot="action" class="action action-primary" href="/zh/products/">
        探索产品
      </a>
    </HeroCarousel>
    {wallPreview && <WallIntroduction />}

    {/* A continuous photographic collection; product facts remain in the catalog. */}
    <section
      id="selected-spaces"
      class="h-sec h-products"
      aria-labelledby="products-heading"
    >
      <h2 id="products-heading" class="sr-only">
        {english ? "A Place for Everyday Life." : "为日常，找到一处空间。"}
      </h2>
      <div class="h-tiles">
        {products.map((p, index) => (
          <article class="h-tile rv">
            <div class="h-tile-copy">
              <h3>
                <a href={`/zh/products/${p.id}/`}>{p.name}</a>
              </h3>
              <p class="h-tile-desc">
                {index === 0 ? (
                  <>
                    <span>
                      {english ? "Simple in expression." : "简洁的表达，"}
                    </span>
                    {english && " "}
                    <span>{english ? "Open to life." : "自在的空间。"}</span>
                  </>
                ) : (
                  p.desc
                )}
              </p>
              <div class="h-tile-links">
                <a
                  class:list={[
                    "action",
                    index === 0 ? "action-primary" : "action-secondary",
                  ]}
                  href={`/zh/products/${p.id}/`}
                >
                  查看产品详情
                </a>
              </div>
            </div>
            <a
              class="h-tile-img"
              href={`/zh/products/${p.id}/`}
              tabindex="-1"
              aria-hidden="true"
            >
              <EditorialImage
                fit="contain"
                base={p.id === "4s" ? "r78-home-4s" : p.main}
                alt=""
                sizes={
                  p.id === "grayscale"
                    ? "100vw"
                    : "(max-width: 767px) 100vw, 50vw"
                }
              />
            </a>
          </article>
        ))}
      </div>
      <div class="h-collection-footer">
        <a class="h-collection-link" href="/zh/products/#collection">
          探索全部七款
        </a>
      </div>
    </section>

    {/* 建造体系：三种方式并列，一目了然 */}
    <SystemsTriptych
      heading={english ? "Ways to build" : "建造方式"}
      subheading={
        english
          ? "Three ways to build, for possibilities around the world."
          : "用三种建造方式，接住全球市场的所有可能"
      }
      images={{ panels: "r78-system-panels", hybrid: "r78-system-hybrid" }}
      note={company.intro}
      aboutLink
    />

    {/* 项目实践：2×2 对齐 */}
    <section class="h-sec h-cases" aria-labelledby="cases-heading">
      <div class="h-wrap">
        <header class="h-center-head rv">
          <h2 id="cases-heading">走向不同的风景</h2>
          <p>从想象到现场，让空间成为真实的日常</p>
        </header>
        <div class="selected-cases h-cases-grid">
          {selectedProjects.map((p) => (
            <a class="case-card rv" href={`/zh/cases/#${p.id}`}>
              <div class="case-image">
                <EditorialImage
                  fit="contain"
                  base={p.base}
                  alt={p.name}
                  sizes="(max-width: 767px) 100vw, 46vw"
                />
              </div>
              <div class="case-caption">
                <h3>{p.name}</h3>
                <span>
                  {p.year} · {p.location}
                </span>
              </div>
            </a>
          ))}
        </div>
        <div class="h-center-more rv">
          <a class="h-more" href="/zh/cases/">
            查看全部项目 <Icon name="chevron-right" />
          </a>
        </div>
      </div>
    </section>

    {/* 设计 · 制造 · 交付：三步并列 */}
    <section class="h-sec h-making" aria-labelledby="making-heading">
      <div class="h-wrap">
        <header class="h-center-head rv">
          <h2 id="making-heading">把建造，做成制造</h2>
          <p>让复杂的建造过程，在有序的工序中展开。</p>
        </header>
        <ol class="h-steps" style={`--step-columns:${steps.map(s => { const [w,h] = imageDimensions(`/assets/img/${s.base}.jpg`); return `minmax(0,${w/h}fr)`; }).join(" ")}`}>
          {steps.map((s, i) => (
            <li class="h-step rv">
              <div class="h-step-img">
                <EditorialImage
                  fit={i === 0 ? "contain" : "cover"}
                  base={s.base}
                  alt={s.alt}
                  mobile={s.mobile}
                  sizes="(max-width: 767px) 100vw, 33vw"
                />
              </div>
              <span class="h-step-no">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <p class="h-step-caption">{s.caption}</p>
            </li>
          ))}
        </ol>
        <div class="h-center-more rv">
          <a class="h-more" href="/zh/about/">
            走进半打空间 <Icon name="chevron-right" />
          </a>
        </div>
      </div>
    </section>
    <ProjectCTA />
    {wallPreview && <PhotoViewer />}
  </div>
</BaseLayout>

<script>
  import "../../scripts/home.ts";
</script>
