---
import HeroCarousel from "../../components/HeroCarousel.astro";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import BuildingSystems from "../../components/BuildingSystems.astro";
import projects from "../../data/projects.json";
import { company } from "../../data/company";
const selectedProjects = ["cayman", "changzhou"].map((id) =>
  projects.find((p) => p.id === id)!,
);
const slides = [
  {
    id: "6s",
    base: "v11-home-6s",
    name: "半打 6S",
    note: "把生活，展开得更从容。",
  },
  {
    id: "4s",
    base: "v11-home-4s",
    name: "半打 4S",
    note: "自然之中，安放日常。",
  },
  {
    id: "5s",
    base: "v11-home-5s",
    name: "半打 5S",
    note: "为相聚，留出更多空间。",
  },
];
import { getListedProducts } from "../../lib/catalog";
const products = (await getListedProducts())
  .filter((p) => p.featured)
  .map((p) => ({
    ...p,
    desc: `${p.desc} ${p.area} · ${p.layout}`,
  }));
const steps = [
  {
    title: "设计，把想法落到细节",
    en: "DESIGN",
    text: "从场地与使用需求出发，梳理空间、结构与模块之间的关系。",
    base: "v11-factory",
    mobile: false,
  },
  {
    title: "制造，让空间在工厂成形",
    en: "MANUFACTURE",
    text: "混凝土构件与空间模块在产线上制作，让建造过程有序展开。",
    base: "flow-factory-module",
    mobile: true,
  },
  {
    title: "交付，让建筑抵达生活",
    en: "DELIVER",
    text: "通过运输、吊装与现场拼装，让完成的模块成为可以使用的空间。",
    base: "flow-step06-crane-panel",
    mobile: true,
  },
];
---

<BaseLayout
  title="让空间，回归生活"
  description="半打空间，装配式混凝土空间的设计与制造者。探索模块化住宅、真实项目与从工厂到现场的建造过程。"
  current="home"
  headerStyle="overlay"
>
  <div class="studio">
    <HeroCarousel slides={slides}>
      <span class="eyebrow">装配式混凝土空间</span>
      <h1>
        让空间，
        <br />
        回归生活。
      </h1>
      <p>
        在工厂建造，为生活而生。
        <br />
        连接设计、制造与交付，让建筑融入日常。
      </p>
      <div class="cover-actions">
        <a class="action action-primary" href="/zh/products/">
          探索产品
        </a>
        <a class="action action-secondary" href="/zh/contact/">
          项目咨询
        </a>
      </div>
    </HeroCarousel>

    <section
      class="product-section ed-section"
      aria-labelledby="products-heading"
    >
      <div class="ed-wrap">
        <div class="section-label rv">
          <span>空间产品</span>
          <a href="/zh/products/">全部产品</a>
        </div>
        <div class="section-heading rv">
          <h2 id="products-heading">
            一个模块。
            <br />
            更多可能。
          </h2>
          <p>
            一组空间产品，
            <br />
            回应不同的生活想象。
          </p>
        </div>
        <div class="collection-grid" data-collection>
          <div class="collection-stage rv">
            {products.map((p, i) => (
              <div
                class:list={["collection-frame", { active: i === 0 }]}
                data-collection-image={p.id}
                aria-hidden={i !== 0}
              >
                <EditorialImage
                  base={p.base}
                  alt={p.imageCaption}
                  sizes="(max-width: 767px) 100vw, 65vw"
                />
              </div>
            ))}
          </div>
          <div class="collection-list rv">
            <div
              class="collection-tabs"
              role="tablist"
              aria-label="选择空间产品"
            >
              {products.map((p, i) => (
                <button
                  type="button"
                  class:list={["collection-tab", { active: i === 0 }]}
                  role="tab"
                  id={`tab-${p.id}`}
                  aria-selected={i === 0}
                  aria-controls="collection-info"
                  tabindex={i === 0 ? 0 : -1}
                  data-product-tab={p.id}
                >
                  <span>{p.name}</span>
                  <span class="selection-mark" aria-hidden="true"></span>
                </button>
              ))}
            </div>
            <div
              id="collection-info"
              class="collection-info"
              role="tabpanel"
              aria-labelledby="tab-4s"
              tabindex="0"
            >
              <p data-product-description>{products[0].desc}</p>
              <a
                class="text-link action action-secondary"
                data-product-link
                href="/zh/products/4s/"
              >
                探索产品
              </a>
            </div>
            <script
              type="application/json"
              data-products-json
              set:html={JSON.stringify(
                products.map(({ id, desc }) => ({ id, desc })),
              )}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="home-company ed-wrap" aria-label="关于半打空间">
      <span class="eyebrow">设计与制造，在同一个系统里。</span>
      <div>
        <p>{company.intro}</p>
        <a class="action action-secondary" href="/zh/about/">
          认识半打空间
        </a>
      </div>
    </section>

    <section
      class="systems-section ed-section"
      aria-labelledby="systems-heading"
    >
      <div class="ed-wrap">
        <div class="section-heading rv">
          <div>
            <span class="eyebrow">建造体系</span>
            <h2 id="systems-heading">
              构件有序，
              <br />
              空间自由。
            </h2>
          </div>
          <p>
            从一块混凝土，到一种生活方式。
            <br />
            以系统思考建筑，让设计在工厂中成形。
          </p>
        </div>
        <BuildingSystems />
      </div>
    </section>

    <section class="living-section" aria-labelledby="living-heading">
      <EditorialImage
        base="home-banner-60m-dining-02"
        alt="木色屋顶与暖白墙面的模块住宅餐厅"
        mobile={false}
      />
      <div class="living-copy ed-wrap">
        <h2 class="rv" id="living-heading">
          建筑有边界，
          <br />
          生活没有。
        </h2>
        <p class="rv">
          光、空气、相聚的时刻。
          <br />
          空间的意义，始终在生活里。
        </p>
        <a
          class="text-link light rv action action-secondary"
          href="/zh/products/4s/"
        >
          走进半打空间
        </a>
      </div>
    </section>

    <section
      class="cases-section ed-wrap ed-section"
      aria-labelledby="cases-heading"
    >
      <div class="section-label rv">
        <span>项目实践</span>
        <a href="/zh/cases/">所有项目</a>
      </div>
      <div class="section-heading rv">
        <h2 id="cases-heading">走向不同的风景。</h2>
        <p>
          从想象到现场，
          <br />
          让空间成为真实的日常。
        </p>
      </div>
      <div class="selected-cases">
        {selectedProjects.map((p, i) => (
          <a
            class:list={["case-card rv", { offset: i === 1 }]}
            href={`/zh/cases/#${p.id}`}
          >
            <div class="case-image">
              <EditorialImage
                base={p.base}
                alt={p.name}
                sizes="(max-width: 767px) 100vw, 56vw"
              />
            </div>
            <div class="case-caption">
              <h3>{p.name}</h3>
              <span>
                {p.era} · {p.year} / {p.location}
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="cases-tail rv">
        <a class="text-link action action-secondary" href="/zh/cases/">
          查看项目实践
        </a>
      </div>
    </section>

    <section class="making-section ed-section" aria-labelledby="making-heading">
      <div class="ed-wrap">
        <div class="section-label rv">
          <span>设计 · 制造 · 交付</span>
          <a href="/zh/about/">走进制造体系</a>
        </div>
        <div class="section-heading rv">
          <h2 id="making-heading">
            把建造，
            <br />
            做成制造。
          </h2>
          <p>
            让复杂的建造过程，
            <br />
            在有序的工序中展开。
          </p>
        </div>
        <div class="making-grid" data-making>
          <div class="making-steps rv">
            {steps.map((s, i) => (
              <div
                class:list={["making-step", { active: i === 0 }]}
                data-making-step
              >
                <button
                  type="button"
                  data-making-toggle
                  aria-expanded={i === 0}
                  aria-controls={`making-text-${i}`}
                >
                  <span class="step-number">0{i + 1}</span>
                  <span>
                    {s.title}
                    <small>{s.en}</small>
                  </span>
                  <span class="step-plus" aria-hidden="true">
                    <Icon name="plus" />
                  </span>
                </button>
                <div
                  id={`making-text-${i}`}
                  class="making-description"
                  hidden={i !== 0}
                >
                  <p>{s.text}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="making-stage rv">
            {steps.map((s, i) => (
              <div
                class:list={["making-frame", { active: i === 0 }]}
                data-making-image
                aria-hidden={i !== 0}
              >
                <EditorialImage
                  base={s.base}
                  alt={s.title}
                  mobile={s.mobile}
                  sizes="(max-width: 767px) 100vw, 50vw"
                />
                <span class="making-image-caption">
                  0{i + 1} / {s.en}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    <ProjectCTA />
  </div>
</BaseLayout>
