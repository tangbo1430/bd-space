---
/**
 * 首页 M1（SPEC-M0 / mock m1-home 七段叙事）：
 * S1 Hero 100vh 三帧轮播 → S2 品牌主张 92vh 全幅 → S3 产品体系（4:3 主图+事实簇+三卡）
 * → S4 代表案例（21:9 主图+双安静卡）→ S5 制造能力深绿三章图 → S6 资质信任细线表 → S7 咨询 CTA 。
 * 不回退：轮播七态状态机与键盘/圆点/箭头控件 / reveal / ?motion=full / reduced-motion /
 * 表单四态与校验 / 语言入口 / 事实占位规则 / 四视口零横向溢出。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatRail from '../../components/FloatRail.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import { site } from '../../lib/site';
import { HOME_HERO_ASSETS, CASE_COVER_ASSETS, PRODUCT_ASSETS, FLOW_FACTORY_ASSETS } from '../../lib/assets';

/* S3 事实簇：数字均待甲方确认，不虚构 */
const metrics = [
  { n: '【N】', label: '交付项目【待确认】' },
  { n: '【N】天', label: '平均现场工期【待确认】' },
  { n: '4+3', label: '空间产品与构件线' },
];

/* S3 产品卡（16:10；BD8/BD9 图位按资产映射继续占位说明，不硬撑低清图） */
const prodCards = [
  { href: '/zh/products/5s/', base: 'product-5s-hero', w: 1920, h: 1080, name: '半打5S', ds: '扩展型模块化居住单元 · 规格【待确认】', alt: '半打 5S 产品外观实景' },
  { href: '/zh/products/6s/', base: 'product-6s-hero', w: 1920, h: 1080, name: '半打6S', ds: '大尺度模块化居住产品 · 规格【待确认】', alt: '半打 6S 产品外观实景' },
  { href: '/zh/products/grayscale/', base: 'product-grayscale-hero', w: 1920, h: 1080, name: '灰度空间', ds: '模块化空间产品系列 · 规格【待确认】', alt: '灰度空间产品外观实景' },
];

/* S5 制造能力三环节 */
const steps = [
  { base: 'flow-step01-mold', w: 1504, h: 1128, alt: '设计与制模', t: '设计与制模', s: '按订单完成结构与模具设计，锁定尺寸与接口。', m: false },
  { base: 'flow-step03-panel-lift', w: 1080, h: 810, alt: '生产与出厂检验', t: '生产与检验', s: '浇筑养护在产线完成，逐件检验后出厂。【检验标准待确认】', m: false },
  { base: 'flow-step06-crane-panel', w: 1920, h: 1080, alt: '吊装与交付', t: '吊装与交付', s: '现场只做吊装与拼装，完成收口验收后交付。', m: true },
];

/* S6 资质信任：条目待提供，不预填 */
const trustRows = [
  { k: '企业资质', v: '【待提供】资质条目', s: '待甲方提供' },
  { k: '体系 / 产品认证', v: '【待提供】认证条目', s: '待甲方提供' },
  { k: '交付记录', v: '【N】个项目 · 【N】个国家与地区', s: '【待确认】' },
];
---

<BaseLayout
  title="首页"
  description="半打空间——装配式混凝土空间产品的研发、制造与交付。了解我们的工厂能力、产品中心、工程案例与资质。"
  current="home"
  headerStyle="overlay"
  master="v3"
>
  <FloatRail />

  <div class="m1">
    {/* S1 Hero：100vh 三帧淡切轮播（状态机/键盘/圆点/箭头行为不变，M1 控件布局） */}
    <section class="hero" data-carousel role="region" aria-roledescription="carousel" aria-label="首页横幅">
      <p class="sr-only" data-banner-live aria-live="polite" style="position:absolute;left:-9999px">第 1 张，共 3 张</p>
      <div class="slide on" data-slide aria-roledescription="slide" aria-label="第 1 张，共 3 张">
        <div class="ph ph-1">
          <picture class="ph-pic">
            <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero01.base}-m.webp`} />
            <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero01.base}.webp`} />
            <img
              src={`/assets/img/${HOME_HERO_ASSETS.hero01.base}.jpg`}
              width="1920" height="823"
              alt={HOME_HERO_ASSETS.hero01.alt}
              loading="eager" fetchpriority="high" decoding="async"
              onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <span class="tag">IMG-HERO-1 · 2560×1440 · 半打4S 黄昏正立面全景（占位标注仅在图片缺失时显示）</span>
        </div>
        <div class="hero-copy">
          <h1>装配式混凝土，<br />造可交付的空间</h1>
          <p class="sub">标准化产线制造，现场吊装交付——工期、质量与成本因此确定。【示例文案，待确认】</p>
          <div class="en2">Prefab concrete spaces, manufactured with certainty.</div>
          <div class="btns">
            <a class="btn btn-primary" href="#contact" data-track="consult_click" data-banner-cta>预约咨询 →</a>
            <a class="btn btn-line" href="/zh/products/">查看产品</a>
          </div>
        </div>
      </div>
      <div class="slide" data-slide aria-roledescription="slide" aria-label="第 2 张，共 3 张">
        <div class="ph ph-2">
          <picture class="ph-pic">
            <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero02.base}-m.webp`} />
            <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero02.base}.webp`} />
            <img
              src={`/assets/img/${HOME_HERO_ASSETS.hero02.base}.jpg`}
              width="1920" height="823"
              alt={HOME_HERO_ASSETS.hero02.alt}
              loading="lazy" decoding="async"
              onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <span class="tag">IMG-HERO-2 · 2560×1440 · 5S 日景正面（占位）</span>
        </div>
        <div class="hero-copy">
          <h1>从产线，到工地</h1>
          <p class="sub">标准化产线与严格品控，让每一个构件可追溯、可交付。【示例文案，待确认】</p>
          <div class="en2">From the production line to the site.</div>
          <div class="btns"><a class="btn btn-primary" href="/zh/about/">走进工厂 →</a></div>
        </div>
      </div>
      <div class="slide" data-slide aria-roledescription="slide" aria-label="第 3 张，共 3 张">
        <div class="ph ph-3">
          <picture class="ph-pic">
            <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero03.base}-m.webp`} />
            <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero03.base}.webp`} />
            <img
              src={`/assets/img/${HOME_HERO_ASSETS.hero03.base}.jpg`}
              width="1920" height="823"
              alt={HOME_HERO_ASSETS.hero03.alt}
              loading="lazy" decoding="async"
              onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <span class="tag">IMG-HERO-3 · 2560×1440 · 6S 黄昏外观（占位）</span>
        </div>
        <div class="hero-copy">
          <h1>空间，已被使用</h1>
          <p class="sub">服务多类工程场景的装配式解决方案。【示例文案，待确认】</p>
          <div class="en2">Spaces, already in use.</div>
          <div class="btns"><a class="btn btn-primary" href="/zh/cases/">查看案例 →</a></div>
        </div>
      </div>
      <button type="button" class="harr l" data-prev aria-label="上一张">←</button>
      <button type="button" class="harr r" data-next aria-label="下一张">→</button>
      <div class="hdots" role="group" aria-label="轮播指示器">
        <button class="on" data-dot aria-label="切换到第 1 张" aria-current="true"></button>
        <button data-dot aria-label="切换到第 2 张" aria-current="false"></button>
        <button data-dot aria-label="切换到第 3 张" aria-current="false"></button>
      </div>
      <div class="pause-line" aria-hidden="true"></div>
    </section>

    {/* S2 品牌主张：92vh 全幅制造场景（本页明暗交替第 2 章） */}
    <section class="chap2" aria-label="品牌主张">
      <div class="bg" aria-hidden="true">
        <picture>
          <source type="image/webp" srcset={`/assets/img/${FLOW_FACTORY_ASSETS.module.base}-m.webp ${FLOW_FACTORY_ASSETS.module.mw}w, /assets/img/${FLOW_FACTORY_ASSETS.module.base}.webp ${FLOW_FACTORY_ASSETS.module.w}w`} sizes="100vw" />
          <img
            src={`/assets/img/${FLOW_FACTORY_ASSETS.module.base}.jpg`}
            width={FLOW_FACTORY_ASSETS.module.w} height={FLOW_FACTORY_ASSETS.module.h}
            alt=""
            loading="lazy" decoding="async"
            onerror="this.closest('.chap2').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
      </div>
      <div class="wrap">
        <div class="t-h2 rv">把现场作业，<br />搬进工厂</div>
        <p class="t-body rv">模具、产线、质检与物流组成确定性的交付系统，房屋成为可复制的工业产品。【示例文案，待确认】</p>
        <a class="btn btn-line rv" href="/zh/about/">了解制造体系 →</a>
      </div>
    </section>

    {/* S3 产品体系：左 4:3 主图 + 右 H2/事实簇/双 CTA，下接三卡 */}
    <section class="lchap" aria-label="产品体系">
      <div class="wrap">
        <div class="split2m">
          <div class="figx r43x rv">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${PRODUCT_ASSETS.p4sDusk.base}-m.webp ${PRODUCT_ASSETS.p4sDusk.mw}w, /assets/img/${PRODUCT_ASSETS.p4sDusk.base}.webp ${PRODUCT_ASSETS.p4sDusk.w}w`} sizes="(max-width: 767px) 100vw, 55vw" />
              <img
                src={`/assets/img/${PRODUCT_ASSETS.p4sDusk.base}.jpg`}
                width={PRODUCT_ASSETS.p4sDusk.w} height={PRODUCT_ASSETS.p4sDusk.h}
                alt={PRODUCT_ASSETS.p4sDusk.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
          </div>
          <div>
            <div class="t-h2 rv">模块，即空间</div>
            <div class="t-ensub rv">Modular concrete space units</div>
            <p class="t-body rv" style="margin-top:18px">从 4S 到灰度空间，每个模块都是完整、可交付的居住单元——主体、管线与内饰在出厂前完成。【示例文案，待确认】</p>
            <div class="metrics rv">
              {metrics.map((m) => (
                <div class="m"><b>{m.n}</b><span>{m.label}</span></div>
              ))}
            </div>
            <div class="rv" style="margin-top:34px;display:flex;gap:14px;flex-wrap:wrap">
              <a class="btn btn-primary" href="#contact" data-track="consult_click">预约体验 →</a>
              <a class="btn btn-line-dark" href="/zh/products/">全部产品 →</a>
            </div>
          </div>
        </div>
      </div>
      <div class="wrap" style="margin-top:96px">
        <div class="shead2 rv">
          <div class="t-h2">产品体系</div>
          <a class="lk" href="/zh/products/">进入产品中心 →</a>
        </div>
        <div class="pgrid">
          {prodCards.map((c) => (
            <a class="pcard rv" href={c.href} aria-label={`查看${c.name}产品详情`}>
              <div class="figx">
                <picture>
                  <source type="image/webp" srcset={`/assets/img/${c.base}-m.webp 960w, /assets/img/${c.base}.webp ${c.w}w`} sizes="(max-width: 767px) 100vw, 33vw" />
                  <img
                    src={`/assets/img/${c.base}.jpg`}
                    width={c.w} height={c.h} alt={c.alt}
                    loading="lazy" decoding="async"
                    onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
                  />
                </picture>
              </div>
              <div class="bd"><div class="nm">{c.name}</div><div class="ds">{c.ds}</div></div>
            </a>
          ))}
        </div>
        <p class="t-cap rv" style="margin-top:20px">
          另有 <a href="/zh/products/bd8/" style="text-decoration:underline;text-underline-offset:3px">BD8</a> / <a href="/zh/products/bd9/" style="text-decoration:underline;text-underline-offset:3px">BD9</a> 装配式空间与<a href="/zh/products/slab/" style="text-decoration:underline;text-underline-offset:3px">预制构件</a>产品线，图片素材待甲方提供后补齐。
        </p>
      </div>
    </section>

    {/* S4 代表案例：21:9 开曼主图（图内注释）+ 常州/布里斯班双安静卡（案例详情占位至 M3，暂链列表页） */}
    <section class="lchap alt" aria-label="代表案例">
      <div class="wrap">
        <div class="shead2 rv">
          <div class="t-h2">被建造，也被使用</div>
          <a class="lk" href="/zh/cases/">查看全部案例 →</a>
        </div>
        <a class="pfeat r219x rv" href="/zh/cases/" aria-label="查看开曼群岛海外住宅案例">
          <div class="bg" aria-hidden="true">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${CASE_COVER_ASSETS.cayman.base}-m.webp ${CASE_COVER_ASSETS.cayman.mw}w, /assets/img/${CASE_COVER_ASSETS.cayman.base}.webp ${CASE_COVER_ASSETS.cayman.w}w`} sizes="(max-width: 1280px) 100vw, 1120px" />
              <img
                src={`/assets/img/${CASE_COVER_ASSETS.cayman.base}.jpg`}
                width={CASE_COVER_ASSETS.cayman.w} height={CASE_COVER_ASSETS.cayman.h}
                alt=""
                loading="lazy" decoding="async"
                onerror="this.closest('.pfeat').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
          </div>
          <div class="cap">
            <div>
              <div class="t">开曼群岛 · 海外住宅</div>
              <div class="s">二层模块住宅 · 吊装交付 · 【待确认】年份</div>
            </div>
            <span class="btn btn-line">查看项目 →</span>
          </div>
        </a>
        <div class="cgridx">
          <a class="ci rv" href="/zh/cases/" aria-label="查看常州 4S 住宅案例">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${CASE_COVER_ASSETS.changzhou.base}-m.webp ${CASE_COVER_ASSETS.changzhou.mw}w, /assets/img/${CASE_COVER_ASSETS.changzhou.base}.webp ${CASE_COVER_ASSETS.changzhou.w}w`} sizes="(max-width: 767px) 100vw, 60vw" />
              <img
                src={`/assets/img/${CASE_COVER_ASSETS.changzhou.base}.jpg`}
                width={CASE_COVER_ASSETS.changzhou.w} height={CASE_COVER_ASSETS.changzhou.h}
                alt={CASE_COVER_ASSETS.changzhou.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.ci').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="cap"><div class="t">中国 · 常州</div><div class="s">4S 独栋住宅</div></div>
          </a>
          <a class="ci rv" href="/zh/cases/" aria-label="查看布里斯班独栋民宅案例">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${CASE_COVER_ASSETS.brisbane.base}-m.webp ${CASE_COVER_ASSETS.brisbane.mw}w, /assets/img/${CASE_COVER_ASSETS.brisbane.base}.webp ${CASE_COVER_ASSETS.brisbane.w}w`} sizes="(max-width: 767px) 100vw, 40vw" />
              <img
                src={`/assets/img/${CASE_COVER_ASSETS.brisbane.base}.jpg`}
                width={CASE_COVER_ASSETS.brisbane.w} height={CASE_COVER_ASSETS.brisbane.h}
                alt={CASE_COVER_ASSETS.brisbane.alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.ci').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="cap"><div class="t">澳大利亚 · 布里斯班</div><div class="s">独栋民宅</div></div>
          </a>
        </div>
      </div>
    </section>

    {/* S5 制造能力：深绿章三环节过程图 */}
    <section class="dchap" aria-label="制造能力">
      <div class="wrap">
        <div class="shead2 rv">
          <div class="t-h2">制造能力</div>
          <a class="lk light" href="/zh/about/">了解工厂 →</a>
        </div>
        <p class="lead rv">从制模到交付，主要工序在产线上顺序完成；运输与吊装执行标准化流程。【示例文案，待确认】</p>
        <div class="pc3">
          {steps.map((s) => (
            <div class="rv">
              <div class="figx">
                <picture>
                  {s.m && <source type="image/webp" srcset={`/assets/img/${s.base}-m.webp 960w, /assets/img/${s.base}.webp ${s.w}w`} sizes="(max-width: 767px) 100vw, 33vw" />}
                  {!s.m && <source type="image/webp" srcset={`/assets/img/${s.base}.webp`} />}
                  <img
                    src={`/assets/img/${s.base}.jpg`}
                    width={s.w} height={s.h} alt={s.alt}
                    loading="lazy" decoding="async"
                    onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
                  />
                </picture>
              </div>
              <div class="pt">{s.t}</div>
              <div class="ps">{s.s}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* S6 资质信任：细线表 + 免责说明（不预填） */}
    <section class="lchap" aria-label="资质与信任">
      <div class="wrap">
        <div class="shead2 rv">
          <div class="t-h2">资质与信任</div>
          <a class="lk" href="/zh/qualifications/">全部资质 →</a>
        </div>
        <div class="trust rv">
          {trustRows.map((r) => (
            <div class="tr"><div class="tk">{r.k}</div><div class="tv">{r.v}</div><div class="ts">{r.s}</div></div>
          ))}
        </div>
        <p class="t-cap rv" style="margin-top:18px">资质、认证与交付数据由甲方确认后填入，不预填未经核实的内容。</p>
      </div>
    </section>

    {/* S7 咨询 CTA：混凝土底，左主张 + 联系细线表，右平铺表单（四态沿现有实现） */}
    <section class="conv2" id="contact" aria-label="预约咨询">
      <div class="wrap">
        <div class="cgrid2">
          <div>
            <div class="t-h2 rv">让我们谈谈<br />您的项目</div>
            <p class="t-body rv">留下您的需求，我们将在 1 个工作日内回复。【示例文案，待确认】</p>
            <div class="trust mini rv">
              <div class="tr"><div class="tk">电话</div><div class="tv">{site.contact.phone}</div></div>
              <div class="tr"><div class="tk">邮箱</div><div class="tv">{site.contact.email}</div></div>
              <div class="tr"><div class="tk">地址</div><div class="tv">{site.contact.address}</div></div>
            </div>
          </div>
          <div class="rv">
            <ConsultForm id="home" />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>