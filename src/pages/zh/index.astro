---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatRail from '../../components/FloatRail.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import FlowSteps from '../../components/FlowSteps.astro';
import { site, PLACEHOLDER } from '../../lib/site';
import { HOME_HERO_ASSETS, CASE_COVER_ASSETS, PRODUCT_ASSETS } from '../../lib/assets';
import PlaceholderCard from '../../components/PlaceholderCard.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
/* v2.0 产品矩阵：首行 3 大图卡（4S/5S 真图 + BD8 色卡），次行 BD9 色卡 + 5 文字卡 */
const pmSmall = products.filter((p) => !['4s', 'bd8', 'bd9', '5s'].includes(p.id)).slice(0, 5);

/* v2.0.1：S2 数据带已按用户意见整块移除（四项数据均为待提供占位，无有效信息且破坏首屏完整性）；
   真实经营数据到位后再以设计评审通过的版式补回。 */

/* v2.0 §4.7：资质行高压至 56px */
const quals = [
  { name: `${PLACEHOLDER}资质/认证名称 01`, no: 'CERT-NO.【待提供】' },
  { name: `${PLACEHOLDER}资质/认证名称 02`, no: 'CERT-NO.【待提供】' },
  { name: `${PLACEHOLDER}体系认证 03`, no: 'CERT-NO.【待提供】' },
  { name: `${PLACEHOLDER}专利/荣誉 04`, no: 'NO.【待提供】' },
];
---

<BaseLayout
  title="首页"
  description="半打空间——装配式混凝土空间产品的研发、制造与交付。了解我们的工厂能力、产品中心、工程案例与资质。"
  current="home"
  headerStyle="overlay"
>
  <FloatRail />

  <!-- S1 首屏 Hero：沉浸式三帧轮播（v1.8：min(92vh,880px)/88vh/72vh/78vh，七态状态机） -->
  <section class="hero" data-carousel role="region" aria-roledescription="carousel" aria-label="首页横幅">
    <p class="sr-only" data-banner-live aria-live="polite" style="position:absolute;left:-9999px">第 1 张，共 3 张</p>
    <div class="slide on" data-slide aria-roledescription="slide" aria-label="第 1 张，共 3 张">
      {/* v1.7 RAR Banner 1：4S 黄昏全景；桌面 21:9 / 移动档 960w，WebP 优先 + JPG 回退；失败回退线稿占位 */}
      <div class="ph ph-1">
        <picture class="ph-pic">
          <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero01.base}-m.webp`} />
          <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero01.base}.webp`} />
          <img
            src={`/assets/img/${HOME_HERO_ASSETS.hero01.base}.jpg`}
            width="1920" height="823"
            alt={HOME_HERO_ASSETS.hero01.alt}
            loading="eager" fetchpriority="high" decoding="async"
            onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
        <svg class="ph-art" width="900" height="520" viewBox="0 0 900 520" fill="none" style="opacity:.55" aria-hidden="true">
          <g stroke="rgba(255,255,255,.55)" stroke-width="1">
            <path d="M180 400 L450 300 L720 400 L450 500 Z" />
            <path d="M250 380 L450 305 L650 380 L650 250 L450 175 L250 250 Z" />
            <path d="M250 250 L450 325 L650 250" />
            <path d="M450 325 L450 175" />
            <path d="M330 275 L330 220 M570 275 L570 220" />
          </g>
          <g fill="#1FA87A">
            <circle cx="250" cy="250" r="3.5" /><circle cx="650" cy="250" r="3.5" />
            <circle cx="450" cy="175" r="3.5" /><circle cx="450" cy="325" r="3.5" />
          </g>
          <g fill="rgba(31,168,122,.18)">
            <circle cx="250" cy="250" r="12" /><circle cx="650" cy="250" r="12" />
            <circle cx="450" cy="175" r="12" /><circle cx="450" cy="325" r="12" />
          </g>
        </svg>
        <span class="tag">IMG-HERO-1 · 2560×1440 · 工厂全景（占位）</span>
      </div>
      <div class="hero-copy">
        <div class="en" style="color:rgba(255,255,255,.6)">Prefabricated Concrete Space</div>
        <h1>装配式混凝土<br />空间的制造者</h1>
        <p>以工业化方式建造空间——从构件到建筑，半打空间提供装配式混凝土产品的研发、制造与交付。【示例文案，待确认】</p>
        <div class="btns">
          <a class="btn btn-primary" href="#contact" data-track="consult_click" data-banner-cta>预约咨询 <span class="arr">→</span></a>
          <a class="btn btn-ghost on-dark" href="/zh/products/">了解产品 <span class="arr">→</span></a>
        </div>
      </div>
    </div>
    <div class="slide" data-slide aria-roledescription="slide" aria-label="第 2 张，共 3 张">
      {/* v1.7 RAR Banner 2：5S 日景正面；懒加载（非首帧） */}
      <div class="ph ph-2">
        <picture class="ph-pic">
          <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero02.base}-m.webp`} />
          <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero02.base}.webp`} />
          <img
            src={`/assets/img/${HOME_HERO_ASSETS.hero02.base}.jpg`}
            width="1920" height="823"
            alt={HOME_HERO_ASSETS.hero02.alt}
            loading="lazy" decoding="async"
            onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
        <span class="tag">IMG-HERO-2 · 2560×1440 · 构件堆场/吊装（占位）</span>
      </div>
      <div class="hero-copy">
        <div class="en" style="color:rgba(255,255,255,.6)">Factory Capacity</div>
        <h1>从产线，到工地</h1>
        <p>标准化产线与严格品控，让每一个构件可追溯、可交付。【示例文案，待确认】</p>
        <div class="btns"><a class="btn btn-primary" href="/zh/about/">走进工厂 <span class="arr">→</span></a></div>
      </div>
    </div>
    <div class="slide" data-slide aria-roledescription="slide" aria-label="第 3 张，共 3 张">
      <div class="ph ph-3">
        {/* v1.7 RAR Banner 3：6S 黄昏实景；懒加载（非首帧） */}
        <picture class="ph-pic">
          <source media="(max-width: 767px)" type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero03.base}-m.webp`} />
          <source type="image/webp" srcset={`/assets/img/${HOME_HERO_ASSETS.hero03.base}.webp`} />
          <img
            src={`/assets/img/${HOME_HERO_ASSETS.hero03.base}.jpg`}
            width="1920" height="823"
            alt={HOME_HERO_ASSETS.hero03.alt}
            loading="lazy" decoding="async"
            onerror="this.closest('.ph').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
        <svg class="ph-art" width="900" height="520" viewBox="0 0 900 520" fill="none" style="opacity:.55" aria-hidden="true">
          <g stroke="rgba(255,255,255,.55)" stroke-width="1">
            <path d="M180 400 L450 300 L720 400 L450 500 Z" />
            <path d="M250 380 L450 305 L650 380 L650 250 L450 175 L250 250 Z" />
            <path d="M250 250 L450 325 L650 250" />
            <path d="M450 325 L450 175" />
            <path d="M330 275 L330 220 M570 275 L570 220" />
          </g>
          <g fill="#1FA87A">
            <circle cx="250" cy="250" r="3.5" /><circle cx="650" cy="250" r="3.5" />
            <circle cx="450" cy="175" r="3.5" /><circle cx="450" cy="325" r="3.5" />
          </g>
        </svg>
        <span class="tag">IMG-HERO-3 · 建成项目（占位标注仅在图片缺失时显示）</span>
      </div>
      <div class="hero-copy">
        <div class="en" style="color:rgba(255,255,255,.6)">Projects</div>
        <h1>空间，已被使用</h1>
        <p>服务多类工程场景的装配式解决方案。【示例文案，待确认】</p>
        <div class="btns"><a class="btn btn-primary" href="/zh/cases/">查看案例 <span class="arr">→</span></a></div>
      </div>
    </div>
    <div class="hero-controls">
      <div class="bnav">
        <button type="button" data-prev aria-label="上一张">←</button>
      </div>
      <div class="dots" role="group" aria-label="轮播指示器">
        <button class="on" data-dot aria-label="切换到第 1 张" aria-current="true"></button>
        <button data-dot aria-label="切换到第 2 张" aria-current="false"></button>
        <button data-dot aria-label="切换到第 3 张" aria-current="false"></button>
      </div>
      <div class="bnav">
        <button type="button" data-next aria-label="下一张">→</button>
      </div>
    </div>
    <div class="pause-line" aria-hidden="true"></div>
    <div class="scroll-hint">SCROLL</div>
  </section>

  <!-- v2.0.1：Hero 轮播结束后直接进入暖米白内容区（S3 制造），无深色过渡带 -->

  <!-- S3 关于半打 v2.0.2：7:5 工厂大图 + 文字列（两列清爽并排，不叠压图片） -->
  <section class="sec sec-tight" aria-label="关于半打" data-v2="mfg">
    <div class="wrap">
      <div class="en rv">Manufacture</div>
      <div class="mfg" style="margin-top:24px">
        <div class="figx r-75 rv" style="--figx-focus:center">
          <picture>
            <source type="image/webp" srcset="/assets/img/factory-precast-units.webp" />
            <img
              src="/assets/img/factory-precast-units.jpg"
              width="1920" height="1440"
              alt="工厂预制混凝土单元构件养护现场，产线全景"
              loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
        </div>
        <div class="mfg-card rv">
          <div class="en">About Banda</div>
          <h2>把建造，<br />变成制造</h2>
          <p>半打空间专注于装配式混凝土空间产品。我们相信建筑可以像工业产品一样被设计、制造与交付——更短的工期、更稳定的品质、更少的现场不确定性。【示例文案，待确认】</p>
          <a class="btn btn-ghost" href="/zh/about/">走进半打 <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- S4 产品中心（深底叙事区 + 原创线稿分解） -->
  <section class="dark-sec" aria-label="产品中心">
    <div class="wrap">
      <div class="dark-grid">
        <div class="dark-copy rv">
          <div class="en on-dark">Products</div>
          <h2>模块，即空间</h2>
          <p>每一类构件都是空间的一个可组合单元。分解它们，你会看到半打对结构与工艺的理解。【示例文案，待确认】</p>
          <a class="btn btn-primary" href="/zh/products/">产品中心 <span class="arr">→</span></a>
        </div>
        <div class="rv">
          <svg viewBox="0 0 640 420" width="100%" fill="none" role="img" aria-label="预制构件分解示意（原创线稿占位）">
            <g stroke="#5a6660" stroke-width="1">
              <path d="M170 96 L320 50 L470 96 L320 142 Z" />
              <path d="M170 96 L170 108 L320 154 L320 142" />
              <path d="M470 96 L470 108 L320 154" />
              <path d="M196 176 L240 190 L240 300 L196 286 Z" />
              <path d="M444 176 L400 190 L400 300 L444 286 Z" />
              <path d="M262 200 L320 184 L378 200 L378 296 L320 312 L262 296 Z" />
              <path d="M262 200 L320 216 L378 200" />
              <path d="M320 216 L320 312" />
              <path d="M190 336 L320 296 L450 336 L320 376 Z" />
              <path d="M190 336 L190 348 L320 388 L320 376" />
              <path d="M450 336 L450 348 L320 388" />
              <g stroke-dasharray="3 5" stroke="#3a4540">
                <path d="M320 154 L320 184" /><path d="M240 240 L262 240" />
                <path d="M400 240 L378 240" /><path d="M320 312 L320 296" />
              </g>
            </g>
            <g fill="#1FA87A">
              <circle cx="320" cy="50" r="3" /><circle cx="196" cy="176" r="3" />
              <circle cx="444" cy="176" r="3" /><circle cx="320" cy="216" r="3" /><circle cx="320" cy="388" r="3" />
            </g>
            <g fill="rgba(31,168,122,.16)">
              <circle cx="320" cy="50" r="11" /><circle cx="196" cy="176" r="11" />
              <circle cx="444" cy="176" r="11" /><circle cx="320" cy="216" r="11" /><circle cx="320" cy="388" r="11" />
            </g>
            <text x="320" y="418" text-anchor="middle" fill="#5a6660" font-size="10" letter-spacing="3" font-family="Arial">ORIGINAL LINE-ART PLACEHOLDER · 预制构件分解示意（原创）</text>
          </svg>
        </div>
      </div>
      <div class="pm-big" data-v2="pm-big">
      {/* v2.0 首页大图密度：矩阵三真图/流程/制造主图桌面容器 ≤758px 宽，但源图 1920px——用桌面档保证清晰度 */}
        <a href="/zh/products/4s/" aria-label="查看半打4S 产品详情">
          <div class="figx r-43">
            <picture>
              <source type="image/webp" srcset={`/assets/img/${PRODUCT_ASSETS.p4sDusk.base}.webp`} />
              <img
                src={`/assets/img/${PRODUCT_ASSETS.p4sDusk.base}.jpg`}
                width={PRODUCT_ASSETS.p4sDusk.w} height={PRODUCT_ASSETS.p4sDusk.h}
                alt={PRODUCT_ASSETS.p4sDusk.alt} loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="figx-cap"><div class="t">半打4S</div><div class="s">模块化空间产品</div></div>
          </div>
        </a>
        <a href="/zh/products/5s/" aria-label="查看半打5S 产品详情">
          <div class="figx r-43">
            <picture>
              <source type="image/webp" srcset="/assets/img/product-5s-hero.webp" />
              <img
                src="/assets/img/product-5s-hero.jpg"
                width="1920" height="1080"
                alt="半打 5S 产品外观实景" loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="figx-cap"><div class="t">半打5S</div><div class="s">模块化空间产品</div></div>
          </div>
        </a>
        <a href="/zh/products/bd8/" aria-label="查看 BD8 装配式空间产品详情">
          <PlaceholderCard id="PH-BD8" />
        </a>
      </div>
      <div class="pm-mid">
        <a href="/zh/products/bd9/" aria-label="查看 BD9 装配式空间产品详情">
          <PlaceholderCard id="PH-BD9" />
        </a>
        <a href="/zh/products/6s/" aria-label="查看半打6S 产品详情">
          <div class="figx r-43">
            <picture>
              <source type="image/webp" srcset="/assets/img/product-6s-hero.webp" />
              <img
                src="/assets/img/product-6s-hero.jpg"
                width="1920" height="1080"
                alt="半打 6S 产品外观实景" loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="figx-cap"><div class="t">半打6S</div><div class="s">模块化空间产品</div></div>
          </div>
        </a>
        <a href="/zh/products/grayscale/" aria-label="查看灰度空间产品详情">
          <div class="figx r-43">
            <picture>
              <source type="image/webp" srcset="/assets/img/product-grayscale-hero.webp" />
              <img
                src="/assets/img/product-grayscale-hero.jpg"
                width="1920" height="1080"
                alt="灰度空间产品外观实景" loading="lazy" decoding="async"
                onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="figx-cap"><div class="t">灰度空间</div><div class="s">模块化空间产品</div></div>
          </div>
        </a>
      </div>
      <div class="pm-small">
        {pmSmall.map((p) => (
          <a href={`/zh/products/${p.id}/`}>
            {p.data.name}
            <span>{p.data.tagline.replace(/【待确认】/g, '')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- S5 工程案例 v2.0：21:9 通栏编辑大图 + 2×4:3 半宽卡（图注浮层含「查看案例」链） -->
  <section class="sec sec-tight" aria-label="工程案例">
    <div class="wrap">
      <div class="sec-head rv">
        <div><div class="en">Selected Projects</div><h2>被建造，也被使用</h2></div>
        <a class="link-more" href="/zh/cases/">查看全部案例 <span class="arr">→</span></a>
      </div>
      <a href="/zh/cases/" class="figx r-219 blt-lead rv" style="--figx-focus:center 35%;display:block" aria-label="查看开曼群岛案例">
        <picture>
          <source type="image/webp" srcset="/assets/img/case-cayman-install-roof.webp" />
          <img
            src="/assets/img/case-cayman-install-roof.jpg"
            width="1920" height="1440"
            alt="开曼群岛海外住宅项目二层吊装，屋顶工人作业"
            loading="lazy" decoding="async"
            onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
          />
        </picture>
        <div class="figx-cap"><div class="t">开曼群岛 · 海外住宅</div><div class="s">现场吊装纪实 → 查看案例</div></div>
      </a>
      <div class="blt-grid">
        <a href="/zh/cases/" class="figx r-43 rv" style="display:block" aria-label="查看常州案例">
          <picture>
            <source type="image/webp" srcset={`/assets/img/${CASE_COVER_ASSETS.changzhou.base}.webp`} />
            <img
              src={`/assets/img/${CASE_COVER_ASSETS.changzhou.base}.jpg`}
              width={CASE_COVER_ASSETS.changzhou.w} height={CASE_COVER_ASSETS.changzhou.h}
              alt={CASE_COVER_ASSETS.changzhou.alt} loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">中国 · 常州</div><div class="s">4S 住宅</div></div>
        </a>
        <a href="/zh/cases/" class="figx r-43 rv" style="display:block" aria-label="查看布里斯班案例">
          <picture>
            <source type="image/webp" srcset={`/assets/img/${CASE_COVER_ASSETS.brisbane.base}.webp`} />
            <img
              src={`/assets/img/${CASE_COVER_ASSETS.brisbane.base}.jpg`}
              width={CASE_COVER_ASSETS.brisbane.w} height={CASE_COVER_ASSETS.brisbane.h}
              alt={CASE_COVER_ASSETS.brisbane.alt} loading="lazy" decoding="async"
              onerror="this.closest('.figx').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <div class="figx-cap"><div class="t">澳大利亚 · 布里斯班</div><div class="s">住宅</div></div>
        </a>
      </div>
    </div>
  </section>

  <!-- M3 从工厂到现场：六步交付流程（v1.6 DSN-162） -->
  <FlowSteps />

  <!-- S6 资质能力 v2.0（横排细线表，行高 56px 节奏压缩） -->
  <section class="sec" style="background:#fff;padding:56px 0" aria-label="资质能力" data-v2="quals">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="en">Qualifications</div><h2>资质与能力</h2></div>
        <a class="link-more" href="/zh/qualifications/">全部资质 <span class="arr">→</span></a>
      </div>
      <div class="quals">
        {quals.map((q) => (
          <div class="qual rv"><b>{q.name}</b><span>{q.no}</span><span class="arr" aria-hidden="true">→</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- S7 新闻资讯 v2.0：1440 横向三列带 PH-NEWS 色卡缩略图（色卡 3:2，占位条目） -->
  <section class="sec news-sec" style="padding:56px 0" aria-label="新闻资讯">
    <div class="wrap">
      <div class="sec-head rv"><div><div class="en">Newsroom</div><h2>新闻资讯</h2></div>
        <a class="link-more" href="/zh/news/">全部资讯 <span class="arr">→</span></a>
      </div>
      <div class="news-v2-grid" style="margin-top:56px">
        {['01', '02', '03'].map((no) => (
          <article class="news-v2-item rv">
            <PlaceholderCard id="PH-NEWS" ratio="3:2" label={`资讯配图 ${no}`} />
            <time style="display:block;font-size:12px;color:var(--ink-muted);font-family:var(--font-en);letter-spacing:.08em;margin-top:16px">{PLACEHOLDER}2025-00-00</time>
            <h3 style="font-weight:300;font-size:19px;margin-top:6px">{PLACEHOLDER}新闻标题占位：公司动态 / 项目签约 / 行业观察</h3>
            <p style="font-size:13px;color:var(--ink-muted);margin-top:6px;line-height:1.8">{PLACEHOLDER}摘要两行以内。此处为版式占位文案，不作为真实新闻内容。</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S8 底部 CTA v2.0.6：居中重设计——居中标题组 + 通栏 21:9 黄昏图 + 居中窄列表单 -->
  <section class="sec cta-sec cta-sec-v2" style="padding:96px 0" id="contact" aria-label="预约咨询">
