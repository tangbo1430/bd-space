---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import HeroCarousel from "../../../components/HeroCarousel.astro";
import { getListedProducts } from "../../../lib/catalog";
import ProductComparison from "../../../components/ProductComparison.astro";
import ProductIntroduction from "../../../components/ProductIntroduction.astro";
import { translate } from "../../../lib/translate";
const products = await getListedProducts();
const english = Astro.url.pathname.startsWith("/en/");
const local = (value: string) => (english ? translate(value) : value);
const photoNotes = ["暮色中的住宅", "夕阳与屋檐", "屋檐下的光", "天际与立面"];
const photoHeadings = english
  ? [
      "Prefabricated walls.\nStandardised beams.",
      "Evening light.",
      "The door opens.\nLife begins.",
      "A line drawn in the factory.\nA poem written in light.",
    ]
  : [
      "墙是预制的，\n梁是标准化的，",
      "住宅与夕照。",
      "一推一开之间，",
      "直线是工厂的尺，\n光线是生活的诗。",
    ];
const photoCopy = english
  ? [
      "But when the lights come on, it becomes home.\n— A real space. BD-4S, photographed.",
      "BD-4S · Photography",
      "Industrialisation ends, and living begins.\nThe evening sky falls behind you;\nlife welcomes you in.",
      "As the sunset follows the eaves,\na standardised roof takes on a human story.\n— BD-4S. Light beneath the eaves.",
    ]
  : [
      "但灯亮起的那一刻，它就是家。\n—— 真实的空间，半打 4S 实拍。",
      "半打 4S · 实拍",
      "工业化结束，生活开始。\n天地晚霞，都退到身后，\n只有生活，迎面走来。",
      "当夕照沿着屋檐落下，\n标准化的屋顶，便有了人的故事。\n—— 半打 4S，屋檐下的光影。",
    ];
const slides = photoNotes.map((note, i) => ({
  id: "4s",
  base: `r78-catalog-${i + 1}`,
  mobileImage: `/assets/img/r78-catalog-${i + 1}-m.webp`,
  desktopImage: `/assets/img/r78-catalog-${i + 1}.webp`,
  heading: photoHeadings[i],
  subtitle: photoCopy[i],
  name: "半打 4S 实拍",
  note,
  label: note,
  caption: `半打 4S · ${note} / 实拍`,
  controlsTone: i === 3 ? ("dark" as const) : ("light" as const),
  headerTone: "dark" as const,
  brandTone: i >= 2 ? ("light" as const) : ("dark" as const),
  copySide: i === 0 ? ("left" as const) : ("right" as const),
  copyTone: i === 0 ? ("light" as const) : ("dark" as const),
  copyTop: "31%",
}));
---

<BaseLayout
  title="产品中心"
  description={english ? "Explore ten Banda homes and compare layouts, floor areas, structures and shipping references." : "探索半打空间十款住宅产品，比较户型、面积、结构与装运参考。"}
  current="products"
  headerStyle="overlay"
  headerTone="dark"
>
  <div class="page-editorial h40">
    <HeroCarousel slides={slides} catalog>
      <div class="h-hero-copy">
        <h1 class="h-title">{photoHeadings[0]}</h1>
        <p class="h-hero-sub">{photoCopy[0]}</p>
      </div>
      <a slot="action" class="action action-primary" href="#collection">
        探索空间产品
      </a>
    </HeroCarousel>
    <ProductIntroduction />
    <section
      class="product-catalog-section"
      id="collection"
      aria-label="模块化空间产品"
    >
      <div class="catalog-heading">
        <h2>{english ? "Our Spaces" : "空间产品"}</h2>
        <nav class="catalog-index" aria-label="产品详情快捷入口">
          {products.map((p) => (
            <a href={`/zh/products/${p.id}/`}>{p.name}</a>
          ))}
        </nav>
        <a class="text-link action action-secondary" href="#product-comparison">
          比较型号
        </a>
      </div>
      <div class="collection-catalog">
        {products.map((p) => (
          <article
            class:list={[
              "catalog-feature",
              { "catalog-feature--compact": ["4s", "5s", "6s", "bd11", "qiyuan", "snow11"].includes(p.id) },
            ]}
            id={`model-${p.id}`}
            aria-labelledby={`title-${p.id}`}
            tabindex="-1"
          >
            <a
              class="catalog-feature-image"
              href={`/zh/products/${p.id}/`}
              aria-label={`探索${p.name}`}
            >
              <EditorialImage
                fit="contain"
                base={p.main}
                alt={p.imageCaption}
                sizes={
                  ["4s", "5s", "6s"].includes(p.id)
                    ? "(max-width: 1023px) 100vw, 33.33vw"
                    : "(max-width: 1023px) 100vw, 50vw"
                }
              />
            </a>
            <div class="catalog-feature-copy">
              <div class="catalog-feature-meta">
                <h3 id={`title-${p.id}`}>
                  <a href={`/zh/products/${p.id}/`}>{p.name}</a>
                </h3>
                <a
                  class="action action-secondary catalog-detail-link"
                  href={`/zh/products/${p.id}/`}
                  aria-label={`${p.name} · 查看产品详情`}
                >
                  {english ? "View details" : "产品详情"}
                </a>
              </div>
              <dl class="catalog-specs">
                {p.selectionFacts.slice(0, 2).map((fact) => (
                  <div>
                    <dt>{local(fact.label)}</dt>
                    <dd>{local(fact.value)}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>
    <ProductComparison products={products} />
  </div>
</BaseLayout>

<script>
  import "../../../scripts/home.ts";
  import "../../../scripts/product-selection.ts";
</script>
