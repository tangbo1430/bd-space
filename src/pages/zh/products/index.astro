---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);

const byId = (id: string) => products.find((p) => p.id === id);
const featured = byId('4s');
const approved = ['5s', '6s', 'grayscale'].map(byId).filter(Boolean);
const more = ['bd8', 'bd9', 'slab', 'wall', 'stair'].map(byId).filter(Boolean);

/* v3.0.1 索引行 64×44 小色片（无图产品线的降级色块，设计包 SPEC §3 批准） */
const CHIPS: Record<string, string> = {
  bd8: '#E8ECEF', bd9: '#F0EBE2', slab: '#F0E9E3', wall: '#F0EEE8', stair: '#EFE7E4',
};
const HERO_IMG: Record<string, { base: string; alt: string }> = {
  '5s': { base: 'product-5s-hero', alt: '半打 5S 产品外观实景' },
  '6s': { base: 'product-6s-hero', alt: '半打 6S 产品外观实景' },
  grayscale: { base: 'product-grayscale-hero', alt: '灰度空间产品外观实景' },
};

/* M5 三种建造体系（中性描述，v3 无缩略图卡） */
const systems = [
  { name: '2D 板式体系', desc: '板式构件工厂预制，现场组装成型。' },
  { name: '3D 模块体系', desc: '整体模块工厂完成，现场吊装就位。' },
  { name: '组合建造', desc: '板式与模块组合，灵活适配空间需求。' },
];
---

<BaseLayout
  title="产品中心"
  description="半打空间产品中心：半打 4S/5S/6S、灰度空间、BD8/BD9 装配式空间与预制构件产品线（名称与参数以客户确认为准）。"
  current="products"
  headerStyle="overlay"
  master="v3"
>
  {/* 首屏 56vh：4S 外观实拍通栏 */}
  <section class="v3hero h56" aria-label="产品中心首屏">
    <div class="ph3">
      <picture>
        <source media="(max-width: 767px)" type="image/webp" srcset="/assets/img/product-4s-hero-m.webp" />
        <source type="image/webp" srcset="/assets/img/product-4s-hero.webp" />
        <img
          src="/assets/img/product-4s-hero.jpg"
          width="1920" height="1080"
          alt="半打 4S 产品外观实景"
          loading="eager" decoding="async" fetchpriority="high"
          onerror="this.closest('.v3hero').classList.add('ph-fallback');this.closest('picture').remove()"
        />
      </picture>
    </div>
    <div class="wrap">
      <div class="en on-dark">Products</div>
      <h1>产品中心</h1>
    </div>
  </section>

  {/* 主打产品：左 8 列 7:5 大图 + 右 4 列文案 */}
  {featured && (
    <section class="chap chap-paper" aria-label={`主打产品 ${featured.data.name}`}>
      <div class="wrap split3">
        <div class="img8 r75 rv">
          <picture>
            <source type="image/webp" srcset="/assets/img/product-4s-dusk.webp" />
            <img
              src="/assets/img/product-4s-dusk.jpg"
              width="1920" height="1080"
              alt="半打 4S 产品黄昏正立面实景"
              loading="lazy" decoding="async"
              onerror="this.closest('.img8').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
        </div>
        <div class="tx4 rv">
          <div class="en">Featured · {featured.data.enTag}</div>
          <h2 class="v3h2">{featured.data.name}</h2>
          <p class="v3lead">{featured.data.tagline}主力户型，已验收实拍。</p>
          <div style="margin-top:36px"><a class="btn btn-primary" href={`/zh/products/${featured.id}/`}>查看详情 <span class="arr">→</span></a></div>
        </div>
      </div>
    </section>
  )}

  {/* 已验收实拍（ink 章三卡） */}
  <section class="chap chap-ink" aria-label="已验收实拍">
    <div class="wrap">
      <div class="shead rv">
        <div><div class="en on-dark">Approved Photos</div><h2 class="v3h2" style="margin-bottom:0">已验收实拍</h2></div>
      </div>
      <div class="prow p3">
        {approved.map((p) => p && (
          <a class="pcard r43 rv" href={`/zh/products/${p.id}/`} aria-label={`查看${p.data.name}产品详情`}>
            <picture>
              <source type="image/webp" srcset={`/assets/img/${HERO_IMG[p.id].base}.webp`} />
              <img
                src={`/assets/img/${HERO_IMG[p.id].base}.jpg`}
                width="1920" height="1080" alt={HERO_IMG[p.id].alt}
                loading="lazy" decoding="async"
                onerror="this.closest('.pcard').classList.add('ph-fallback');this.closest('picture').remove()"
              />
            </picture>
            <div class="cap"><div class="t">{p.data.name}</div><div class="s">模块化空间产品</div></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 更多产品线：发丝线索引行（编号+名称+一句话+色片+圆环箭头） */}
  <section class="chap chap-paper" aria-label="更多产品线">
    <div class="wrap">
      <div class="shead rv">
        <div><div class="en">More Lines</div><h2 class="v3h2" style="margin-bottom:0">更多产品线</h2></div>
      </div>
      <div class="idx">
        {more.map((p) => p && (
          <a class="rv" href={`/zh/products/${p.id}/`} aria-label={`查看${p.data.name}产品详情`}>
            <span class="no">{p.data.enTag}</span>
            <span class="nm">{p.data.name}<small>{p.data.tagline}图片素材待提供</small></span>
            <span class="chip" style={`background:${CHIPS[p.id]}`} aria-hidden="true"></span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="rv" style="margin-top:20px;font-size:13px;color:var(--v3-muted)">以上产品线图片素材待甲方提供；提供后按 4:3 卡片替换色卡位，布局不变。</p>
    </div>
  </section>

  {/* 三种建造体系（无图技术附录卡） */}
  <section class="chap chap-paper" style="padding-top:0" aria-label="三种建造体系">
    <div class="wrap">
      <div class="en rv">Build Systems</div>
      <h2 class="v3h2 rv">三种建造体系</h2>
      <div class="nrow" style="margin-top:40px">
        {systems.map((s) => (
          <div class="ncard rv">
            <div class="bd" style="padding:34px 30px">
              <h3 class="v3h3" style="font-size:20px">{s.name}</h3>
              <p style="font-size:13px;color:var(--v3-muted);line-height:1.8">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
