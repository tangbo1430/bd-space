---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import BuildingSystems from "../../../components/BuildingSystems.astro";
import PageVisual from "../../../components/PageVisual.astro";
import { getListedProducts } from "../../../lib/catalog";
const products = await getListedProducts();
---

<BaseLayout
  title="产品中心"
  description="探索半打4S、5S、6S与灰度空间，了解户型、面积、结构与装运参考。"
  current="products"
  headerStyle="overlay"
>
  <div class="page-editorial">
    <PageVisual
      mode="cover"
      base="product-4s-dusk"
      alt="暮色中的半打4S住宅"
      caption="半打 4S · 暮色中的居所"
      meta="空间产品"
    >
      <h1 slot="title">
        空间，有更多
        <br />
        打开方式。
      </h1>
      <p slot="description">
        从独立住宅到组合空间，
        <br />
        找到适合您项目的建造方式。
      </p>
      <a slot="actions" class="action action-primary" href="#collection">
        探索空间产品
      </a>
    </PageVisual>
    <section
      class="product-catalog-section ed-section"
      id="collection"
      aria-label="模块化空间产品"
    >
      <div class="catalog-intro ed-wrap rv">
        <span class="eyebrow">模块化空间系列</span>
        <h2>与生活，恰好相遇。</h2>
      </div>
      <div class="collection-catalog">
        {products.map((p) => (
          <article class="catalog-feature">
            <div class="catalog-feature-copy ed-wrap rv">
              <h2>{p.name}</h2>
              <p>{p.desc}</p>
              <p class="catalog-facts">
                {p.area} · {p.layout}
              </p>
              <div class="catalog-actions">
                <a class="action action-primary" href={`/zh/products/${p.id}/`}>
                  探索详情
                </a>
                <a
                  class="text-link action action-secondary"
                  href={`/zh/contact/?product=${p.id}`}
                >
                  咨询该产品
                </a>
              </div>
            </div>
            <a
              class="catalog-feature-image"
              href={`/zh/products/${p.id}/`}
              aria-label={`探索${p.name}`}
            >
              <EditorialImage base={p.base} alt={p.imageCaption} />
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="systems-section ed-section">
      <div class="ed-wrap">
        <div class="section-label rv">
          <span>02 / BUILDING SYSTEMS</span>
          <span>建造体系</span>
        </div>
        <div class="section-heading rv">
          <h2>以系统思考建筑。</h2>
          <p>
            构件、模块与组合，
            <br />
            组成空间的不同语法。
          </p>
        </div>
        <BuildingSystems />
      </div>
    </section>
    <ProjectCTA />
  </div>
</BaseLayout>
