---
/**
 * 产品中心 v3.2（SPEC-v3.2 §3.3）：
 * 页头 64vh → 交替 50/50 产品行 ×6（4S/5S/6S/灰度真图 4:3，BD8/BD9 马赛克占位）
 * → 预制构件产品线文字区（paper2，居中 CTA）。缺图只用规定占位，不虚构参数。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Mos from '../../../components/Mos.astro';

interface ProductRow {
  tag: string;
  name: string;
  desc: string;
  spec: string;
  href: string;
  img?: { base: string; alt: string; mw?: boolean };
  mos?: { id: string; use: string; min: string; subject: string };
}

const rows: ProductRow[] = [
  { tag: 'Banda 4S', name: '半打4S', desc: '紧凑型模块化居住单元，适合独栋住宅与度假场景。【示例文案，待确认】', spec: '建筑面积 / 户型：【待确认】', href: '/zh/products/4s/', img: { base: 'product-4s-dusk', alt: '半打4S 黄昏正立面', mw: true } },
  { tag: 'Banda 5S', name: '半打5S', desc: '在 4S 基础上扩展的居住单元，空间更完整。【示例文案，待确认】', spec: '建筑面积 / 户型：【待确认】', href: '/zh/products/5s/', img: { base: 'product-5s-hero', alt: '半打5S 日景外观', mw: true } },
  { tag: 'Banda 6S', name: '半打6S', desc: '更大尺度的模块化居住产品。【示例文案，待确认】', spec: '建筑面积 / 户型：【待确认】', href: '/zh/products/6s/', img: { base: 'product-6s-hero', alt: '半打6S 黄昏外观', mw: true } },
  { tag: 'Grayscale', name: '灰度空间', desc: '模块化空间产品系列。【示例文案，待确认】', spec: '规格：【待确认】', href: '/zh/products/grayscale/', img: { base: 'product-grayscale-hero', alt: '灰度空间 外观', mw: true } },
  { tag: 'Banda BD8', name: '半打 BD8', desc: '装配式空间产品，图片待甲方提供。', spec: '规格：【待确认】', href: '/zh/products/bd8/', mos: { id: 'PH-PROD-BD8', use: 'BD8 产品主图', min: '1600×1200', subject: '建筑正立面，居中' } },
  { tag: 'Banda BD9', name: '半打 BD9', desc: '装配式空间产品，图片待甲方提供。', spec: '规格：【待确认】', href: '/zh/products/bd9/', mos: { id: 'PH-PROD-BD9', use: 'BD9 产品主图', min: '1600×1200', subject: '建筑正立面，居中' } },
];
---

<BaseLayout
  title="产品中心"
  description="半打空间产品中心：4S / 5S / 6S / 灰度空间 / BD8 / BD9 装配式混凝土空间产品与预制构件产品线。"
  current="products"
  headerStyle="overlay"
  master="v32"
>
  {/* 页头 64vh */}
  <section class="phero" aria-label="产品中心页头">
    <div class="ph3" aria-hidden="true">
      <picture>
        <source media="(max-width: 720px)" type="image/webp" srcset="/assets/img/product-4s-hero-m.webp" />
        <source type="image/webp" srcset="/assets/img/product-4s-hero.webp" />
        <img src="/assets/img/product-4s-hero.jpg" width="1920" height="1080" alt="" loading="eager" decoding="async" fetchpriority="high" onerror="this.closest('.phero').classList.add('ph-fallback');this.closest('picture').remove()" />
      </picture>
    </div>
    <div class="hc">
      <div class="eyebrow on-dark">Products</div>
      <h1>产品中心</h1>
      <p class="sub">从紧凑户型到组合空间，四个产品系列。【示例文案，待确认】</p>
    </div>
  </section>

  {/* 交替 50/50 产品行 ×6 */}
  <div class="wrap">
    {rows.map((p, i) => (
      <section class:list={['prow32', { rev: i % 2 === 1 }]} aria-label={p.name}>
        <div class="pi r43 rv">
          {p.img ? (
            <picture>
              {p.img.mw && <source type="image/webp" srcset={`/assets/img/${p.img.base}-m.webp 960w, /assets/img/${p.img.base}.webp 1920w`} sizes="(max-width: 720px) 100vw, 50vw" />}
              <img src={`/assets/img/${p.img.base}.jpg`} width="1920" height="1080" alt={p.img.alt} loading="lazy" decoding="async" onerror="this.closest('.pi').classList.add('ph-fallback');this.closest('picture').remove()" />
            </picture>
          ) : (
            <Mos id={p.mos!.id} use={p.mos!.use} ratio="4:3" min={p.mos!.min} subject={p.mos!.subject} />
          )}
        </div>
        <div class="pt rv">
          <div class="tagline">{p.tag}</div>
          <h2 class="h2">{p.name}</h2>
          <p class="body">{p.desc}</p>
          <p class="small" style="margin-top:18px">{p.spec}</p>
          <div style="margin-top:28px"><a class="btn btn-ghost-dark" href={p.href}>查看详情 <span class="arr">→</span></a></div>
        </div>
      </section>
    ))}
  </div>

  {/* 预制构件产品线（paper2，居中 CTA） */}
  <section class="sec sec-paper2" style="text-align:center" aria-label="预制构件产品线">
    <div class="wrap">
      <h2 class="h2 rv">预制构件产品线</h2>
      <p class="body rv" style="margin:0 auto">楼梯、墙板、楼板等预制构件单独供应，图片待甲方提供。【示例文案，待确认】</p>
      <div class="rv" style="margin-top:28px"><a class="btn btn-primary" href="/zh/contact/" data-track="consult_click">咨询产品 <span class="arr">→</span></a></div>
    </div>
  </section>
</BaseLayout>