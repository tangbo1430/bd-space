---
import PhotoGrid from "../../../components/PhotoGrid.astro";
import Icon from "../../../components/Icon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GalleryImage from "../../../components/GalleryImage.astro";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import PageVisual from "../../../components/PageVisual.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const products = await getCollection(
    "products",
    ({ data }) => data.published,
  );
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}
const { product } = Astro.props;
const english = Astro.url.pathname.startsWith("/en/");
const descriptions: Record<
  string,
  { title: string; en: string; intro: string; hero?: string }
> = {
  bd8: {
    title: "探索空间的不同组合。",
    en: "MODULAR SPACE / BD8",
    intro: "装配式空间产品。具体布局、配置与交付方案，需要结合项目进一步确认。",
  },
  bd9: {
    title: "为不同需求，组合空间。",
    en: "MODULAR SPACE / BD9",
    intro: "装配式空间产品。具体布局、配置与交付方案，需要结合项目进一步确认。",
  },
  slab: {
    title: "构筑空间的水平边界。",
    en: "PRECAST / FLOOR SLAB",
    intro: "预制楼板构件。规格、荷载与连接方式，按项目设计要求确认。",
  },
  wall: {
    title: "用构件，组织建筑。",
    en: "PRECAST / WALL PANEL",
    intro: "预制墙板构件。尺寸、开洞与连接方式，按项目设计要求确认。",
  },
  stair: {
    title: "连接空间，也连接日常。",
    en: "PRECAST / STAIRCASE",
    intro: "预制楼梯构件。踏步、尺寸与安装方式，按项目设计要求确认。",
  },
};
const copy = product.data.listed
  ? {
      title: product.data.tagline,
      en: product.data.enTag,
      intro: product.data.description,
      hero: product.data.heroBase,
    }
  : descriptions[product.id];
const knownParams = product.data.params.filter(
  (p: { value: string }) => !p.value.includes("待"),
);
const summaryParams = knownParams.filter((p) =>
  ["建筑面积", "户型", "装运参考"].includes(p.label),
);
const isSpace = ["4s", "5s", "6s", "grayscale", "bd8", "bd9"].includes(
  product.id,
);
const ids = ["4s", "5s", "6s", "grayscale", "bd8", "bd9"];
const next = product.data.listed
  ? ids[(ids.indexOf(product.id) + 1) % ids.length]
  : undefined;
---

<BaseLayout
  title={product.data.name}
  description={`${product.data.name} — ${copy.title} ${copy.intro}`}
  noindex={!product.data.listed}
  current="products"
  headerStyle={copy.hero ? "overlay" : "solid"}
>
  <div class="page-editorial">
    {!copy.hero && (
      <section class="page-opening ed-wrap">
        <a class="eyebrow" href="/zh/products/">
          <Icon name="chevron-left" /> 产品中心
        </a>
        <div class="page-heading">
          <h1>{product.data.name}</h1>
          <div>
            <span class="eyebrow">{copy.en}</span>
            <p style="margin-top:18px">{copy.title}</p>
          </div>
        </div>
      </section>
    )}
    {copy.hero ? (
      <PageVisual
        mode="cover"
        base={copy.hero}
        mobileImage={product.data.mobileImage}
        alt={product.data.heroCaption ?? `${product.data.name}外观`}
        galleryGroup={product.id}
        caption={product.data.heroCaption ?? `${product.data.name} / 外观`}
        meta="空间产品"
      >
        <h1 slot="title">{product.data.name}</h1>
        <p slot="description">{copy.title}</p>
        <Fragment slot="actions">
          <a
            class="action action-primary"
            href={`/zh/contact/?product=${product.id}`}
          >
            咨询该产品
          </a>
          <a class="action action-secondary" href="/zh/products/">
            全部产品
          </a>
        </Fragment>
      </PageVisual>
    ) : (
      <div class="ed-wrap">
        <div class="product-drawing">
          <svg viewBox="0 0 700 330" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M160 240 380 290 580 165 360 115zM160 240V100L360 25l220 55v85M160 100l220 50 200-70M380 150v140M260 72v191M460 109v131M190 132l50 12v82l-50-12zM405 158l53-32v72l-53 33zM494 105l54-21v70l-54 33z" />
              <path
                d="M80 285h530M120 50v210"
                stroke-dasharray="4 6"
                opacity=".3"
              />
            </g>
          </svg>
          <p>了解构件方案，请联系我们。</p>
          <span class="eyebrow">{copy.en}</span>
        </div>
      </div>
    )}
    {product.data.listed && (
      <nav class="product-jump ed-wrap" aria-label="产品详情章节">
        {product.data.designGallery.length > 0 && (
          <a href="#spaces">空间体验</a>
        )}
        <a href="#specifications">产品参数</a>
        {product.data.gallery.length > 0 && (
          <a href="#construction">实拍与构造</a>
        )}
        {product.data.video && <a href="#installation-video">施工视频</a>}
        {product.data.diagrams.length > 0 && (
          <a href="#diagrams">{product.data.diagramLabel}</a>
        )}
      </nav>
    )}
    <section class="ed-wrap ed-section">
      <div class="about-statement product-idea">
        <div class="rv">
          <span class="eyebrow">01 / THE IDEA</span>
          <h2 class="product-idea-title">
            {english
              ? copy.title
              : copy.title.split(/(?<=，)/u).map((line) => <span>{line}</span>)}
          </h2>
        </div>
        <div class="rv">
          <p style="margin-top:0">{copy.intro}</p>
          {summaryParams.length > 0 && (
            <dl class="product-summary">
              {summaryParams.map((p) => (
                <div>
                  <dt>{p.label}</dt>
                  <dd>{p.value}</dd>
                </div>
              ))}
            </dl>
          )}
          <p>
            {isSpace
              ? "我们将空间与建造视为一个整体。模块、构件与现场连接，共同构成建筑的表达。每个项目的具体配置，都需要结合用途、场地与设计条件讨论。"
              : "从工厂预制到现场安装，构件的设计与制造需要相互配合。我们根据实际项目讨论材料、尺寸、连接节点与交付方式。"}
          </p>
          <a
            class="text-link action action-secondary"
            style="margin-top:25px"
            href={`/zh/contact/?product=${product.id}`}
            data-track="consult_click"
          >
            咨询该产品
          </a>
        </div>
      </div>
    </section>
    {product.data.designGallery.length > 0 && (
      <section
        class="ed-wrap ed-section product-design"
        id="spaces"
        aria-labelledby="design-heading"
      >
        <div class="section-label rv">
          <span>空间体验</span>
          <span>{product.data.name}</span>
        </div>
        <div class="section-heading rv">
          <h2 id="design-heading">
            <span>生活，</span>
            <span>在空间中展开。</span>
          </h2>
          <p>{product.data.designNote}</p>
        </div>
        <PhotoGrid
          photos={product.data.designGallery}
          group={product.id}
          class="product-design-grid"
        />
      </section>
    )}
    <section class="product-section ed-section" id="specifications">
      <div class="ed-wrap">
        <div class="section-label rv">
          <span>PROJECT SPECIFICATION</span>
          <span>规格与项目配置</span>
        </div>
        <div class="specification-grid">
          <div class="rv">
            <h2>
              从项目需求，
              <br />
              确定空间细节。
            </h2>
            <p>
              规格尺寸、结构配置与交付方式，
              <br />
              以项目沟通后确认的技术资料为准。
            </p>
          </div>
          <div class="specification-table rv">
            {knownParams.length > 0
              ? knownParams.map((p: { label: string; value: string }) => (
                  <div>
                    <span>{p.label}</span>
                    <span>{p.value}</span>
                  </div>
                ))
              : product.data.params.map((p: { label: string }) => (
                  <div>
                    <span>{p.label}</span>
                    <span>按项目确认</span>
                  </div>
                ))}
            <p class="specification-note">{product.data.specNote}</p>
          </div>
        </div>
      </div>
    </section>
    {product.data.gallery.length > 0 && (
      <section class="ed-wrap ed-section" id="construction">
        <div class="section-label rv">
          <span>实拍与构造</span>
          <span>{product.data.name}</span>
        </div>
        <div class="section-heading rv">
          <h2>{product.data.galleryTitle}</h2>
          {product.data.galleryIntro && <p>{product.data.galleryIntro}</p>}
        </div>
        <PhotoGrid
          photos={product.data.gallery}
          group={product.id}
          class="material-detail-gallery"
        />
      </section>
    )}
    {product.data.video && (
      <section
        class="ed-wrap ed-section installation-film"
        id="installation-video"
        aria-labelledby="film-heading"
      >
        <div>
          <span class="eyebrow">施工记录</span>
          <h2 id="film-heading">从工厂，到场地。</h2>
          <p>{product.data.video.caption}</p>
          <p>手动播放，查看模块吊装与现场装配。</p>
        </div>
        <video
          controls
          playsinline
          preload="none"
          poster={product.data.video.poster}
          width={product.data.video.width}
          height={product.data.video.height}
          aria-label={product.data.video.caption}
        >
          <source src={product.data.video.src} type="video/mp4" />
          您的浏览器不支持视频播放。
        </video>
      </section>
    )}
    {product.data.diagrams.length > 0 && (
      <section
        class="ed-wrap ed-section product-diagrams"
        id="diagrams"
        aria-labelledby="diagram-heading"
      >
        <div class="section-label rv">
          <span>{product.data.diagramLabel}</span>
          <span>{product.data.name}</span>
        </div>
        <div class="section-heading rv">
          <h2 id="diagram-heading">
            {product.data.diagramTitle.split("，").map((part, index, parts) => (
              <span>
                {part}
                {index < parts.length - 1 ? "，" : ""}
              </span>
            ))}
          </h2>
          <p>{product.data.diagramIntro}</p>
        </div>
        <div
          class:list={[
            "technical-grid",
            { "many-drawings": product.data.diagrams.length > 2 },
          ]}
        >
          {product.data.diagrams.map((diagram) => (
            <figure class="technical-figure rv">
              <GalleryImage
                {...diagram}
                alt={diagram.caption}
                group={`${product.id}-diagrams`}
                fit="contain"
                sizes="(max-width: 767px) calc(100vw - 48px), 1100px"
              />
              <figcaption>
                {diagram.caption}
                <span>点击放大，查看完整标注</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    {next && (
      <div class="ed-wrap next-product">
        <a
          class="text-link action action-secondary"
          href={`/zh/products/${next}/`}
        >
          下一款空间产品 /{" "}
          {next === "grayscale"
            ? "灰度空间"
            : `半打 ${next.replace("bd", "").toUpperCase()}`}
        </a>
        <a class="text-link action action-secondary" href="/zh/products/">
          返回产品中心
        </a>
      </div>
    )}
    <ProjectCTA />
    {copy.hero && <PhotoViewer />}
  </div>
</BaseLayout>
