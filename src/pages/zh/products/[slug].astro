---
import Icon from "../../../components/Icon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GalleryImage from "../../../components/GalleryImage.astro";
import PhotoViewer from "../../../components/PhotoViewer.astro";
import ProjectCTA from "../../../components/ProjectCTA.astro";
import PageVisual from "../../../components/PageVisual.astro";
import ProductTiles from "../../../components/ProductTiles.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const products = await getCollection(
    "products",
    ({ data }) => data.published,
  );
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}
const { product } = Astro.props;
const data = product.data;
const descriptions: Record<
  string,
  { title: string; en: string; intro: string }
> = {
  slab: {
    title: "构筑空间的水平边界。",
    en: "PRECAST / FLOOR SLAB",
    intro: "预制楼板构件。规格、荷载与连接方式，按项目设计要求确认。",
  },
  wall: {
    title: "用构件，组织建筑。",
    en: "PRECAST / WALL PANEL",
    intro: "预制墙板构件。尺寸、开洞与连接方式，按项目设计要求确认。",
  },
  stair: {
    title: "连接空间，也连接日常。",
    en: "PRECAST / STAIRCASE",
    intro: "预制楼梯构件。踏步、尺寸与安装方式，按项目设计要求确认。",
  },
};
const copy = data.listed
  ? {
      title: data.tagline,
      en: data.enTag,
      intro: data.description,
      hero: data.heroBase,
    }
  : { ...descriptions[product.id], hero: undefined };
const knownParams = data.params.filter(
  (p: { value: string }) => !p.value.includes("待"),
);
const listed = (
  await getCollection("products", ({ data }) => data.published && data.listed)
).sort((a, b) => a.data.order - b.data.order);
const ids = listed.map((p) => p.id);
const names = Object.fromEntries(listed.map((p) => [p.id, p.data.name]));
const next = data.listed
  ? ids[(ids.indexOf(product.id) + 1) % ids.length]
  : undefined;
const plan = data.diagrams.find((d) => d.caption.includes("平面"));
const diagrams = data.diagrams.filter((d) => d !== plan);
const hasFilm = data.videos.length > 0 || Boolean(data.video);
const videos =
  data.videos.length > 0 ? data.videos : data.video ? [data.video] : [];
const bands = [
  "spec",
  data.designGallery.length > 0 && "spaces",
  data.gallery.length > 0 && "construction",
  hasFilm && "film",
  diagrams.length > 0 && "diagrams",
].filter(Boolean);
const tint = (key: string) => bands.indexOf(key) % 2 === 0;
---

<BaseLayout
  title={data.name}
  description={`${data.name} — ${copy.title} ${copy.intro}`}
  noindex={!data.listed}
  current="products"
  headerStyle="solid"
>
  <div
    class="page-editorial product-detail"
    data-layout={data.listed ? "complete" : undefined}
  >
    {copy.hero ? (
      <PageVisual
        mode="cover"
        base={copy.hero}
        alt={data.heroCaption ?? `${data.name}外观`}
        galleryGroup={product.id}
        caption={data.heroCaption ?? `${data.name} / 外观`}
        meta="空间产品"
      >
        <h1 slot="title">{data.name}</h1>
        <p slot="description">{copy.title}</p>
        <Fragment slot="actions">
          <a
            class="action action-primary"
            href={`/zh/contact/?product=${product.id}`}
          >
            咨询该产品
          </a>
          <a class="action action-secondary" href="/zh/products/">
            全部产品
          </a>
        </Fragment>
      </PageVisual>
    ) : (
      <section class="page-opening ed-wrap">
        <a class="eyebrow" href="/zh/products/">
          <Icon name="chevron-left" /> 产品中心
        </a>
        <div class="page-heading">
          <h1>{data.name}</h1>
          <div>
            <span class="eyebrow">{copy.en}</span>
            <p style="margin-top:18px">{copy.title}</p>
          </div>
        </div>
      </section>
    )}
    {data.listed && (
      <nav class="product-jump ed-wrap" aria-label="产品详情章节">
        <a href="#specifications">产品参数</a>
        {data.designGallery.length > 0 && <a href="#spaces">空间体验</a>}
        {data.gallery.length > 0 && <a href="#construction">实拍与构造</a>}
        {hasFilm && <a href="#installation-video">施工记录</a>}
        {diagrams.length > 0 && <a href="#diagrams">{data.diagramLabel}</a>}
      </nav>
    )}
    <section
      class:list={["pd-band", { "pd-band--tint": tint("spec") }]}
      id="specifications"
      aria-labelledby="spec-heading"
    >
      <div class="ed-wrap">
        <header class="pd-head rv">
          <span class="pd-eyebrow">产品参数 · SPECIFICATION</span>
          <h2 id="spec-heading">
            {product.id === "4s" && !Astro.url.pathname.startsWith("/en/") ? (
              <>
                <span class="heading-phrase">从项目需求，</span>
                <span class="heading-phrase">确定空间细节。</span>
              </>
            ) : (
              "从项目需求，确定空间细节。"
            )}
          </h2>
          <p>{copy.intro}</p>
        </header>
        <div class:list={["pd-spec", { "pd-spec--solo": !plan }]}>
          {plan && (
            <figure class="pd-plan rv">
              <GalleryImage
                {...plan}
                alt={plan.caption}
                group={`${product.id}-diagrams`}
                fit="contain"
                sizes="(max-width: 767px) calc(100vw - 48px), 640px"
              />
              <figcaption>{plan.caption}</figcaption>
            </figure>
          )}
          <div class="pd-table rv">
            <dl>
              {knownParams.length > 0
                ? knownParams.map((p: { label: string; value: string }) => (
                    <div>
                      <dt>{p.label}</dt>
                      <dd>{p.value}</dd>
                    </div>
                  ))
                : data.params.map((p: { label: string }) => (
                    <div>
                      <dt>{p.label}</dt>
                      <dd>按项目确认</dd>
                    </div>
                  ))}
            </dl>
            <p class="pd-note">{data.specNote}</p>
            <div class="pd-actions">
              <a
                class="action action-primary"
                href={`/zh/contact/?product=${product.id}`}
                data-track="consult_click"
              >
                咨询该产品
              </a>
            </div>
          </div>
        </div>
        {data.highlights.length > 0 && (
          <div class="pd-highlights rv">
            <ol>
              {data.highlights.map((h, i) => (
                <li>
                  <span>0{i + 1}</span>
                  <p>{h}</p>
                </li>
              ))}
            </ol>
            {data.scenesText && (
              <p class="pd-scenes">
                <strong>适用场景</strong>
                {data.scenesText}
              </p>
            )}
          </div>
        )}
      </div>
    </section>
    {data.designGallery.length > 0 && (
      <section
        class:list={["pd-band", { "pd-band--tint": tint("spaces") }]}
        id="spaces"
        aria-labelledby="design-heading"
      >
        <div class="ed-wrap">
          <header class="pd-head rv">
            <span class="pd-eyebrow">空间体验 · SPACES</span>
            <h2 id="design-heading">生活，在空间中展开。</h2>
            {data.designNote && <p>{data.designNote}</p>}
          </header>
          <ProductTiles
            photos={data.designGallery}
            group={product.id}
            complete
          />
        </div>
      </section>
    )}
    {data.gallery.length > 0 && (
      <section
        class:list={["pd-band", { "pd-band--tint": tint("construction") }]}
        id="construction"
        aria-labelledby="construction-heading"
      >
        <div class="ed-wrap">
          <header class="pd-head rv">
            <span class="pd-eyebrow">实拍与构造 · ON SITE</span>
            <h2 id="construction-heading">{data.galleryTitle}</h2>
            {data.galleryIntro && <p>{data.galleryIntro}</p>}
          </header>
          <ProductTiles
            photos={data.gallery}
            group={`${product.id}-site`}
            complete
          />
        </div>
      </section>
    )}
    {hasFilm && (
      <section
        class:list={["pd-band", { "pd-band--tint": tint("film") }]}
        id="installation-video"
        aria-labelledby="film-heading"
      >
        <div class="ed-wrap">
          <header class="pd-head rv">
            <span class="pd-eyebrow">施工记录 · FROM FACTORY TO SITE</span>
            <h2 id="film-heading">从工厂，到场地。</h2>
            <p>
              模块在工厂完成制造，经运输、吊装与现场装配，成为可以使用的空间。
            </p>
          </header>
          <div
            class:list={["pd-film", { "pd-film--photo": data.filmPhoto }]}
            style={`--film-count:${videos.length}`}
          >
            {data.filmPhoto && (
              <figure class="pd-film-photo rv">
                <GalleryImage
                  base={data.filmPhoto.base}
                  alt={data.filmPhoto.caption}
                  caption={data.filmPhoto.caption}
                  group={`${product.id}-site`}
                  fit="contain"
                  sizes="(max-width: 767px) calc(100vw - 48px), 640px"
                />
                <figcaption>{data.filmPhoto.caption}</figcaption>
              </figure>
            )}
            {videos.map((v) => (
              <figure class="pd-video rv">
                <video
                  controls
                  playsinline
                  preload="none"
                  poster={v.poster}
                  width={v.width}
                  height={v.height}
                  aria-label={v.caption}
                >
                  <source src={v.src} type="video/mp4" />
                  您的浏览器不支持视频播放。
                </video>
                <figcaption>{v.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}
    {diagrams.length > 0 && (
      <section
        class:list={["pd-band", { "pd-band--tint": tint("diagrams") }]}
        id="diagrams"
        aria-labelledby="diagram-heading"
      >
        <div class="ed-wrap">
          <header class="pd-head rv">
            <span class="pd-eyebrow">{data.diagramLabel}</span>
            <h2 id="diagram-heading">{data.diagramTitle}</h2>
            {data.diagramIntro && <p>{data.diagramIntro}</p>}
          </header>
          <div
            class:list={[
              "pd-drawings",
              {
                "pd-drawings--single": diagrams.length === 1,
                "pd-drawings--odd":
                  diagrams.length > 1 && diagrams.length % 2 === 1,
              },
            ]}
          >
            {diagrams.map((diagram) => (
              <figure class="pd-drawing rv">
                <GalleryImage
                  {...diagram}
                  alt={diagram.caption}
                  group={`${product.id}-diagrams`}
                  fit="contain"
                  sizes="(max-width: 767px) calc(100vw - 48px), 1100px"
                />
                <figcaption>{diagram.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}
    {next && (
      <nav class="pd-next ed-wrap" aria-label="继续浏览">
        <a class="pd-next-card" href={`/zh/products/${next}/`}>
          <span class="pd-eyebrow">下一款空间产品</span>
          <strong>{names[next]}</strong>
          <Icon name="chevron-right" />
        </a>
        <a class="text-link action action-secondary" href="/zh/products/">
          返回产品中心
        </a>
      </nav>
    )}
    <ProjectCTA />
    {copy.hero && <PhotoViewer />}
  </div>
</BaseLayout>
