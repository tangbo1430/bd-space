---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PRODUCT_ASSETS, SPACE_ASSETS, PRODUCT_HERO_ASSETS } from '../../../lib/assets';
import Mos from '../../../components/Mos.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.published);
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;

/* v3.2：页头 64vh 通栏；无图产品线降级为马赛克占位（不虚构、不拉伸） */
const heroAsset = product.data.heroAsset ? PRODUCT_HERO_ASSETS[product.data.heroAsset] : undefined;

/* 概述分栏图：4S 用黄昏正立面；其余有图线沿用各自 hero */
const overviewAsset = product.id === '4s' ? PRODUCT_ASSETS.p4sDusk : heroAsset;

/* 空间与格局（paper2，2×2 室内实景；仅 4S 展示已批准实景） */
const interiors = [
  { a: SPACE_ASSETS.kitchen, cap: '厨房' },
  { a: SPACE_ASSETS.bedroom, cap: '卧室' },
  { a: SPACE_ASSETS.bath, cap: '卫浴' },
  { a: SPACE_ASSETS.laundry, cap: '洗衣区' },
];

/* 细节（仅 4S 有已批准辅图） */
const details = product.id === '4s'
  ? [
      { base: 'product-4s-dusk-door', alt: '半打4S 入口细节', w: 608, h: 810 },
      { base: 'product-4s-detail-wall', alt: '半打4S 墙板细节', w: 1920, h: 1080, mw: true },
    ]
  : [];
---

<BaseLayout
  title={product.data.name}
  description={`${product.data.name}——${product.data.tagline} 半打空间装配式混凝土空间产品。`}
  current="products"
  headerStyle="overlay"
  master="v32"
>
  {/* 页头 64vh；无图产品线用马赛克占位（固定 64vh，供图后只换图） */}
  {heroAsset ? (
    <section class="phero" aria-label={`${product.data.name}页头`}>
      <div class="ph3" aria-hidden="true">
        <picture>
          {'mw' in heroAsset && heroAsset.mw && <source media="(max-width: 720px)" type="image/webp" srcset={`/assets/img/${heroAsset.base}-m.webp`} />}
          <source type="image/webp" srcset={`/assets/img/${heroAsset.base}.webp`} />
          <img src={`/assets/img/${heroAsset.base}.jpg`} width={heroAsset.w} height={heroAsset.h} alt="" loading="eager" decoding="async" fetchpriority="high" onerror="this.closest('.phero').classList.add('ph-fallback');this.closest('picture').remove()" />
        </picture>
      </div>
      <div class="hc">
        <div class="eyebrow on-dark">{product.data.enTag}</div>
        <h1>{product.data.name}</h1>
        <p class="sub">{product.data.tagline}【示例文案，待确认】</p>
      </div>
    </section>
  ) : (
    <section class="phero" aria-label={`${product.data.name}页头`} style="background:var(--v32-paper2)">
      <div class="hc" style="color:var(--v32-ink)">
        <div class="eyebrow">{product.data.enTag}</div>
        <h1>{product.data.name}</h1>
        <p class="sub" style="color:var(--v32-muted)">{product.data.tagline} — 产品主图待甲方提供。</p>
      </div>
    </section>
  )}

  {/* 概述 50/50 */}
  <section class="sec" aria-label="概述">
    <div class="wrap split">
      <div class="st rv">
        <div class="eyebrow">Overview</div>
        <h2 class="h2">一个完整的<br />居住单元</h2>
        <p class="body">{product.data.name} 在工厂完成主体与内部管线，运输到场后吊装就位即可使用。【示例文案，待确认】</p>
        <div style="margin-top:32px"><a class="btn btn-primary" href="/zh/contact/" data-track="consult_click">咨询该产品 <span class="arr">→</span></a></div>
      </div>
      <div class="si r43 rv">
        {overviewAsset ? (
          <picture>
            {'msuf' in overviewAsset
              ? <source type="image/webp" srcset={`/assets/img/${overviewAsset.base}${overviewAsset.msuf}.webp 960w, /assets/img/${overviewAsset.base}.webp ${overviewAsset.w}w`} sizes="(max-width: 720px) 100vw, 50vw" />
              : ('mw' in overviewAsset && overviewAsset.mw
                  ? <source type="image/webp" srcset={`/assets/img/${overviewAsset.base}-m.webp 960w, /assets/img/${overviewAsset.base}.webp ${overviewAsset.w}w`} sizes="(max-width: 720px) 100vw, 50vw" />
                  : <source type="image/webp" srcset={`/assets/img/${overviewAsset.base}.webp`} />)}
            <img src={`/assets/img/${overviewAsset.base}.jpg`} width={overviewAsset.w} height={overviewAsset.h} alt={overviewAsset.alt} loading="lazy" decoding="async" onerror="this.closest('.si').classList.add('ph-fallback');this.closest('picture').remove()" />
          </picture>
        ) : (
          <Mos id={`PH-PROD-${product.data.enTag.replace(/\s/g, '')}`} use={`${product.data.name} 概述配图`} ratio="4:3" min="1600×1200" subject="建筑正立面，居中" />
        )}
      </div>
    </div>
  </section>

  {/* 空间与格局（paper2，2×2；仅 4S 展示已批准室内实景） */}
  {product.id === '4s' && (
    <section class="sec sec-paper2" aria-label="空间与格局">
      <div class="wrap">
        <div class="eyebrow rv">Interior</div>
        <h2 class="h2 rv" style="margin-bottom:40px">空间与格局</h2>
        <div class="g4-32">
          {interiors.map((it) => (
            <div class="rv">
              <div class="gi r43">
                <picture>
                  <source type="image/webp" srcset={`/assets/img/${it.a.base}-960w.webp ${it.a.mw}w, /assets/img/${it.a.base}.webp ${it.a.w}w`} sizes="(max-width: 720px) 100vw, 50vw" />
                  <img src={`/assets/img/${it.a.base}.jpg`} width={it.a.w} height={it.a.h} alt={it.a.alt} loading="lazy" decoding="async" onerror="this.closest('.gi').classList.add('ph-fallback');this.closest('picture').remove()" />
                </picture>
              </div>
              <div class="figcap">{it.cap}</div>
            </div>
          ))}
        </div>
        <p class="small rv" style="margin-top:20px">室内图为 60㎡ 组合空间实景；{product.data.name} 户型图待甲方提供后补充。</p>
      </div>
    </section>
  )}

  {/* 产品参数：细线表，全部待确认 */}
  <section class="sec" aria-label="产品参数">
    <div class="wrap">
      <div class="eyebrow rv">Specifications</div>
      <h2 class="h2 rv" style="margin-bottom:32px">产品参数</h2>
      <div class="specs32 rv">
        {product.data.params.map((row) => (
          <div class="r"><b>{row.label}</b><span>{row.value}</span></div>
        ))}
      </div>
      <p class="small rv" style="margin-top:20px">参数以甲方确认的产品资料为准，不预填未经确认的数值。</p>
    </div>
  </section>

  {/* 细节 2 图（仅 4S） */}
  {details.length > 0 && (
    <section class="sec sec-paper2" aria-label="细节">
      <div class="wrap">
        <div class="eyebrow rv">Details</div>
        <h2 class="h2 rv" style="margin-bottom:40px">细节</h2>
        <div class="g2-32">
          {details.map((d) => (
            <div class="gi r43 rv">
              <picture>
                {'mw' in d && d.mw && <source type="image/webp" srcset={`/assets/img/${d.base}-m.webp 960w, /assets/img/${d.base}.webp ${d.w}w`} sizes="(max-width: 720px) 100vw, 50vw" />}
                {!('mw' in d && d.mw) && <source type="image/webp" srcset={`/assets/img/${d.base}.webp`} />}
                <img src={`/assets/img/${d.base}.jpg`} width={d.w} height={d.h} alt={d.alt} loading="lazy" decoding="async" onerror="this.closest('.gi').classList.add('ph-fallback');this.closest('picture').remove()" />
              </picture>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* 转化章 */}
  <section class="conv32" aria-label="产品咨询">
    <div class="ph3" aria-hidden="true">
      <picture>
        <source type="image/webp" srcset="/assets/img/case-cabin-site-aerial-m.webp 960w, /assets/img/case-cabin-site-aerial.webp 1920w" sizes="100vw" />
        <img src="/assets/img/case-cabin-site-aerial.jpg" width="1920" height="1080" alt="" loading="lazy" decoding="async" onerror="this.closest('.conv32').classList.add('ph-fallback');this.closest('picture').remove()" />
      </picture>
    </div>
    <div class="hc">
      <h2 class="rv">对 {product.data.name} 感兴趣？</h2>
      <p class="rv">留下需求，获取产品资料与报价。【示例文案，待确认】</p>
      <a class="btn btn-primary rv" href="/zh/contact/" data-track="consult_click">预约咨询 <span class="arr">→</span></a>
    </div>
  </section>
</BaseLayout>