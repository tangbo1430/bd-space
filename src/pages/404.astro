---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="您访问的页面不存在或已下线。" headerStyle="solid" noindex={true}>
  <section class="state-page">
    <div class="inner">
      <div class="code">404</div>
      <h1>页面不存在</h1>
      <p>您访问的页面不存在或已下线。您可以返回首页，或通过导航访问各栏目。</p>
      <div class="btns">
        <a class="btn btn-primary" href="/zh/">返回首页 <span class="arr">→</span></a>
        <a class="btn btn-ghost" href="/zh/contact/">联系我们 <span class="arr">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
