---
import Icon from "./Icon.astro";
import { company } from "../data/company";
import { getCollection } from "astro:content";
import projects from "../data/projects.json";
const inquiryNames = Object.fromEntries([
  ...(await getCollection("products")).map((p) => [p.id, p.data.name]),
  ...projects.map((p) => [p.id, p.name]),
]);
/**
 * 咨询表单（UI 规范 §3.6 状态机 + Leader 统一口径）。
 * 必填：称呼 / 联系方式（手机或邮箱）/ 咨询内容 / 隐私同意；选填：企业、项目所在地。
 * 失败保留输入；仅服务端确认成功后展示成功态（BR-10）。
 * 未配置 PUBLIC_FORM_ENDPOINT 时禁用提交并展示提示（BR-16：邮箱未验证前不启用真实提交）。
 */
import { isFormEnabled } from "../lib/form";

interface Props {
  id?: string;
}
const { id = "consult" } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? "";
// 端点与有效 key 均满足才允许提交（BR-16）
const enabled = isFormEnabled(endpoint, accessKey);
---

<div class="form-wrap" data-form-root>
  <form
    class="form"
    data-consult-form
    data-inquiry-names={JSON.stringify(inquiryNames)}
    data-endpoint={endpoint}
    data-access-key={accessKey}
    data-enabled={String(enabled)}
    novalidate
    aria-label="咨询留言表单"
  >
    {!enabled && (
      <p class="form-banner info show" role="note">
        填写项目需求，下载后通过邮件或微信发给我们。
      </p>
    )}
    <p class="form-banner" data-form-banner role="alert"></p>

    <div class="field" data-field="name">
      <label for={`${id}-name`}>
        称呼 <b>*</b>
      </label>
      <input
        id={`${id}-name`}
        name="name"
        required
        aria-describedby={`${id}-name-error`}
        type="text"
        placeholder="您的称呼"
        autocomplete="name"
        maxlength="50"
      />
      <div class="msg" id={`${id}-name-error`} data-msg></div>
    </div>
    <div class="field" data-field="company">
      <label for={`${id}-company`}>企业</label>
      <input
        id={`${id}-company`}
        name="company"
        type="text"
        placeholder="公司/组织名称（选填）"
        autocomplete="organization"
        maxlength="100"
      />
      <div class="msg" id={`${id}-company-error`} data-msg></div>
    </div>
    <div class="field" data-field="contact">
      <label for={`${id}-contact`}>
        联系方式 <b>*</b>
      </label>
      <input
        id={`${id}-contact`}
        name="contact"
        required
        aria-describedby={`${id}-contact-error`}
        type="text"
        placeholder="手机或邮箱"
        autocomplete="tel"
        maxlength="100"
      />
      <div class="msg" id={`${id}-contact-error`} data-msg></div>
    </div>
    <div class="field" data-field="location">
      <label for={`${id}-location`}>项目所在地</label>
      <input
        id={`${id}-location`}
        name="location"
        type="text"
        placeholder="选填"
        maxlength="100"
      />
      <div class="msg" id={`${id}-location-error`} data-msg></div>
    </div>
    <div class="field full" data-field="message">
      <label for={`${id}-message`}>
        需求描述 <b>*</b>
      </label>
      <textarea
        id={`${id}-message`}
        name="message"
        required
        aria-describedby={`${id}-message-help ${id}-message-error`}
        rows="3"
        placeholder="简单描述您的项目或问题"
        maxlength="1000"
      ></textarea>
      <div class="field-help" id={`${id}-message-help`}>
        <span>项目用途、地点与大致需求</span>
        <span data-message-count aria-hidden="true">
          0 / 1000
        </span>
      </div>
      <div class="msg" id={`${id}-message-error`} data-msg></div>
    </div>

    <!-- 防滥用：honeypot（正常用户不可见）+ 来源页面 -->
    <div class="field-hp" aria-hidden="true">
      <label for={`${id}-website`}>请勿填写</label>
      <input
        id={`${id}-website`}
        name="bd_website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <input type="hidden" name="source" data-source-field value="" />

    {enabled && (
      <label class="agree" data-field="agree">
        <input type="checkbox" name="agree" />
        <span>
          我已阅读并同意
          <a href="/zh/privacy/" target="_blank">
            《隐私政策》
          </a>
          ，同意半打空间就本次咨询与我联系。
          <b style="color:var(--state-error)">*</b>
          <span class="msg" data-msg style="display:block"></span>
        </span>
      </label>
    )}
    {!enabled && (
      <p class="local-save-note">
        下载不会自动发送，填写内容仅保存到您的设备。
      </p>
    )}

    {enabled && (
      <button class="btn btn-primary action action-primary" type="submit">
        <span data-submit-text>提交留言</span>
      </button>
    )}
    {!enabled && (
      <button
        class="btn btn-primary action action-primary"
        type="button"
        data-download-inquiry
      >
        <Icon name="download" />
        <span>下载项目需求</span>
      </button>
    )}
    <p class="local-download-status" data-download-status role="status"></p>
    {!enabled && (
      <p class="inquiry-next-step">
        下载后，请将需求文件发送至{" "}
        <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
        ，或通过<a href="/zh/contact/#wechat">微信联系</a>。
      </p>
    )}
  </form>

  <div class="form-success" data-form-success hidden>
    <div class="ic">
      <Icon name="check" />
    </div>
    <h3>已收到您的留言</h3>
    <p>感谢您的关注，我们会通过您留下的联系方式与您沟通。</p>
  </div>
</div>
