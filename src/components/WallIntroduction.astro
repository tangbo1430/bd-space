---
import EditorialImage from "./EditorialImage.astro";
import GalleryImage from "./GalleryImage.astro";
const en = Astro.url.pathname.startsWith("/en/");
const nodes = en
  ? [
      "Wall to foundation",
      "Wall connection 1",
      "Wall connection 2",
      "Wall connection 3",
    ]
  : ["墙与地基连接", "墙体连接节点 1", "墙体连接节点 2", "墙体连接节点 3"];
---

<section class="wall-introduction" id="banda-wall" aria-labelledby="wall-title">
  <div class="wall-overview">
    <header class="wall-heading">
      <h2 id="wall-title">{en ? "The Banda Wall" : "半打墙"}</h2>
      <p class="wall-statement">
        {en
          ? "An industrialised building system for housing."
          : "一套可以工业化制造的建房系统。"}
      </p>
      <p>
        {en
          ? "Biomimicry applied to architecture: bone, muscle and skin. A key to manufacturing homes through industrial processes."
          : "把仿生学用于建筑——骨＋肉＋皮。由此，找到了工业化制造房子的密钥。"}
      </p>
      <figure class="wall-house">
        <EditorialImage
          src="/assets/img/r79-wall-house.webp"
          fit="contain"
          alt={
            en
              ? "Banda building system, housing illustration"
              : "半打建房系统，住宅示意"
          }
        />
        <figcaption>
          {en
            ? "From a building system to a home."
            : "从建房系统，到日常居所。"}
        </figcaption>
      </figure>
    </header>
    <figure class="wall-structure">
      <GalleryImage
        base="r78-design"
        fit="contain"
        group="wall-structure"
        alt={en ? "Banda Wall structural illustration" : "半打墙构造示意"}
      />
      <figcaption>
        {en
          ? "The skeleton gives the wall its soul—and a foundation for trust."
          : "骨的存在，让墙有了灵魂，也有了信任。"}
      </figcaption>
    </figure>
  </div>
  <div class="wall-detail-heading">
    <h3>{en ? "Connections" : "连接方式"}</h3>
    <p>
      {en
        ? "Explore each connection in the complete annotated drawing."
        : "从地基到墙体，查看每一处连接的完整节点图。"}
    </p>
  </div>
  <div class="wall-connections">
    {nodes.map((caption, i) => (
      <figure>
        <GalleryImage
          src={`/assets/img/r79-wall-node-${i}.webp`}
          previewSrc={`/assets/img/r83-wall-detail-${i}.webp`}
          fit="contain"
          group="wall-connections"
          alt={en ? `${caption}, detail preview` : `${caption}，构造局部`}
          caption={caption}
        />
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="wall-detail-heading">
    <h3>{en ? "From manufacture to installation" : "从制造，到现场装配"}</h3>
    <p>
      {en
        ? "Banda Wall in the factory, in transit and on site."
        : "半打墙的制造、运输与现场实拍。"}
    </p>
  </div>
  <div class="wall-photographs">
    {Array.from({ length: 7 }, (_, i) => (
      <figure>
        <GalleryImage
          src={`/assets/img/r79-wall-photo-${i}.webp`}
          fit="cover"
          group="wall-photos"
          alt={
            en
              ? `Banda Wall manufacturing and installation photograph ${i + 1}`
              : `半打墙制造与装配实拍 ${i + 1}`
          }
        />
      </figure>
    ))}
  </div>
</section>
<style>
  .wall-introduction {
    padding: clamp(48px, 4.2vw, 80px) var(--content-inset);
    background: var(--paper);
    color: var(--charcoal);
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .wall-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
  }
  .wall-heading h2 {
    margin: 0 0 20px;
    font-size: clamp(32px, 3vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .wall-heading p {
    margin: 16px 0 0;
    max-width: 29em;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-body);
  }
  .wall-heading .wall-statement {
    margin: 0;
    max-width: 16em;
    font-size: clamp(22px, 1.65vw, 28px);
    line-height: 1.5;
    color: var(--charcoal);
  }
  .wall-house {
    margin-top: 24px;
    width: 100%;
    max-width: 360px;
  }
  .wall-introduction :global(.editorial-image),
  .wall-introduction :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .wall-introduction :global(.gallery-link) {
    display: block;
  }
  figcaption {
    padding-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-body);
  }
  .wall-structure figcaption {
    text-align: right;
  }
  .wall-house figcaption {
    font-size: 13px;
  }
  .wall-detail-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    margin: 48px 0 24px;
  }
  .wall-detail-heading h3 {
    margin: 0;
    font-size: clamp(22px, 1.8vw, 28px);
    font-weight: 400;
    line-height: 1.4;
  }
  .wall-detail-heading p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
  }
  .wall-connections {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .wall-connections :global(.gallery-link) {
    position: relative;
    aspect-ratio: 8/5;
  }
  .wall-connections :global(.editorial-image),
  .wall-connections :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--paper);
  }
  .wall-connections :global(.gallery-link .editorial-image),
  .wall-photographs :global(.gallery-link .editorial-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .wall-introduction
    .wall-connections
    :global(.gallery-link .editorial-image img),
  .wall-introduction
    .wall-photographs
    :global(.gallery-link .editorial-image img) {
    width: 100%;
    height: 100%;
  }
  .wall-connections figcaption {
    font-size: 16px;
  }
  .wall-photographs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 12px;
    aspect-ratio: 3.1;
  }
  .wall-photographs figure:first-child {
    grid-row: span 2;
  }
  .wall-photographs figure {
    min-height: 0;
  }
  .wall-photographs :global(.gallery-link),
  .wall-photographs :global(.editorial-image),
  .wall-photographs :global(img) {
    height: 100%;
    object-fit: cover;
  }
  .wall-photographs :global(.gallery-link) {
    position: relative;
  }
  .wall-photographs :global(.gallery-link .editorial-image img) {
    object-fit: cover;
  }
  .wall-photographs figure:first-child :global(.gallery-link) {
    aspect-ratio: 3/4;
  }
  @media (max-width: 1023px) {
    .wall-overview {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 24px;
    }
    .wall-connections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wall-detail-heading {
      display: block;
    }
    .wall-detail-heading p {
      margin-top: 8px;
    }
  }
  @media (max-width: 767px) {
    .wall-overview {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .wall-house {
      max-width: 240px;
    }
    .wall-structure figcaption {
      text-align: left;
    }
    .wall-detail-heading {
      margin-top: 32px;
    }
    .wall-connections {
      gap: 24px 16px;
    }
    .wall-connections figcaption {
      font-size: 14px;
    }
    .wall-photographs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: 12px;
      aspect-ratio: auto;
    }
    .wall-photographs figure:first-child {
      grid-row: auto;
      grid-column: span 2;
    }
    .wall-photographs figure:first-child :global(.gallery-link),
    .wall-photographs figure:not(:first-child) :global(.gallery-link) {
      aspect-ratio: 4/3;
    }
  }
</style>
