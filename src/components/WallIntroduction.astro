---
import EditorialImage from "./EditorialImage.astro";
import GalleryImage from "./GalleryImage.astro";
const en = Astro.url.pathname.startsWith("/en/");
const nodes = en
  ? [
      "Wall-to-foundation connection",
      "Wall connection 1",
      "Wall connection 2",
      "Wall connection 3",
    ]
  : ["墙与地基连接", "墙体连接节点 1", "墙体连接节点 2", "墙体连接节点 3"];
---

<section class="wall-introduction" id="banda-wall" aria-labelledby="wall-title">
  <div class="wall-overview">
    <header class="wall-heading">
      <h2 id="wall-title">{en ? "The Banda Wall" : "半打墙"}</h2>
      <p class="wall-statement">
        {en ? (
          "An industrialised building system for housing."
        ) : (
          <>
            一套可<span class="wall-phrase">工业化制造</span>的房屋系统。
          </>
        )}
      </p>
      <p>
        {en
          ? "Biomimicry applied to architecture: bone, muscle and skin. This is the key to industrialised home manufacturing."
          : "把仿生学用进建筑：骨、肉、皮。我们由此找到了工业化造房的密钥。"}
      </p>
    </header>
    <figure class="wall-house">
      <EditorialImage
        src="/assets/img/r79-wall-house.webp"
        fit="contain"
        alt={
          en
            ? "Banda building system, housing illustration"
            : "半打建房系统，住宅示意"
        }
      />
      <figcaption>
        {en ? "From a building system to a home." : "从建房系统，到日常居所。"}
      </figcaption>
    </figure>
    <figure class="wall-structure">
      <GalleryImage
        base="r78-design"
        fit="contain"
        group="wall-structure"
        alt={en ? "Banda Wall structural illustration" : "半打墙构造示意"}
      />
      <figcaption>
        {en ? (
          "The skeleton gives the wall its soul—and the home its confidence."
        ) : (
          <>
            <span>骨的存在，让墙有了灵魂，</span>
            <span>也让房子有了底气。</span>
          </>
        )}
      </figcaption>
    </figure>
  </div>
  <div class="wall-detail-heading">
    <h3>{en ? "Connections" : "连接方式"}</h3>
    <p>
      {en
        ? "Explore the four key connections in detail."
        : "从地基到墙体，查看每一处连接的完整节点图。"}
    </p>
  </div>
  <div class="wall-connections">
    {nodes.map((caption, i) => (
      <figure>
        <GalleryImage
          src={`/assets/img/r79-wall-node-${i}.webp`}
          previewSrc={
            i === 0
              ? "/assets/img/nov-wall-detail-0.webp"
              : `/assets/img/r83-wall-detail-${i}.webp`
          }
          fit="contain"
          group="wall-connections"
          alt={en ? `${caption}, detail preview` : `${caption}，构造局部`}
          caption={caption}
        />
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="wall-detail-heading">
    <h3>{en ? "From manufacture to installation" : "从制造，到现场装配"}</h3>
    <p>
      {en
        ? "Banda Wall manufacture, transport and lifting on site."
        : "半打墙的制造、运输与现场吊装。"}
    </p>
  </div>
  <div class="wall-photographs">
    {Array.from({ length: 7 }, (_, i) => (
      <figure>
        <GalleryImage
          src={`/assets/img/r79-wall-photo-${i}.webp`}
          fit="cover"
          group="wall-photos"
          alt={
            en
              ? `Banda Wall manufacturing and installation photograph ${i + 1}`
              : `半打墙制造与装配实拍 ${i + 1}`
          }
        />
      </figure>
    ))}
  </div>
</section>
<style>
  .wall-introduction {
    padding: clamp(48px, 4.2vw, 80px) var(--content-inset) 0;
    background: var(--paper);
    color: var(--charcoal);
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .wall-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr);
    grid-template-areas: "heading structure" "house structure";
    gap: 28px clamp(32px, 4vw, 72px);
    align-items: start;
  }
  .wall-heading {
    grid-area: heading;
  }
  .wall-structure {
    grid-area: structure;
    align-self: center;
    container-type: inline-size;
  }
  .wall-heading h2 {
    margin: 0 0 24px;
    font-size: clamp(40px, 4.2vw, 64px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .wall-heading p {
    margin: 16px 0 0;
    max-width: 26em;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-body);
  }
  .wall-heading .wall-statement {
    margin: 0;
    max-width: 14em;
    font-size: clamp(24px, 1.9vw, 30px);
    line-height: 1.45;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .wall-phrase {
    white-space: nowrap;
  }
  .wall-house {
    grid-area: house;
    align-self: start;
    width: 100%;
  }
  .wall-introduction :global(.editorial-image),
  .wall-introduction :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .wall-introduction :global(.gallery-link) {
    display: block;
  }
  figcaption {
    padding-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-body);
  }
  .wall-structure figcaption {
    position: relative;
    width: fit-content;
    max-width: 96%;
    margin: -11cqi 4% 0 auto;
    padding: 0;
    font-size: clamp(20px, 3.7cqi, 34px);
    color: var(--charcoal);
    font-weight: 500;
    line-height: 1.4;
    pointer-events: none;
  }
  .wall-structure figcaption span {
    display: block;
  }
  .wall-structure figcaption:lang(en) {
    width: min(96%, 27ch);
    text-wrap: balance;
  }
  @container (max-width: 520px) {
    .wall-structure figcaption {
      margin-top: -3cqi;
    }
  }
  @container (max-width: 390px) {
    .wall-structure figcaption:lang(en) {
      margin-top: 8px;
    }
  }
  .wall-house figcaption {
    font-size: 14px;
  }
  .wall-detail-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    margin: 48px 0 24px;
  }
  .wall-detail-heading h3 {
    margin: 0;
    font-size: clamp(22px, 1.8vw, 28px);
    font-weight: 400;
    line-height: 1.4;
  }
  .wall-detail-heading p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
  }
  .wall-connections {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .wall-connections figure {
    display: flex;
    flex-direction: column;
    padding: 12px 12px 16px;
    background: var(--vp-card, #f9f8f5);
    border: 1px solid var(--vp-border, rgb(22 29 26 / 0.09));
    border-radius: var(--vp-radius, 3px);
    transition:
      border-color 240ms var(--vp-ease, ease),
      box-shadow 280ms var(--vp-ease, ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .wall-connections figure:hover {
      border-color: var(--vp-border-strong, rgb(22 29 26 / 0.18));
      box-shadow: var(--vp-shadow-sm);
    }
  }
  .wall-connections :global(.gallery-link) {
    position: relative;
    aspect-ratio: 8/5;
    border-radius: 2px;
    overflow: hidden;
    background: var(--paper);
  }
  .wall-connections :global(.editorial-image),
  .wall-connections :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--paper);
  }
  .wall-connections :global(.gallery-link .editorial-image),
  .wall-photographs :global(.gallery-link .editorial-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .wall-introduction
    .wall-connections
    :global(.gallery-link .editorial-image img),
  .wall-introduction
    .wall-photographs
    :global(.gallery-link .editorial-image img) {
    width: 100%;
    height: 100%;
  }
  .wall-connections figcaption {
    font-size: 16px;
  }
  .wall-photographs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 12px;
    aspect-ratio: 3.1;
  }
  .wall-photographs figure:first-child {
    grid-row: span 2;
  }
  .wall-photographs figure {
    min-height: 0;
    border-radius: 2px;
    overflow: hidden;
  }
  .wall-photographs :global(.gallery-link),
  .wall-photographs :global(.editorial-image),
  .wall-photographs :global(img) {
    height: 100%;
    object-fit: cover;
    transition: transform 720ms var(--vp-ease, ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .wall-photographs figure:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .wall-photographs :global(.gallery-link) {
    position: relative;
  }
  .wall-photographs :global(.gallery-link .editorial-image img) {
    object-fit: cover;
  }
  .wall-photographs figure:first-child :global(.gallery-link) {
    aspect-ratio: 3/4;
  }
  @media (max-width: 1023px) {
    .wall-overview {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 24px;
    }
    .wall-connections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wall-detail-heading {
      display: block;
    }
    .wall-detail-heading p {
      margin-top: 8px;
    }
  }
  @media (max-width: 767px) {
    .wall-introduction {
      padding: 40px 20px 12px;
      border-top: 1px solid var(--vp-border, rgb(22 29 26 / 0.08));
    }
    .wall-overview {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "heading" "house" "structure";
      gap: 20px;
    }
    .wall-heading h2 {
      margin: 0 0 12px;
      font-size: 32px;
      line-height: 1.18;
      letter-spacing: -0.03em;
    }
    .wall-heading .wall-statement {
      max-width: none;
      font-size: 20px;
      font-weight: 500;
      line-height: 1.4;
    }
    .wall-heading p {
      margin: 10px 0 0;
      font-size: 14.5px;
      line-height: 1.72;
    }
    .wall-house {
      max-width: none;
      width: 100%;
      padding: 14px 14px 12px;
      background: var(--vp-card, #f8f7f4);
      border: 1px solid var(--vp-border, rgb(22 29 26 / 0.08));
      border-radius: 6px;
    }
    .wall-house :global(.editorial-image) {
      border-radius: 3px;
      overflow: hidden;
      background: #fff;
    }
    .wall-house figcaption {
      padding-top: 10px;
      font-size: 13px;
      color: var(--vp-muted, #5b6660);
      text-align: center;
      letter-spacing: 0.02em;
    }
    .wall-structure :global(.gallery-link) {
      padding: 10px;
      background: #f5f5f3;
      border: 1px solid var(--vp-border, rgb(22 29 26 / 0.08));
      border-radius: 6px;
      overflow: hidden;
    }
    .wall-structure :global(img) {
      border-radius: 3px;
    }
    .wall-structure figcaption {
      width: 100%;
      max-width: none;
      margin: 14px 0 0;
      padding: 2px 0 2px 14px;
      border-left: 2.5px solid var(--vp-accent, #007963);
      font-size: 18px;
      line-height: 1.48;
      letter-spacing: -0.01em;
    }
    .wall-detail-heading {
      margin: 28px 0 16px;
      padding-top: 24px;
      border-top: 1px solid var(--vp-border, rgb(22 29 26 / 0.08));
    }
    .wall-detail-heading h3 {
      font-size: 21px;
      font-weight: 500;
    }
    .wall-detail-heading p {
      margin-top: 6px;
      font-size: 14px;
      line-height: 1.6;
      text-wrap: balance;
    }
    .wall-connections {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      margin-inline: -20px;
      padding: 2px 20px 10px;
      scrollbar-width: none;
    }
    .wall-connections::-webkit-scrollbar {
      display: none;
    }
    .wall-connections figure {
      flex: 0 0 min(276px, 76vw);
      scroll-snap-align: start;
      padding: 12px 12px 14px;
      background: #fff;
      border: 1px solid var(--vp-border, rgb(22 29 26 / 0.1));
      border-radius: 6px;
      box-shadow: 0 4px 14px -10px rgb(16 24 20 / 0.18);
    }
    .wall-connections :global(.gallery-link) {
      aspect-ratio: 3 / 2;
      background: #fff;
    }
    .wall-connections :global(.editorial-image),
    .wall-connections :global(img) {
      background: #fff;
    }
    .wall-connections figcaption {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--vp-border, rgb(22 29 26 / 0.07));
      font-size: 14px;
      font-weight: 500;
      color: var(--vp-ink, #161d1a);
    }
    .wall-photographs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: 8px;
      aspect-ratio: auto;
    }
    .wall-photographs figure {
      border-radius: 4px;
    }
    .wall-photographs figure:first-child {
      grid-column: auto;
      grid-row: span 2;
    }
    .wall-photographs figure:first-child :global(.gallery-link) {
      aspect-ratio: auto;
      height: 100%;
    }
    .wall-photographs figure:first-child :global(img) {
      object-position: center 35%;
    }
    .wall-photographs figure:not(:first-child) :global(.gallery-link) {
      aspect-ratio: 4 / 3;
    }
    .wall-introduction :global(.gallery-open) {
      top: 8px;
      right: 8px;
      min-width: 30px;
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.88);
      border: 1px solid rgb(22 29 26 / 0.1);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .wall-introduction :global(.gallery-open .ui-icon) {
      width: 13px;
      height: 13px;
    }
    .wall-photographs :global(.gallery-open) {
      top: auto;
      bottom: 6px;
      right: 6px;
      min-width: 26px;
      width: 26px;
      height: 26px;
      background: rgb(16 24 20 / 0.56);
      color: #fff;
      border-color: rgb(255 255 255 / 0.18);
    }
  }
</style>
