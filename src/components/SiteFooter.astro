---
import Icon from "./Icon.astro";
import BrandLogo from "./BrandLogo.astro";
import { company } from "../data/company";
import { site, PLACEHOLDER } from "../lib/site";
import { LEGAL_LINKS } from "../lib/routes";
---

<footer class="editorial-footer">
  <div class="ed-wrap">
    <div class="footer-top">
      <div class="footer-identity">
        <a href="/zh/" class="footer-brand" aria-label="半打空间首页">
          <BrandLogo light />
        </a>
        <p class="footer-tagline">以制造的秩序，回应生活的自由。</p>
        <p class="footer-legal">
          {company.legalName}
          <span lang="en">{company.legalNameEn}</span>
        </p>
      </div>
      <div class="footer-links">
        <div>
          <span class="eyebrow">探索半打</span>
          <a href="/zh/products/">产品中心</a>
          <a href="/zh/cases/">工程案例</a>
          <a href="/zh/about/">关于半打</a>
        </div>
        <div>
          <span class="eyebrow">保持联系</span>
          <a href="/zh/contact/">项目咨询</a>
          <a href="/zh/about/careers/">加入我们</a>
          <a href="/zh/news/">新闻资讯</a>
        </div>
        <div class="footer-more">
          <span class="eyebrow">更多信息</span>
          <a href="/zh/qualifications/">资质能力</a>
          <a href="/zh/about/investors/">投资者关系</a>
          {LEGAL_LINKS.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {site.year} 半打空间</span>
      <span>ARCHITECTURE. MANUFACTURED.</span>
      <span>{site.icp !== PLACEHOLDER ? site.icp : "备案信息待完善"}</span>
      <a href="#main" class="back-top" aria-label="返回页面顶部">
        回到顶部 <Icon name="chevron-up" />
      </a>
    </div>
  </div>
</footer>
