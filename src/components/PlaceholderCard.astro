---
/**
 * v2.0 PLACEHOLDER-CARD 色卡系统（SPEC-v2.0 §3）。
 * 色卡即最终图片位：容器比例与最终图片 1:1，后续只换 img/background-image，不改布局。
 * 构成：浅色底 + 模块线稿 + 编号/名称 + 「图片待替换」角标。
 */

interface Hue {
  /** 色卡 ID（PH-BD8 …） */
  key: string;
  /** 编号标签（如 02 / BD8） */
  no: string;
  /** 产品名 */
  name: string;
  main: string;
  bg: string;
}

/** §3 产品色相表（8 产品 + 2 场景变体） */
const HUES: Record<string, Hue> = {
  'PH-BD8': { key: 'PH-BD8', no: '02 / BD8', name: 'BD8 装配式空间', main: '#5B7285', bg: '#E8ECEF' },
  'PH-BD9': { key: 'PH-BD9', no: '03 / BD9', name: 'BD9 装配式空间', main: '#A08C6B', bg: '#F0EBE2' },
  'PH-5S': { key: 'PH-5S', no: '04 / 5S', name: '半打5S', main: '#6B7B6E', bg: '#E9EDE8' },
  'PH-6S': { key: 'PH-6S', no: '05 / 6S', name: '半打6S', main: '#4A4F52', bg: '#E8E9E9' },
  'PH-GS': { key: 'PH-GS', no: '06 / GS', name: '灰度空间', main: '#7A7D7E', bg: '#ECEDEC' },
  'PH-SLAB': { key: 'PH-SLAB', no: '07 / SLAB', name: '预应力叠合板', main: '#9A6A4F', bg: '#F0E9E3' },
  'PH-WALL': { key: 'PH-WALL', no: '08 / WALL', name: '预制夹心墙板', main: '#8B8578', bg: '#F0EEE8' },
  'PH-STAIR': { key: 'PH-STAIR', no: '09 / STAIR', name: '预制楼梯', main: '#8F5A50', bg: '#EFE7E4' },
  'PH-MAP': { key: 'PH-MAP', no: 'MAP', name: '地图待接入', main: '#1E6E5C', bg: '#E2EDE9' },
  'PH-NEWS': { key: 'PH-NEWS', no: 'NEWS', name: '资讯配图待替换', main: '#1E6E5C', bg: '#E2EDE9' },
};

interface Props {
  /** 色卡 ID */
  id: keyof typeof HUES;
  /** 比例：产品卡 4:3（默认）/ 详情横幅 21:9 / 地图 16:5 / 新闻 3:2；'fill' 由外部容器绝对铺满（产品列表图侧） */
  ratio?: '4:3' | '21:9' | '16:5' | '3:2' | 'fill';
  /** 覆盖名称（如地图位用自定义文案） */
  label?: string;
  class?: string;
}
const { id, ratio = '4:3', label, class: cls = '' } = Astro.props;
const h = HUES[id];
const ratioCss = ratio === 'fill' ? null : { '4:3': '4/3', '21:9': '21/9', '16:5': '16/5', '3:2': '3/2' }[ratio];
---

<div
  class:list={['ph-card', cls]}
  style={`background:${h.bg};color:${h.main}${ratioCss ? `;aspect-ratio:${ratioCss}` : ''}`}
  data-ph-card={h.key}
  data-ph-ratio={ratio}
  role="img"
  aria-label={`${label ?? h.name}（图片待替换占位色卡）`}
>
  <div class="ph-card-grid" aria-hidden="true"></div>
  {id === 'PH-MAP' ? (
    <svg class="ph-card-wire" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <path d="M60 14 C44 14 34 26 34 40 C34 60 60 78 60 78 C60 78 86 60 86 40 C86 26 76 14 60 14 Z" />
      <circle cx="60" cy="40" r="9" />
    </svg>
  ) : id === 'PH-NEWS' ? (
    <svg class="ph-card-wire" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <rect x="14" y="18" width="92" height="54" />
      <path d="M14 60 L48 38 L72 52 L106 30" />
      <circle cx="40" cy="32" r="6" />
    </svg>
  ) : (
    <svg class="ph-card-wire" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <rect x="8" y="18" width="104" height="56" />
      <path d="M8 18 L60 4 L112 18 M60 4 V74" opacity=".7" />
      <rect x="40" y="40" width="16" height="34" />
      <rect x="76" y="30" width="22" height="16" />
    </svg>
  )}
  <div class="ph-card-no">{h.no}</div>
  <div class="ph-card-nm">{label ?? h.name}</div>
  <div class="ph-card-tag">图片待替换</div>
</div>
