---
import "../styles/building-systems.css";
const systems = [
  {
    id: "panels",
    number: "01",
    short: "2D / 板式",
    name: "从构件，到空间。",
    description: "楼板与墙板在工厂预制，运抵现场后，逐一连接为完整空间。",
    note: "楼板 · 墙板 · 现场连接",
  },
  {
    id: "modules",
    number: "02",
    short: "3D / 模块",
    name: "让空间，整体抵达。",
    description: "空间以整体模块的形式在工厂制造，再通过运输与吊装落位。",
    note: "整体模块 · 吊装 · 连接",
  },
  {
    id: "hybrid",
    number: "03",
    short: "组合建造",
    name: "不同单元，一起成形。",
    description: "板式构件与空间模块相互配合，回应不同的场地与使用需求。",
    note: "板式构件 + 空间模块",
  },
];
type Point = [number, number, number];
const point = ([x, y, z]: Point) =>
  `${160 + x * 0.92 + y * 0.9},${310 + x * 0.43 - y * 0.46 - z}`;
const face = (points: Point[]) => points.map(point).join(" ");
const box = (
  x: number,
  y: number,
  z: number,
  w: number,
  d: number,
  h: number,
) => ({
  front: face([
    [x, y, z],
    [x + w, y, z],
    [x + w, y, z + h],
    [x, y, z + h],
  ]),
  side: face([
    [x + w, y, z],
    [x + w, y + d, z],
    [x + w, y + d, z + h],
    [x + w, y, z + h],
  ]),
  top: face([
    [x, y, z + h],
    [x + w, y, z + h],
    [x + w, y + d, z + h],
    [x, y + d, z + h],
  ]),
});
const foundation = box(-12, -12, -13, 294, 224, 13);
const parts: Record<
  string,
  Array<{ geometry: ReturnType<typeof box>; class: string }>
> = {
  panels: [
    { geometry: box(0, 0, 0, 270, 200, 8), class: "slab" },
    { geometry: box(-30, 0, 28, 8, 200, 130), class: "wall wall-one" },
    { geometry: box(0, 220, 28, 270, 8, 130), class: "wall wall-two" },
    { geometry: box(0, 0, 194, 270, 200, 8), class: "roof" },
  ],
  modules: [
    { geometry: box(0, 0, 0, 125, 200, 130), class: "module" },
    { geometry: box(147, 0, 50, 125, 200, 130), class: "module lifted-module" },
  ],
  hybrid: [
    { geometry: box(0, 0, 0, 125, 200, 130), class: "module" },
    { geometry: box(144, 0, 0, 126, 200, 8), class: "slab" },
    { geometry: box(270, 0, 0, 8, 200, 130), class: "wall" },
    { geometry: box(144, 0, 170, 126, 200, 8), class: "roof" },
  ],
};
---

<fieldset class="systems-explorer" id="building-systems" data-systems-explorer>
  <legend class="sr-only">选择建造体系，查看构造示意</legend>
  <div class="system-choices">
    {systems.map((system, i) => (
      <div class="system-choice">
        <input
          class="sr-only"
          type="radio"
          name="building-system"
          id={`system-${system.id}`}
          value={system.id}
          checked={i === 0}
        />
        <label for={`system-${system.id}`}>
          <span class="system-choice-number">{system.number}</span>
          <span class="system-choice-copy">
            <strong>{system.short}</strong>
            <small>{system.description}</small>
          </span>
          <span class="selection-mark" aria-hidden="true"></span>
        </label>
      </div>
    ))}
  </div>
  <div class="system-study">
    {systems.map((system) => (
      <figure class="system-figure" data-system-figure={system.id}>
        <svg
          class="assembly-drawing"
          viewBox="0 0 780 530"
          role="img"
          aria-label={`${system.short}：${system.note}，建造逻辑示意`}
        >
          <g class="assembly-base">
            <polygon class="face-front" points={foundation.front} />
            <polygon class="face-side" points={foundation.side} />
            <polygon class="face-top" points={foundation.top} />
          </g>
          <g
            class="assembly-guides"
            fill="none"
            stroke="currentColor"
            stroke-dasharray="4 6"
            stroke-width="1"
          >
            {[
              [0, 0],
              [270, 0],
              [270, 200],
              [0, 200],
            ].map(([x, y]) => (
              <polyline
                points={face([
                  [x, y, 0],
                  [x, y, 215],
                ])}
              />
            ))}
          </g>
          {parts[system.id].map((part, i) => (
            <g
              class={`assembly-part ${part.class}`}
              style={`--part-order:${i}`}
            >
              <polygon class="face-front" points={part.geometry.front} />
              <polygon class="face-side" points={part.geometry.side} />
              <polygon class="face-top" points={part.geometry.top} />
            </g>
          ))}
        </svg>
        <figcaption>
          <span>{system.name}</span>
          <small>{system.note}</small>
        </figcaption>
        <p class="system-mobile-description">{system.description}</p>
      </figure>
    ))}
    <p class="system-study-note">
      建造逻辑示意，具体结构与连接方式以项目设计为准。
    </p>
  </div>
</fieldset>
