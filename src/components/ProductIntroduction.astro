---
import EditorialImage from "./EditorialImage.astro";
import { catalogEveningCopy, introductionCopy } from "../data/about-revision";
const en = Astro.url.pathname.startsWith("/en/");
const copy = introductionCopy[en ? "en" : "zh"];
const evening = catalogEveningCopy[en ? "en" : "zh"];
---

<section
  class="product-introduction"
  id="product-introduction"
  aria-label={en ? "Our approach to housing" : "我们对住宅的理解"}
>
  <div class="intro-understanding">
    <EditorialImage
      base="r82-about-understanding"
      fit="contain"
      alt={
        en
          ? "Architectural drawing of the BD-4S entrance"
          : "半打4S入口建筑线稿"
      }
      sizes="(max-width:767px) 100vw, 42vw"
    />
    <div class="intro-copy">
      <div class="intro-summary">
        <h2>{copy.understanding}</h2>
        <p class="intro-lead">{copy.lead}</p>
        <p>{copy.rest}</p>
      </div>
      <div class="intro-viewpoint">
        <div class="intro-principles">
          {copy.statements.map((t) => (
            <p>{t}</p>
          ))}
        </div>
        <p>{copy.end}</p>
      </div>
    </div>
  </div>
  <div class="intro-definition">
    <header class="intro-definition-head">
      <h2>{copy.definition}</h2>
      <p class="intro-method">{copy.method}</p>
    </header>
    <div class="intro-definition-body">
      <EditorialImage
        base="r82-about-definition"
        fit="contain"
        alt={
          en
            ? "BD-4S and grayscale space, architectural renderings"
            : "半打4S与灰度空间建筑效果图"
        }
        sizes="(max-width:767px) 100vw, 60vw"
      />
      <div class="intro-copy">
        <div class="intro-design">
          {copy.ideas.map((t) => (
            <p>{t}</p>
          ))}
          <p class="intro-signature" lang="en">
            {copy.signature}
          </p>
        </div>
        <div class="intro-evening" id="evening-light">
          <p>{evening.opening}</p>
          <p>{evening.detail}</p>
          <p class="intro-attribution">{evening.attribution}</p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .product-introduction {
    padding: clamp(40px, 4.2vw, 72px) var(--content-inset);
    background: var(--paper);
    color: var(--charcoal);
  }
  .intro-understanding,
  .intro-definition {
    min-width: 0;
  }
  .intro-understanding {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.7fr);
    gap: clamp(32px, 3.4vw, 56px);
    align-items: center;
  }
  .intro-copy {
    min-width: 0;
  }
  .product-introduction h2 {
    margin: 0 0 24px;
    font-size: clamp(36px, 3.6vw, 52px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }
  .product-introduction p {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-body);
  }
  .product-introduction .intro-lead {
    margin-bottom: 8px;
    font-size: clamp(20px, 1.6vw, 24px);
    line-height: 1.5;
    color: var(--charcoal);
  }
  .intro-principles {
    margin: 28px 0;
  }
  .intro-principles p {
    margin: 8px 0;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.5;
    color: var(--charcoal);
    text-wrap: pretty;
  }
  .intro-understanding :global(picture.editorial-image) {
    width: 100%;
    aspect-ratio: auto !important;
    background: transparent;
    justify-self: start;
  }
  .intro-understanding :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain !important;
  }
  .intro-definition {
    margin-top: clamp(48px, 4.5vw, 72px);
  }
  .intro-definition-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .intro-definition-head h2,
  .intro-definition-head p {
    margin: 0;
  }
  .intro-definition-body {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .intro-definition :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .product-introduction .intro-signature {
    margin: 24px 0 0;
    max-width: 11ch;
    font-size: clamp(32px, 3.2vw, 52px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .intro-evening {
    margin-top: 24px;
  }
  .intro-evening p {
    margin-bottom: 8px;
  }
  .intro-evening .intro-attribution {
    margin: 12px 0 0;
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .intro-definition-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .intro-definition-body > .intro-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
    }
    .intro-evening {
      margin-top: 0;
    }
  }
  @media (min-width: 1280px) {
    .intro-understanding {
      grid-template-columns: minmax(0, min(24vw, 360px)) minmax(0, 1fr);
    }
    .intro-understanding > .intro-copy {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(24px, 2.5vw, 48px);
      align-items: start;
    }
    .intro-understanding .intro-principles {
      margin: 0 0 28px;
    }
    .intro-understanding .intro-principles p:first-child {
      margin-top: 0;
    }
    .intro-understanding .intro-principles p {
      font-size: clamp(24px, 1.7vw, 32px);
    }
    .intro-understanding .intro-principles p + p {
      margin-top: 20px;
    }
    .intro-definition {
      margin-top: 48px;
    }
  }
  @media (max-width: 767px) {
    .product-introduction {
      padding: 40px 24px;
    }
    .intro-understanding,
    .intro-definition-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .intro-understanding :global(picture.editorial-image),
    .intro-understanding :global(img) {
      width: auto;
      max-width: 100%;
      max-height: 280px;
    }
    .intro-understanding :global(picture.editorial-image) {
      justify-self: center;
    }
    .intro-definition {
      margin-top: 40px;
    }
    .intro-definition-head {
      display: block;
      margin-bottom: 24px;
    }
    .intro-definition-head p {
      margin-top: 12px;
    }
    .intro-principles {
      margin: 24px 0;
    }
    .intro-copy p:last-child {
      margin-bottom: 0;
    }
  }
</style>
