---
import EditorialImage from "./EditorialImage.astro";
import { catalogEveningCopy, introductionCopy } from "../data/about-revision";
const en = Astro.url.pathname.startsWith("/en/");
const copy = introductionCopy[en ? "en" : "zh"];
const evening = catalogEveningCopy[en ? "en" : "zh"];
---

<section
  class="product-introduction"
  id="product-introduction"
  aria-label={en ? "Our approach to housing" : "我们对住宅的理解"}
>
  <div class="intro-understanding">
    <EditorialImage
      base="r82-about-understanding"
      fit="contain"
      alt={
        en
          ? "Architectural drawing of the BD-4S entrance"
          : "半打4S入口建筑线稿"
      }
      sizes="(max-width:767px) 35vw, 16vw"
    />
    <div class="intro-copy">
      <div class="intro-summary">
        <h2>{copy.understanding}</h2>
        <p class="intro-lead">{copy.lead}</p>
        <p>{copy.rest}</p>
      </div>
      <div class="intro-viewpoint">
        <div class="intro-principles">
          {copy.statements.map((t) => (
            <p>{t}</p>
          ))}
        </div>
        <p>{copy.end}</p>
      </div>
      <div class="intro-evening" id="evening-light">
        <p>{evening.opening}</p>
        <p>{evening.detail}</p>
        <p class="intro-attribution">{evening.attribution}</p>
      </div>
    </div>
  </div>
  <div class="intro-definition">
    <header class="intro-definition-head">
      <h2>{copy.definition}</h2>
      <p class="intro-method">{copy.method}</p>
    </header>
    <div class="intro-definition-body">
      <EditorialImage
        base="r82-about-definition"
        fit="contain"
        alt={
          en
            ? "BD-4S and grayscale space, architectural renderings"
            : "半打4S与灰度空间建筑效果图"
        }
        sizes="(max-width:1279px) 100vw, 52vw"
      />
      <div class="intro-copy">
        <div class="intro-design">
          {copy.ideas.map((t) => (
            <p>{t}</p>
          ))}
          <p class="intro-signature" lang="en">
            {copy.signature}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .product-introduction {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 4vw, 80px);
    align-items: start;
    padding: clamp(40px, 3.4vw, 64px) var(--content-inset);
    background: var(--paper);
    color: var(--charcoal);
  }
  .intro-understanding,
  .intro-definition,
  .intro-copy {
    min-width: 0;
  }
  .intro-understanding {
    display: grid;
    grid-template-columns: minmax(100px, 0.48fr) minmax(0, 1fr);
    gap: clamp(24px, 2vw, 40px);
    align-items: start;
  }
  .product-introduction h2 {
    margin: 0 0 20px;
    font-size: clamp(32px, 2.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }
  .product-introduction p {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-body);
  }
  .product-introduction .intro-lead {
    font-size: clamp(20px, 1.5vw, 24px);
    line-height: 1.5;
    color: var(--charcoal);
    text-wrap: pretty;
  }
  .intro-viewpoint {
    margin-top: 28px;
  }
  .intro-principles {
    margin-bottom: 20px;
  }
  .intro-principles p {
    margin: 0 0 12px;
    font-size: clamp(18px, 1.2vw, 22px);
    line-height: 1.6;
    color: var(--charcoal);
    text-wrap: pretty;
  }
  .intro-understanding :global(picture.editorial-image) {
    width: 100%;
    background: transparent;
  }
  .product-introduction :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .intro-definition-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 24px;
    margin-bottom: 24px;
  }
  .intro-definition-head h2,
  .intro-definition-head p {
    margin: 0;
  }
  .intro-definition-body > .intro-copy {
    margin-top: 24px;
  }
  .product-introduction .intro-signature {
    margin: 20px 0 0;
    max-width: none;
    font-size: clamp(28px, 2.1vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--charcoal);
    text-wrap: balance;
  }
  .intro-evening {
    margin-top: 24px;
  }
  .intro-evening .intro-attribution {
    margin: 12px 0 0;
  }
  .intro-copy p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .product-introduction {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .intro-understanding {
      grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    }
    .intro-understanding > .intro-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 28px;
    }
    .intro-viewpoint {
      margin-top: 0;
    }
    .intro-evening {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
  @media (max-width: 767px) {
    .product-introduction {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 24px;
      gap: 36px;
    }
    .intro-understanding {
      grid-template-columns: minmax(80px, 0.4fr) minmax(0, 1fr);
      grid-template-areas: "heading heading" "photo lead" "photo rest" "view view" "evening evening";
      gap: 20px;
    }
    .intro-understanding > .intro-copy {
      display: contents;
    }
    .intro-summary {
      display: contents;
    }
    .intro-summary h2 {
      grid-area: heading;
      margin-bottom: 0;
    }
    .intro-understanding :global(picture.editorial-image) {
      grid-area: photo;
    }
    .intro-summary .intro-lead {
      grid-area: lead;
      margin-bottom: 0;
    }
    .intro-summary > p:not(.intro-lead) {
      grid-area: rest;
    }
    .intro-evening {
      grid-area: evening;
      margin-top: 0;
    }
    .intro-viewpoint {
      grid-area: view;
      margin-top: 0;
    }
    .product-introduction h2 {
      font-size: 30px;
      margin-bottom: 16px;
    }
    .intro-definition-head {
      display: block;
      margin-bottom: 20px;
    }
    .intro-definition-head h2 {
      margin-bottom: 8px;
    }
    .intro-definition-body > .intro-copy {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 20px;
    }
    .product-introduction .intro-signature {
      max-width: none;
      font-size: 28px;
    }
  }
</style>
