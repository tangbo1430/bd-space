---
import EditorialImage from "./EditorialImage.astro";
import { catalogEveningCopy, introductionCopy } from "../data/about-revision";
const en = Astro.url.pathname.startsWith("/en/");
const copy = introductionCopy[en ? "en" : "zh"];
const evening = catalogEveningCopy[en ? "en" : "zh"];
---

<section
  class="product-introduction"
  id="product-introduction"
  aria-label={en ? "Our approach to housing" : "我们对住宅的理解"}
>
  <div class="intro-understanding">
    <div class="intro-summary">
      <h2>{copy.understanding}</h2>
      <p class="intro-lead">{copy.lead}</p>
      <p>{copy.rest}</p>
    </div>
    <figure class="intro-drawing">
      <EditorialImage
        base="r82-about-understanding"
        fit="contain"
        alt={
          en
            ? "Architectural drawing of the BD-4S entrance"
            : "半打4S入口建筑线稿"
        }
        sizes="(max-width: 599px) 28vw, (max-width: 999px) 210px, 260px"
      />
    </figure>
    <p class="intro-viewpoint">
      {[...copy.statements, copy.end].join(en ? " " : "")}
    </p>
  </div>
  <div class="intro-definition">
    <div class="intro-definition-copy">
      <h2>{copy.definition}</h2>
      <p class="intro-method">{copy.method}</p>
      {copy.ideas.map((idea) => (
        <p>{idea}</p>
      ))}
      <p class="intro-signature" lang="en">
        {copy.signature}
      </p>
    </div>
    <figure class="intro-homes">
      <EditorialImage
        base="r82-about-definition"
        fit="contain"
        alt={
          en
            ? "BD-4S and grayscale space, architectural renderings"
            : "半打4S与灰度空间建筑效果图"
        }
        sizes="(max-width: 999px) 92vw, 48vw"
      />
      <figcaption class="intro-evening" id="evening-light">
        <p>{evening.opening}</p>
        <p>{evening.detail}</p>
        <p class="intro-attribution">{evening.attribution}</p>
      </figcaption>
    </figure>
  </div>
</section>
<style>
  .product-introduction {
    width: min(100% - 2 * var(--ed-gutter), 1320px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(30px, 4vw, 62px);
    padding-block: clamp(34px, 4.5vw, 64px);
    scroll-margin-top: var(--gnb-h);
  }

  .intro-understanding {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(110px, 43%);
    grid-template-areas: "summary drawing" "viewpoint drawing";
    gap: 14px clamp(14px, 2vw, 28px);
    align-items: start;
    align-self: start;
  }

  .intro-summary {
    grid-area: summary;
  }

  .intro-summary,
  .intro-definition-copy {
    min-width: 0;
  }

  .product-introduction h2 {
    margin: 0 0 10px;
    font-size: clamp(26px, 2.45vw, 39px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--charcoal);
  }

  .product-introduction p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-body);
  }

  .product-introduction .intro-lead,
  .product-introduction .intro-method {
    margin-bottom: 10px;
    color: var(--charcoal);
    line-height: 1.35;
    font-size: clamp(19px, 1.65vw, 25px);
    text-wrap: pretty;
  }

  .product-introduction .intro-viewpoint {
    grid-area: viewpoint;
    max-width: 54ch;
  }

  .intro-drawing,
  .intro-homes {
    margin: 0;
  }

  .intro-drawing {
    grid-area: drawing;
    align-self: center;
  }

  .intro-drawing :global(.editorial-image) {
    background: var(--paper);
  }

  .intro-homes {
    margin-top: 18px;
  }

  .intro-evening {
    scroll-margin-top: calc(var(--gnb-h) + 12px);
    margin-top: 10px;
  }

  .intro-evening p {
    font-size: 14px;
  }

  .intro-evening .intro-attribution {
    margin-top: 4px;
  }

  .intro-definition-copy .intro-signature {
    margin-top: 8px;
    color: var(--charcoal);
    font-size: clamp(18px, 1.5vw, 23px);
  }

  @media (max-width: 999px) {
    .product-introduction {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro-understanding {
      grid-template-columns: minmax(0, 1fr) minmax(110px, 30%);
    }

    .intro-drawing {
      width: min(100%, 210px);
      justify-self: end;
    }
  }

  @media (max-width: 599px) {
    .intro-understanding {
      grid-template-columns: minmax(0, 1fr) minmax(72px, 28%);
      grid-template-areas: "summary drawing" "viewpoint viewpoint";
      align-items: start;
      gap: 12px;
    }
  }
</style>
