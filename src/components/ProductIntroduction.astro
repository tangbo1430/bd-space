---
import EditorialImage from "./EditorialImage.astro";
import { catalogEveningCopy, introductionCopy } from "../data/about-revision";
const en = Astro.url.pathname.startsWith("/en/");
const copy = introductionCopy[en ? "en" : "zh"];
const evening = catalogEveningCopy[en ? "en" : "zh"];
---

<section
  class="product-introduction"
  id="product-introduction"
  aria-label={en ? "Our approach to housing" : "我们对住宅的理解"}
>
  <div class="intro-understanding">
    <div class="intro-summary">
      <h2>{copy.understanding}</h2>
      <p class="intro-lead">{copy.lead}</p>
      <p>{copy.rest}</p>
      <div class="intro-viewpoint">
        {copy.statements.map((statement) => (
          <p>{statement}</p>
        ))}
        <p>{copy.end}</p>
      </div>
    </div>
    <figure class="intro-drawing">
      <EditorialImage
        base="r82-about-understanding"
        fit="contain"
        alt={
          en
            ? "Architectural drawing of the BD-4S entrance"
            : "半打4S入口建筑线稿"
        }
        sizes="(max-width: 900px) 220px, 300px"
      />
    </figure>
  </div>
  <div class="intro-definition">
    <div class="intro-definition-copy">
      <h2>{copy.definition}</h2>
      <p class="intro-method">{copy.method}</p>
      {copy.ideas.map((idea) => (
        <p>{idea}</p>
      ))}
      <p class="intro-signature" lang="en">
        {copy.signature}
      </p>
    </div>
    <figure class="intro-homes">
      <EditorialImage
        base="r82-about-definition"
        fit="contain"
        alt={
          en
            ? "BD-4S and grayscale space, architectural renderings"
            : "半打4S与灰度空间建筑效果图"
        }
        sizes="(max-width: 767px) 100vw, 58vw"
      />
      <figcaption class="intro-evening" id="evening-light">
        <p>{evening.opening}</p>
        <p>{evening.detail}</p>
        <p class="intro-attribution">{evening.attribution}</p>
      </figcaption>
    </figure>
  </div>
</section>
<style>
  .intro-understanding,
  .intro-definition {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    padding: clamp(40px, 4.5vw, 80px) var(--content-inset);
  }

  .product-introduction h2 {
    margin: 0 0 12px;
    font-size: clamp(32px, 3vw, 46px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--charcoal);
  }

  .product-introduction p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
  }

  .product-introduction .intro-lead,
  .product-introduction .intro-method {
    margin-bottom: 14px;
    color: var(--charcoal);
    line-height: 1.2;
    font-size: clamp(22px, 2.1vw, 32px);
    font-weight: 400;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .intro-viewpoint {
    display: grid;
    gap: 6px;
    margin-top: 24px;
  }

  .intro-drawing,
  .intro-homes {
    margin: 0;
  }

  .intro-drawing :global(.editorial-image) {
    width: min(100%, 300px);
    margin-inline: auto;
    background: var(--paper);
  }

  .intro-evening {
    scroll-margin-top: calc(var(--gnb-h) + 12px);
    margin-top: 14px;
  }

  .intro-evening .intro-attribution {
    margin-top: 8px;
    font-size: 14px;
  }

  .intro-definition {
    background: var(--paper-deep);
  }

  .intro-definition-copy {
    min-width: 0;
  }

  .intro-definition-copy .intro-signature {
    margin-top: 12px;
    color: var(--charcoal);
    font-size: clamp(21px, 1.65vw, 28px);
    line-height: 1.35;
  }

  .intro-definition :global(img) {
    display: block;
  }

  @media (max-width: 900px) {
    .intro-understanding,
    .intro-definition {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .intro-drawing :global(.editorial-image) {
      width: min(100%, 220px);
      margin-inline: 0;
    }
  }
</style>
