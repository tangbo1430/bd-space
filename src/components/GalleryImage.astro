---
import { imageDimensions } from "../lib/image-dimensions";
import Icon from "./Icon.astro";
import EditorialImage from "./EditorialImage.astro";
interface Props {
  base?: string;
  src?: string;
  viewerSrc?: string;
  previewSrc?: string;
  previewFrame?: {
    width: number;
    height: number;
    imageWidth: number;
    left: number;
    top: number;
  };
  width?: number;
  height?: number;
  mobileWidth?: number;
  fit?: "cover" | "contain";
  zoomX?: number;
  mobileImage?: string;
  alt: string;
  group: string;
  caption?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  base,
  mobileImage,
  src,
  viewerSrc,
  previewSrc,
  previewFrame,
  width: suppliedWidth,
  height: suppliedHeight,
  mobileWidth,
  fit,
  zoomX,
  alt,
  group,
  caption = alt,
  eager = false,
  sizes,
} = Astro.props;
const intrinsic = imageDimensions(src ?? `/assets/img/${base}.jpg`);
const width = suppliedWidth ?? intrinsic[0];
const height = suppliedHeight ?? intrinsic[1];
const previewSize = previewSrc ? imageDimensions(previewSrc) : [width, height];
---

<a
  class:list={["gallery-link", { "gallery-complete": fit === "contain" }]}
  style={`--image-ratio:${width / height}`}
  href={src ?? `/assets/img/${base}.jpg`}
  data-gallery={group}
  data-gallery-source={viewerSrc ?? src ?? `/assets/img/${base}.webp`}
  data-gallery-thumb={`/assets/thumbs/${
    base ??
    src
      ?.split("/")
      .pop()
      ?.replace(/\.[^.]+$/, "")
  }.webp`}
  data-gallery-zoom-x={zoomX}
  data-gallery-width={width}
  data-gallery-height={height}
  data-gallery-caption={caption}
  aria-label={`查看大图：${caption}`}
>
  {previewFrame ? (
    <div
      class="gallery-preview-frame"
      style={`aspect-ratio:${previewFrame.width}/${previewFrame.height};--frame-image-width:${(previewFrame.imageWidth / previewFrame.width) * 100}%;--frame-left:${(previewFrame.left / previewFrame.width) * 100}%;--frame-top:${(previewFrame.top / previewFrame.height) * 100}%`}
    >
      <EditorialImage
        src={src}
        previewSrc={previewSrc ?? viewerSrc}
        width={previewSize[0]}
        height={previewSize[1]}
        fit="contain"
        alt={alt}
        eager={eager}
        sizes={sizes}
      />
    </div>
  ) : (
    <EditorialImage
      base={base}
      mobileImage={mobileImage}
      src={src}
      previewSrc={previewSrc ?? viewerSrc}
      width={previewSize[0]}
      height={previewSize[1]}
      mobileWidth={mobileWidth}
      fit={fit}
      alt={alt}
      eager={eager}
      sizes={sizes}
    />
  )}
  <span class="gallery-open" aria-hidden="true">
    <span>查看大图</span>
    <Icon name="expand" />
  </span>
</a>

<style>
  /* Only explicitly configured elevations use a paper frame; originals stay intact. */
  .gallery-preview-frame {
    position: relative;
    width: 100%;
    background: #fff;
  }
  .gallery-preview-frame :global(.editorial-image) {
    position: absolute;
    width: var(--frame-image-width);
    left: var(--frame-left);
    top: var(--frame-top);
  }
</style>
