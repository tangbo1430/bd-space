---
/**
 * M3 首页「从工厂到现场」六步交付流程（v1.6，DSN-162；v1.8 实拍替换 step01/03/05/06）。
 * APG Tabs：tablist/tab/tabpanel、aria-selected、roving tabindex、左右键切换（main.ts）。
 * 不自动轮播；六步均为已批准实拍图（v1.6/v1.7/v1.8 批次），加载失败回退占位。
 */
import { FLOW_ASSETS, FLOW_FACTORY_ASSETS, FLOW_V18_ASSETS, FLOW_V19_ASSETS, FACTORY_V19_ASSETS, INSTALL_V19_ASSETS, type Img16 } from '../lib/assets';

interface Step {
  no: string;
  name: string;
  desc: string;
  img: Img16;
  /** 补充实拍（同环节多图，主图 + 辅图；择优不堆叠，每步至多 2 辅图） */
  extra?: Img16;
  extra2?: Img16;
  extra3?: Img16;
  /** 横幅特写比例（step06 6:1 原图以 3:1 cover 展示） */
  ratio?: string;
}

const STEPS: Step[] = [
  { no: '01', name: '设计与制模', desc: '按项目条件完成空间与构件的协同设计，并制备生产模具。【待确认】', img: FLOW_V18_ASSETS.step01Mold },
  { no: '02', name: '构件生产', desc: '工厂标准化产线完成构件制造与养护。【待确认】', img: FLOW_FACTORY_ASSETS.module, extra: FACTORY_V19_ASSETS.precastUnits },
  { no: '03', name: '出厂检验', desc: '构件与模块在出厂前完成检验与吊装复核。【待确认】', img: FLOW_V18_ASSETS.step03PanelLift, extra: FLOW_FACTORY_ASSETS.panels },
  { no: '04', name: '机电与内装', desc: '机电管线与内装在工厂阶段同步完成。【待确认】', img: FLOW_ASSETS.mechPiping, extra: FLOW_ASSETS.mechPipingAlt },
  { no: '05', name: '运输组织', desc: '按交付计划组织构件与模块的装车与运输。【待确认】', img: FLOW_V18_ASSETS.step05FramesLoad, extra: FLOW_V19_ASSETS.stacker01, extra2: FLOW_V19_ASSETS.panel03, extra3: FLOW_ASSETS.transportFrames },
  { no: '06', name: '现场交付', desc: '现场吊装、安装并完成质量复核。【待确认】', img: FLOW_V18_ASSETS.step06CranePanel, extra: INSTALL_V19_ASSETS.roofTrim, extra2: FLOW_V19_ASSETS.spreaderLift },
];
---

<section class="sec flow-sec" aria-label="从工厂到现场：交付流程" data-flow>
  <div class="wrap">
    <div class="sec-head rv">
      <div>
        <div class="en">Delivery</div>
        <h2>从工厂到现场</h2>
        <p class="flow-sub">设计制模、构件生产、出厂检验、机电内装、运输组织、现场交付</p>
      </div>
    </div>

    <div class="flow-tabs" role="tablist" aria-label="交付流程步骤" data-flow-tablist>
      {STEPS.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`flow-tab-${s.no}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`flow-panel-${s.no}`}
          tabindex={i === 0 ? 0 : -1}
          class:list={['flow-tab', { on: i === 0 }]}
          data-flow-tab
        >
          <span class="flow-no" aria-hidden="true">{s.no}</span>
          <span class="flow-name">{s.name}</span>
        </button>
      ))}
    </div>

    {STEPS.map((s, i) => (
      <div
        role="tabpanel"
        id={`flow-panel-${s.no}`}
        aria-labelledby={`flow-tab-${s.no}`}
        class="flow-panel"
        hidden={i !== 0}
        data-flow-panel
      >
        <div class="flow-img" style={s.ratio ? `aspect-ratio:${s.ratio}` : undefined}>
          <picture>
            {s.img.mw && (
              <source type="image/webp" srcset={`/assets/img/${s.img.base}${s.img.msuf ?? '-m'}.webp ${s.img.mw}w, /assets/img/${s.img.base}.webp ${s.img.w}w`} sizes="(max-width: 767px) 100vw, 55vw" />
            )}
            {!s.img.mw && <source type="image/webp" srcset={`/assets/img/${s.img.base}.webp`} />}
            <img
              src={`/assets/img/${s.img.base}.jpg`}
              width={s.img.w} height={s.img.h} alt={s.img.alt}
              loading="lazy" decoding="async"
              onerror="this.closest('.flow-img').classList.add('ph-fallback');this.closest('picture').remove()"
            />
          </picture>
          <i class="flow-tag" aria-hidden="true"></i>
        </div>
        <div class="flow-txt">
          <div class="en" aria-hidden="true">Step {s.no}</div>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
          {(s.extra || s.extra2) && (
            <div class="flow-extras">
              {[s.extra, s.extra2, s.extra3].filter(Boolean).map((ex) => (
                <figure class="flow-extra">
                  <picture>
                    {ex!.mw && (
                      <source type="image/webp" srcset={`/assets/img/${ex!.base}${ex!.msuf ?? '-m'}.webp ${ex!.mw}w, /assets/img/${ex!.base}.webp ${ex!.w}w`} sizes="(max-width: 767px) 44vw, 12vw" />
                    )}
                    {!ex!.mw && <source type="image/webp" srcset={`/assets/img/${ex!.base}.webp`} />}
                    <img
                      src={`/assets/img/${ex!.base}.jpg`}
                      width={ex!.w} height={ex!.h} alt={ex!.alt}
                      loading="lazy" decoding="async"
                      style={ex!.maxW ? `max-width:${ex!.maxW}px` : undefined}
                      onerror="this.closest('.flow-extra').classList.add('ph-fallback');this.closest('picture').remove()"
                    />
                  </picture>
                </figure>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
