---
/** Shared 20px optical grid for functional controls. Decorative and never focusable. */
interface Props {
  name:
    | "chevron-right"
    | "chevron-left"
    | "chevron-up"
    | "chevron-down"
    | "close"
    | "expand"
    | "download"
    | "zoom"
    | "plus"
    | "play"
    | "pause"
    | "check"
    | "mail"
    | "phone";
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  "chevron-right": "m8 5 5 5-5 5",
  "chevron-left": "m12 5-5 5 5 5",
  "chevron-up": "m5 12 5-5 5 5",
  "chevron-down": "m5 8 5 5 5-5",
  close: "m5 5 10 10M5 15 15 5",
  expand: "M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4",
  download: "M10 3v9m-4-4 4 4 4-4M4 13v4h12v-4",
  zoom: "m13 13 4 4M6 9h6",
  plus: "M4 10h12",
  play: "m7 4 9 6-9 6V4Z",
  pause: "M7 4v12m6-12v12",
  check: "m4 10 4 4 8-8",
  mail: "M3 5h14v10H3V5Zm0 0 7 6 7-6",
  phone:
    "m4 3 3 4-2 2c1.3 2.5 3.5 4.7 6 6l2-2 4 3c-1 2-3 2-5 1C8 15 5 12 3 8c-1-2-1-4 1-5Z",
};
---

<svg
  class:list={["ui-icon", className]}
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "zoom" && <circle cx="9" cy="9" r="5.5" />}
  <path d={paths[name]} />
  {name === "plus" && <path class="icon-vertical" d="M10 4v12" />}
  {name === "zoom" && <path class="zoom-plus" d="M9 6v6" />}
</svg>
