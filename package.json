{
  "name": "bd-space",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "半打空间 — 建筑编辑式响应官网",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests --plugin prettier-plugin-astro",
    "type-check": "astro check",
    "test": "vitest run",
    "test:browser": "node tests/editorial-browser.mjs",
    "test:visual": "node scripts/capture-editorial.mjs",
    "test:immersive": "node tests/immersive-browser.mjs",
    "test:carousel": "node tests/carousel-navigation.mjs",
    "test:materials": "node tests/materials-browser.mjs",
    "test:supplement": "node tests/supplement-browser.mjs",
    "verify": "node scripts/verify-build.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "check": "node scripts/check.mjs",
    "test:v11": "node tests/v11-browser.mjs",
    "audit:translations": "node scripts/audit-translations.mjs",
    "package:assets": "node scripts/prune-deployment-assets.mjs"
  },
  "dependencies": {
    "astro": "^5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.12.0",
    "parse5": "^8.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@11.19.0"
}
